<UserControl
    x:Class="Core.Views.Controls.Admin.DepartmentCardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:Core.Converters"
    xmlns:local="using:Core.Views.Controls.Admin"
    xmlns:vm="using:Core.ViewModels"
    x:DataType="vm:HierarchicalDepartmentViewModel">

    <UserControl.Styles>
        <Style Selector="StackPanel.DepartmentActions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Border.DepartmentCard:pointerover StackPanel.DepartmentActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="0,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  ── Карточка отдела ──  -->
        <Border
            Margin="{Binding Level, Converter={conv:Converter Name=LevelToMargin}}"
            Classes="DepartmentCard"
            Cursor="Hand">

            <Border.Styles>
                <!--  Hover-эффект действий  -->
                <Style Selector="Border.DepartmentCard:pointerover StackPanel.DepartmentActions">
                    <Setter Property="Opacity" Value="1" />
                </Style>
            </Border.Styles>

            <Grid>
                <!--  Вертикальный соединитель (для дочерних)  -->
                <Canvas
                    Width="24"
                    Height="1"
                    Margin="-24,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    IsVisible="{Binding Level, Converter={conv:Converter Name=LevelToVisibility}}">
                    <Line
                        Stroke="{DynamicResource HierarchyLineBrush}"
                        StrokeLineCap="Round"
                        StrokeThickness="1.5"
                        StartPoint="0,0"
                        EndPoint="20,0" />
                </Canvas>

                <Grid Margin="6,4" ColumnDefinitions="Auto,*,Auto">

                    <!--  Кнопка разворачивания  -->
                    <Button
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        Classes="IconButton"
                        Command="{Binding ToggleExpandCommand}"
                        IsVisible="{Binding HasChildren}"
                        ToolTip.Tip="{Binding IsExpanded, Converter={x:Static BoolConverters.Not}, ConverterParameter=Развернуть}">
                        <PathIcon
                            Width="10"
                            Height="10"
                            Data="{StaticResource ChevronIcon}"
                            Foreground="{DynamicResource TextMuted}"
                            RenderTransformOrigin="50%,50%">
                            <PathIcon.RenderTransform>
                                <RotateTransform Angle="{Binding ExpanderRotation}" />
                            </PathIcon.RenderTransform>
                            <PathIcon.Styles>
                                <Style Selector="PathIcon">
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <TransformOperationsTransition
                                                Easing="CubicEaseOut"
                                                Property="RenderTransform"
                                                Duration="0:0:0.2" />
                                        </Transitions>
                                    </Setter>
                                </Style>
                            </PathIcon.Styles>
                        </PathIcon>
                    </Button>

                    <Border
                        Grid.Column="0"
                        Width="32"
                        Height="32"
                        IsVisible="{Binding !HasChildren}" />

                    <!--  Иконка + Название  -->
                    <Grid
                        Grid.Column="1"
                        Margin="6,8"
                        ColumnDefinitions="Auto,*">

                        <!--  Иконка отдела  -->
                        <Border
                            Grid.Column="0"
                            Width="34"
                            Height="34"
                            Margin="0,0,10,0"
                            Background="{DynamicResource AccentMuted}"
                            CornerRadius="9">
                            <Panel>
                                <PathIcon
                                    Width="15"
                                    Height="15"
                                    Data="{StaticResource OrganizationIcon}"
                                    Foreground="{DynamicResource Accent}"
                                    IsVisible="{Binding IsRoot}" />
                                <PathIcon
                                    Width="15"
                                    Height="15"
                                    Data="{StaticResource FolderIcon}"
                                    Foreground="{DynamicResource TextSecondary}"
                                    IsVisible="{Binding !IsRoot}" />
                            </Panel>
                        </Border>

                        <!--  Текст  -->
                        <StackPanel
                            Grid.Column="1"
                            MinWidth="0"
                            VerticalAlignment="Center"
                            Spacing="2">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip.Tip="{Binding Name}" />

                            <!--  Руководитель  -->
                            <StackPanel
                                IsVisible="{Binding HasHead}"
                                Orientation="Horizontal"
                                Spacing="4">
                                <PathIcon
                                    Width="9"
                                    Height="9"
                                    Data="{StaticResource PersonIcon}"
                                    Foreground="{DynamicResource TextMuted}" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{Binding HeadName}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip.Tip="{Binding HeadName}" />
                            </StackPanel>

                            <TextBlock
                                FontSize="11"
                                FontStyle="Italic"
                                Foreground="{DynamicResource TextMuted}"
                                IsVisible="{Binding !HasHead}"
                                Text="Нет руководителя" />
                        </StackPanel>
                    </Grid>

                    <!--  Правая часть: бейджи + действия  -->
                    <StackPanel
                        Grid.Column="2"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">

                        <!--  Счётчик сотрудников  -->
                        <Border
                            Padding="8,3"
                            Background="{DynamicResource AccentMuted}"
                            CornerRadius="10"
                            IsVisible="{Binding ShowUserCount}"
                            ToolTip.Tip="{Binding UserCountText}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <PathIcon
                                    Width="11"
                                    Height="11"
                                    Data="{StaticResource PeopleIcon}"
                                    Foreground="{DynamicResource Accent}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource Accent}"
                                    Text="{Binding UserCount}" />
                            </StackPanel>
                        </Border>

                        <!--  Пустой отдел  -->
                        <Border
                            Padding="8,3"
                            Background="{DynamicResource ThirdBG}"
                            CornerRadius="10"
                            IsVisible="{Binding !ShowUserCount}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextMuted}"
                                Text="Пусто" />
                        </Border>

                        <!--  Действия (видны при hover)  -->
                        <StackPanel
                            Classes="DepartmentActions"
                            Orientation="Horizontal"
                            Spacing="2">
                            <Button
                                Classes="IconButton Small"
                                Command="{Binding $parent[local:DepartmentCardView].EditCommand}"
                                CommandParameter="{Binding Department}"
                                IsEnabled="{Binding CanEdit}"
                                ToolTip.Tip="{Binding CanEdit, Converter={x:Static BoolConverters.Not}, ConverterParameter='Редактировать|Недостаточно прав'}">
                                <PathIcon
                                    Width="14"
                                    Height="14"
                                    Data="{StaticResource EditIcon}"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!--  ── Дочерние элементы ──  -->
        <Border
            Grid.Row="1"
            Margin="16,0,0,0"
            IsVisible="{Binding IsExpanded}">
            <Grid>
                <!--  Вертикальная линия иерархии  -->
                <Border
                    Width="1.5"
                    Margin="11,0,0,8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource HierarchyLineBrush}"
                    CornerRadius="1"
                    IsVisible="{Binding HasChildren}"
                    Opacity="0.6" />

                <ItemsControl Margin="16,2,0,0" ItemsSource="{Binding Children}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="0" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:HierarchicalDepartmentViewModel">
                            <local:DepartmentCardView EditCommand="{Binding $parent[local:DepartmentCardView].EditCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>