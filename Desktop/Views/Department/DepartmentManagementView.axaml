<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:controls="using:Desktop.Views.Controls"
			 xmlns:vm="using:Desktop.ViewModels.Department"
			 xmlns:conv="using:Desktop.Converters"
			 xmlns:skeleton="using:Desktop.Views.Controls.Skeleton"
			 x:Class="Desktop.Views.Department.DepartmentManagementView"
			 x:DataType="vm:DepartmentManagementViewModel"
			 x:Name="Root"
			 Background="{DynamicResource PrimaryBG}">
	<UserControl.Styles>
		<!-- Стили для кнопок внутри списка сотрудников -->
<Style Selector="Border.DepartmentCard StackPanel.Actions">
    <Setter Property="Opacity" Value="0.4"/>
    <Setter Property="Transitions">
        <Transitions>
            <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
        </Transitions>
    </Setter>
</Style>

<Style Selector="Border.DepartmentCard:pointerover StackPanel.Actions">
    <Setter Property="Opacity" Value="1"/>
</Style>

<!-- Мягкая кнопка удаления (краснеет при наведении) -->
<Style Selector="Button.DangerSubtle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Icon}"/>
</Style>

<Style Selector="Button.DangerSubtle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
</Style>

<Style Selector="Button.DangerSubtle:pointerover PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
</Style>
	</UserControl.Styles>
	<Border Classes="PageContainer">
		<Grid RowDefinitions="Auto,*">

			<!-- 1. ЗАГОЛОВОК (Header) -->
			<Border Grid.Row="0"
					Background="{DynamicResource SecondaryBG}"
					Padding="24,18"
					BorderThickness="0,0,0,1"
					BorderBrush="{DynamicResource BorderDefault}">
				<Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
					<StackPanel Spacing="2" VerticalAlignment="Center">
						<TextBlock Text="Мой отдел" Classes="PageTitle" FontSize="22"/>
						<StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
							<PathIcon Data="{StaticResource OrganizationIcon}"
									  Foreground="{DynamicResource Accent}"
									  Width="12" Height="12"/>
							<TextBlock Text="{Binding DepartmentName}"
									   Foreground="{DynamicResource TextSecondary}"
									   FontSize="13"
									   FontWeight="Medium"/>
							<TextBlock IsVisible="{Binding CanManage}"
									   Foreground="{DynamicResource TextMuted}"
									   FontSize="13">
								<TextBlock.Text>
									<MultiBinding StringFormat=" •  {0} онлайн из {1}">
										<Binding Path="OnlineCount"/>
										<Binding Path="TotalCount"/>
									</MultiBinding>
								</TextBlock.Text>
							</TextBlock>
						</StackPanel>
					</StackPanel>

					<!-- Действия в заголовке -->
					<StackPanel Grid.Column="1"
								Orientation="Horizontal"
								Spacing="10"
								VerticalAlignment="Center"
								IsVisible="{Binding CanManage}">
						<Button Classes="IconButton Subtle"
								Command="{Binding RefreshCommand}"
								IsEnabled="{Binding !IsBusy}"
								ToolTip.Tip="Обновить список">
							<PathIcon Data="{StaticResource RefreshIcon}" Width="18" Height="18"/>
						</Button>
						<Button Classes="Primary"
								Command="{Binding AddMemberCommand}"
								Padding="16,8" Height="38">
							<StackPanel Orientation="Horizontal" Spacing="8">
								<PathIcon Data="{StaticResource AddIcon}" Width="14" Height="14"/>
								<TextBlock Text="Добавить сотрудника" FontWeight="SemiBold" Foreground="{DynamicResource TextOnAccent}"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</Grid>
			</Border>

			<Panel Grid.Row="1">
				<!-- Загрузка -->
				<skeleton:DepartmentMembersSkeleton IsVisible="{Binding IsBusy}" Background="{DynamicResource PrimaryBG}"/>

				<!-- ОСНОВНОЙ КОНТЕНТ -->
				<ScrollViewer Classes="ThinScrollbar" Padding="0,24">
					<ScrollViewer.IsVisible>
						<MultiBinding Converter="{x:Static BoolConverters.And}">
							<Binding Path="IsBusy" Converter="{x:Static BoolConverters.Not}"/>
							<Binding Path="CanManage"/>
						</MultiBinding>
					</ScrollViewer.IsVisible>
					
					<StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
						
						<!-- Секция списка (MaxWidth для удобства чтения) -->
						<Border Classes="Section" MaxWidth="850" 
								HorizontalAlignment="Center" 
								BoxShadow="0 4 12 0 #20000000"
								Background="{DynamicResource PrimaryBG}">
							<StackPanel Spacing="20">
								
								<!-- Инструменты списка -->
								<Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
									<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
										<PathIcon Data="{StaticResource PersonIcon}"
												  Width="18" Height="18"
												  Foreground="{DynamicResource Accent}"/>
										<TextBlock Text="Состав отдела"
												   VerticalAlignment="Center"
												   FontSize="16"
												   FontWeight="Bold"/>
										<Border Background="{DynamicResource AccentMuted}" 
												CornerRadius="6" Padding="6,2">
											<TextBlock Text="{Binding TotalCount}"
													   FontSize="12" FontWeight="Bold"
													   Foreground="{DynamicResource Accent}"/>
										</Border>
									</StackPanel>
									
									<controls:SearchBox Grid.Column="1"
														SearchText="{Binding SearchQuery}"
														Width="260"
														Watermark="Поиск..."/>
								</Grid>

								<!-- Состояние: Не найдено -->
								<Border IsVisible="{Binding !FilteredMembers.Count}"
										Padding="60"
										Background="{DynamicResource PrimaryBG}"
										CornerRadius="12">
									<StackPanel Spacing="12" HorizontalAlignment="Center">
										<PathIcon Data="{StaticResource SearchIcon}"
												  Width="48" Height="48"
												  Foreground="{DynamicResource TextMuted}" Opacity="0.5"/>
										<TextBlock Text="Сотрудники не найдены"
												   FontWeight="Medium"
												   Foreground="{DynamicResource TextSecondary}"/>
									</StackPanel>
								</Border>

								<!-- Список сотрудников -->
								<ItemsControl ItemsSource="{Binding FilteredMembers}"
											  IsVisible="{Binding FilteredMembers.Count}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Spacing="4"/>
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>

									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="vm:DepartmentMemberViewModel">
											<!-- Карточка -->
											<Border Classes="Hoverable DepartmentCard"
													Background="{DynamicResource ItemBgBrush}"
													CornerRadius="10"
													Padding="12,10">
												<Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">

													<controls:AvatarControl Grid.Column="0"
																			Classes="Medium"
																			Source="{Binding AvatarUrl}"
																			DisplayName="{Binding DisplayName}"
																			IsOnline="{Binding IsOnline}"
																			VerticalAlignment="Center"/>

													<StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
														<TextBlock Text="{Binding DisplayName}"
																   FontWeight="SemiBold"
																   FontSize="14"/>
														<TextBlock Text="{Binding Username, StringFormat='@{0}'}"
																   Foreground="{DynamicResource TextMuted}"
																   FontSize="12"/>
													</StackPanel>

													<!-- Статус -->
													<StackPanel Grid.Column="2"
																Orientation="Horizontal"
																Spacing="8"
																VerticalAlignment="Center">
														<Ellipse Width="8" Height="8"
																 Fill="{Binding IsOnline, Converter={conv:Converter Name=BoolToOnline}}"/>
														<TextBlock Text="{Binding StatusText}"
																   FontSize="12"
																   Foreground="{DynamicResource TextMuted}"/>
													</StackPanel>

													<!-- Кнопки действий -->
													<StackPanel Grid.Column="3"
																Orientation="Horizontal"
																Spacing="4"
																Classes="Actions"
																VerticalAlignment="Center">
														<Button Classes="IconButton Small Subtle"
																Command="{Binding #Root.DataContext.OpenChatCommand}"
																CommandParameter="{Binding}"
																ToolTip.Tip="Написать">
															<PathIcon Data="{StaticResource SendIcon}" Width="14" Height="14"/>
														</Button>
														<Button Classes="IconButton Small DangerSubtle"
																Command="{Binding #Root.DataContext.RemoveMemberCommand}"
																CommandParameter="{Binding}"
																ToolTip.Tip="Удалить из отдела">
															<PathIcon Data="{StaticResource CloseIcon}" Width="14" Height="14"/>
														</Button>
													</StackPanel>
												</Grid>
											</Border>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</StackPanel>
						</Border>
					</StackPanel>
				</ScrollViewer>

				<!-- 2. СОСТОЯНИЕ: ОШИБКА -->
				<Border Background="{DynamicResource PrimaryBG}" 
						IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
					<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
						<Panel>
							<Ellipse Width="80" Height="80" Fill="{DynamicResource DangerBgBrush}"/>
							<PathIcon Data="{StaticResource WarningIcon}" Width="32" Height="32" Foreground="{DynamicResource DangerBrush}"/>
						</Panel>
						<TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" MaxWidth="300"/>
						<Button Classes="Primary" Content="Повторить запрос" Command="{Binding RefreshCommand}"/>
					</StackPanel>
				</Border>

				<!-- 3. СОСТОЯНИЕ: НЕТ ОТДЕЛА -->
				<Border Background="{DynamicResource PrimaryBG}" IsVisible="{Binding HasNoDepartment}">
					<StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="20">
						<Border Width="80" Height="80" CornerRadius="40" Background="{DynamicResource SecondaryBG}">
							<PathIcon Data="{StaticResource OrganizationIcon}" Width="32" Height="32" Foreground="{DynamicResource TextMuted}"/>
						</Border>
						<TextBlock Text="{Binding NoDepartmentMessage}" Foreground="{DynamicResource TextSecondary}" FontSize="16" FontWeight="Medium"/>
					</StackPanel>
				</Border>
			</Panel>
		</Grid>
	</Border>
</UserControl>