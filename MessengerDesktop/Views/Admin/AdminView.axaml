<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:admin="using:MessengerDesktop.ViewModels.Admin"
			 xmlns:adminCon="using:MessengerDesktop.Views.Controls.Admin"
			 xmlns:views="using:MessengerDesktop.Views"
			 xmlns:controls="using:MessengerDesktop.Views.Controls"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:MessengerDesktop.ViewModels"
			 xmlns:conv="using:MessengerDesktop.Converters"
             xmlns:skeleton="using:MessengerDesktop.Views.Controls.Skeleton"
			 x:Class="MessengerDesktop.Views.AdminView"
			 x:DataType="vm:AdminViewModel"
			 x:Name="Root"
			 Background="{DynamicResource PrimaryBG}"
			 Design.Width="1280" Design.Height="720">
	<UserControl.Styles>
		<Style Selector="ListBox.NavMenu">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>
	</UserControl.Styles>
	<Border Classes="PageContainer">
		<Grid x:Name="MainGrid">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="240" MinWidth="52" MaxWidth="360"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition MinWidth="400"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0"
					Background="{DynamicResource SecondaryBG}"
					BorderThickness="0,0,1,0"
					BorderBrush="{DynamicResource BorderDefault}">
				<DockPanel>

					<Border DockPanel.Dock="Top" Padding="16,20,16,14">
						<Panel>
							<StackPanel Spacing="2"
										IsVisible="{Binding !IsCompactMode, ElementName=Root}">
								<TextBlock Text="Администрирование"
										   FontSize="17"
										   FontWeight="Bold"
										   Foreground="{DynamicResource TextPrimary}"/>
								<TextBlock Text="Управление системой"
										   FontSize="11"
										   Foreground="{DynamicResource TextMuted}"/>
							</StackPanel>

							<Button Classes="IconButton"
									IsVisible="{Binding IsCompactMode, ElementName=Root}"
									Click="OnExpandButtonClick"
									ToolTip.Tip="Развернуть"
									HorizontalAlignment="Center">
								<PathIcon Data="{StaticResource MenuIcon}"
										  Width="18" Height="18"
										  Foreground="{DynamicResource Icon}"/>
							</Button>
						</Panel>
					</Border>

					<Border DockPanel.Dock="Top"
							Height="1"
							Background="{DynamicResource BorderDefault}"
							Margin="12,0,12,0"
							Opacity="0.6"/>

					<ScrollViewer DockPanel.Dock="Top" Margin="8,12,8,8">
						<StackPanel Spacing="4">
							<TextBlock Text="РАЗДЕЛЫ"
									   Classes="CategoryHeader"
									   Margin="8,0,0,4"
									   IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>

							<ListBox SelectedIndex="{Binding SelectedTabIndex}"
									 Classes="NavMenu">
								<ListBoxItem ToolTip.Tip="Сотрудники">
									<StackPanel Orientation="Horizontal" Spacing="10">
										<PathIcon Data="{StaticResource PersonIcon}" Width="16" Height="16"/>
										<TextBlock Text="Сотрудники"
												   VerticalAlignment="Center"
												   IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>
									</StackPanel>
								</ListBoxItem>

								<ListBoxItem ToolTip.Tip="Отделы">
									<StackPanel Orientation="Horizontal" Spacing="10">
										<PathIcon Data="{StaticResource OrganizationIcon}" Width="16" Height="16"/>
										<TextBlock Text="Отделы"
												   VerticalAlignment="Center"
												   IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>
									</StackPanel>
								</ListBoxItem>
							</ListBox>
						</StackPanel>
					</ScrollViewer>
				</DockPanel>
			</Border>

			<GridSplitter x:Name="GridSplitter"
						  Grid.Column="1"
						  Width="16"
						  ResizeDirection="Columns"
						  Background="Transparent"
						  ResizeBehavior="PreviousAndNext">
				<GridSplitter.Template>
					<ControlTemplate>
						<Border Background="Transparent">
							<Border Width="1"
									CornerRadius="1"
									Background="{DynamicResource BorderDefault}"
									HorizontalAlignment="Center"
									VerticalAlignment="Stretch"
									Opacity="0.5"/>
						</Border>
					</ControlTemplate>
				</GridSplitter.Template>
			</GridSplitter>

			<Border Grid.Column="2" Background="{DynamicResource PrimaryBG}">
				<DockPanel Margin="24,24,24,0">

					<StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
						<TextBlock FontSize="24"
								   FontWeight="Bold"
								   Text="{Binding SelectedTabIndex,
								   Converter={conv:Converter Name=IndexToText},
								   ConverterParameter='Сотрудники|Отделы'}"/>
						<TextBlock FontSize="13"
								   Margin="0,4,0,0"
								   Foreground="{DynamicResource TextSecondary}"
								   Text="{Binding SelectedTabIndex,
								   Converter={conv:Converter Name=IndexToText},
								   ConverterParameter='Управление учётными записями|Структура отделов организации'}"/>
					</StackPanel>

					<Grid DockPanel.Dock="Top"
						  ColumnDefinitions="*,Auto,Auto"
						  Margin="0,0,0,16">


						<controls:SearchBox x:Name="SearchTextBox"
											SearchText="{Binding SearchQuery}"
											Watermark="Поиск..."/>

						<Button Grid.Column="1"
								Command="{Binding RefreshCommand}"
								Classes="IconButton"
								Margin="12,0,0,0"
								VerticalAlignment="Center"
								ToolTip.Tip="Обновить">
							<PathIcon Data="{StaticResource RefreshIcon}" Width="15" Height="15" Foreground="{DynamicResource Icon}"/>
						</Button>

						<Button Grid.Column="2"
								Classes="Primary"
								Command="{Binding CreateCommand}"
								Margin="8,0,0,0"
								VerticalAlignment="Center"
								ToolTip.Tip="{Binding SelectedTabIndex, Converter={conv:Converter Name=IndexToText}, ConverterParameter='Добавить сотрудника|Создать отдел'}">
							<StackPanel Orientation="Horizontal" Spacing="6">
								<PathIcon Data="{StaticResource AddIcon}" Width="13" Height="13" Foreground="{DynamicResource TextOnAccent}"/>
								<TextBlock Foreground="{DynamicResource TextOnAccent}"
										   FontWeight="SemiBold"
										   FontSize="13"
										   Text="{Binding SelectedTabIndex, Converter={conv:Converter Name=IndexToText}, ConverterParameter='Добавить|Создать'}"
										   IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>
							</StackPanel>
						</Button>
					</Grid>

					<Panel>
						<Border IsVisible="{Binding IsBusy}"
								Background="{DynamicResource PrimaryBG}"
								ZIndex="10"
								CornerRadius="14,14,0,0">
							<Panel>
								<skeleton:AdminUsersSkeleton IsVisible="{Binding SelectedTabIndex, Converter={conv:Converter Name=Equals}, ConverterParameter=0}"/>
								<skeleton:AdminDepartmentsSkeleton IsVisible="{Binding SelectedTabIndex, Converter={conv:Converter Name=Equals}, ConverterParameter=1}"/>
							</Panel>
						</Border>

						<TransitioningContentControl Content="{Binding CurrentTab}"
													 IsVisible="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}"
													 HorizontalContentAlignment="Stretch"
													 VerticalContentAlignment="Stretch">
							<TransitioningContentControl.PageTransition>
								<CrossFade Duration="0:0:0.18"/>
							</TransitioningContentControl.PageTransition>

							<TransitioningContentControl.DataTemplates>

								<DataTemplate DataType="vm:UsersTabViewModel">
									<Border Background="{DynamicResource SecondaryBG}"
											BorderThickness="1,1,1,0"
											BorderBrush="{DynamicResource BorderDefault}"
											CornerRadius="14,14,0,0">
										<Panel>
											<ListBox ItemsSource="{Binding $parent[views:AdminView].DataContext.FilteredGroupedUsers}"
													 IsVisible="{Binding $parent[views:AdminView].DataContext.HasUsers, FallbackValue=False}"
													 Margin="12,12,12,24"
													 Background="Transparent"
													 BorderThickness="0"
													 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
												<ListBox.Styles>
													<Style Selector="ListBoxItem">
														<Setter Property="Padding" Value="0,0,0,12"/>
														<Setter Property="Background" Value="Transparent"/>
													</Style>
													<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
														<Setter Property="Background" Value="Transparent"/>
													</Style>
													<Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
														<Setter Property="Background" Value="Transparent"/>
													</Style>
												</ListBox.Styles>
												<ListBox.ItemTemplate>
													<DataTemplate DataType="admin:DepartmentGroup">
														<adminCon:DepartmentGroupView
														EditUserCommand="{Binding $parent[views:AdminView].DataContext.OpenEditUserDialogCommand}"
														BanUserCommand="{Binding $parent[views:AdminView].DataContext.ToggleBanCommand}"/>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>

											<StackPanel VerticalAlignment="Center"
														HorizontalAlignment="Center"
														Spacing="16"
														Margin="24">
												<StackPanel.IsVisible>
													<MultiBinding Converter="{conv:MultiConverter Name=BooleanAnd}">
														<Binding Path="$parent[views:AdminView].DataContext.HasUsers" Converter="{x:Static BoolConverters.Not}"/>
														<Binding Path="$parent[views:AdminView].DataContext.IsBusy" Converter="{x:Static BoolConverters.Not}"/>
														<Binding Path="$parent[views:AdminView].DataContext.SearchQuery" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
													</MultiBinding>
												</StackPanel.IsVisible>

												<PathIcon Data="{StaticResource SearchIcon}" Width="48" Height="48" Foreground="{DynamicResource TextMuted}" Opacity="0.3" HorizontalAlignment="Center"/>
												<TextBlock Text="Ничего не найдено" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
												<TextBlock FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260">
													<Run Text="По запросу «"/>
													<Run Text="{Binding $parent[views:AdminView].DataContext.SearchQuery}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
													<Run Text="» сотрудников не найдено"/>
												</TextBlock>
											</StackPanel>
										</Panel>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="vm:DepartmentsTabViewModel">
									<Border Background="{DynamicResource SecondaryBG}"
											BorderThickness="1,1,1,0"
											BorderBrush="{DynamicResource BorderDefault}"
											CornerRadius="14,14,0,0">
										<Panel>
											<ListBox ItemsSource="{Binding $parent[views:AdminView].DataContext.FilteredHierarchicalDepartments}"
													 IsVisible="{Binding $parent[views:AdminView].DataContext.HasDepartments, FallbackValue=False}"
													 Margin="12,12,12,24"
													 Background="Transparent"
													 BorderThickness="0"
													 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
												<ListBox.Styles>
													<Style Selector="ListBoxItem">
														<Setter Property="Padding" Value="0,0,0,8"/>
														<Setter Property="Background" Value="Transparent"/>
													</Style>
													<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
														<Setter Property="Background" Value="Transparent"/>
													</Style>
													<Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
														<Setter Property="Background" Value="Transparent"/>
													</Style>
												</ListBox.Styles>
												<ListBox.ItemTemplate>
													<DataTemplate DataType="vm:HierarchicalDepartmentViewModel">
														<adminCon:DepartmentCardView
														EditCommand="{Binding $parent[views:AdminView].DataContext.OpenEditDepartmentCommand}"/>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>

											<StackPanel VerticalAlignment="Center"
														HorizontalAlignment="Center"
														Spacing="16"
														Margin="24">
												<StackPanel.IsVisible>
													<MultiBinding Converter="{conv:MultiConverter Name=BooleanAnd}">
														<Binding Path="$parent[views:AdminView].DataContext.HasDepartments" Converter="{x:Static BoolConverters.Not}"/>
														<Binding Path="$parent[views:AdminView].DataContext.IsBusy" Converter="{x:Static BoolConverters.Not}"/>
														<Binding Path="$parent[views:AdminView].DataContext.SearchQuery" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
													</MultiBinding>
												</StackPanel.IsVisible>

												<PathIcon Data="{StaticResource SearchIcon}" Width="48" Height="48" Foreground="{DynamicResource TextMuted}" Opacity="0.3" HorizontalAlignment="Center"/>
												<TextBlock Text="Ничего не найдено" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
												<TextBlock FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260">
													<Run Text="Отдел «"/>
													<Run Text="{Binding $parent[views:AdminView].DataContext.SearchQuery}" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
													<Run Text="» не найден"/>
												</TextBlock>
											</StackPanel>
										</Panel>
									</Border>
								</DataTemplate>

							</TransitioningContentControl.DataTemplates>
						</TransitioningContentControl>
					</Panel>
				</DockPanel>
			</Border>
		</Grid>
	</Border>
</UserControl>