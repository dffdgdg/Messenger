<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Desktop.ViewModels.Call"
             xmlns:controls="using:Desktop.Views.Controls"
             xmlns:conv="using:Desktop.Converters"
             x:Class="Desktop.Views.Call.CallView"
             x:DataType="vm:CallViewModel" Background="{DynamicResource PrimaryBG}"
             Design.Width="1280" Design.Height="600">
      <UserControl.Styles>
	<Style Selector="Border.CallTile">
		<Setter Property="Background" Value="{DynamicResource ThirdBG}"/>
		<Setter Property="CornerRadius" Value="14"/>
		<Setter Property="Margin" Value="6"/>
		<Setter Property="ClipToBounds" Value="True"/>
		<Setter Property="Transitions">
			<Transitions>
				<BrushTransition Property="BorderBrush" Duration="0:0:0.15"/>
				<BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Border.CallTile.Speaking">
		<Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="BoxShadow" Value="0 0 12 #3390EC40"/>
	</Style>
        <Style Selector="TextBox.ChatInput">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="MaxHeight" Value="120"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="TextBox.ChatInput /template/ Border,
		TextBox.ChatInput:focus-within /template/ Border,
		TextBox.ChatInput:pointerover /template/ Border">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
          <Style Selector="ToggleButton.CallToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="ToggleButton.CallToggleButton:checked">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="ToggleButton.CallToggleButton Path">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"/>
        </Style>

        <Style Selector="Button.CallToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="Button.CallToggleButton.Active">
            <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Button.CallToggleButton Path">
            <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </Style>
    </UserControl.Styles>

    <Border Classes="PageContainer" Margin="0">
        <Grid ColumnDefinitions="*,Auto">

            <!-- Основной контент -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto">

                <!-- Шапка -->
                <Border Grid.Row="0" Padding="24,20" Background="Transparent">
                    <Grid ColumnDefinitions="*,Auto,*">
                        <StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="16">

                            <!-- Название + таймер -->
                            <Border Background="{DynamicResource SecondaryBG}"
                                    CornerRadius="12"
                                    Padding="16,8"
                                    BorderBrush="{DynamicResource ControlBorder}"
                                    BorderThickness="1">
                                <StackPanel HorizontalAlignment="Center" Spacing="12"
                                            Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ChatName}"
                                               Classes="ChatName" FontSize="15"
                                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Width="1" Height="14"
                                            Background="{DynamicResource BorderDefault}"
                                            VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding DurationText}"
                                               Classes="TextSecondary" FontSize="13"
                                               FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Участники — кликабельный, стиль как у соседа -->
                            <Button Command="{Binding OpenParticipantsPanelCommand}"
                                    ToolTip.Tip="Участники звонка"
                                    Height="50"
                                    Cursor="Hand"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    CornerRadius="12">
                                <Border Background="{DynamicResource SecondaryBG}"
                                        CornerRadius="12"
                                        Height="50"                                        Padding="16,8"
                                        BorderBrush="{DynamicResource ControlBorder}"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <Path Data="{StaticResource PeopleIcon}"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Fill="{DynamicResource TextSecondary}"
                                              VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Participants.Count}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </Button>

                        </StackPanel>

                        <Button Grid.Column="2"
                                Background="{DynamicResource SecondaryBG}"
                                BorderBrush="{DynamicResource ControlBorder}"
                                Command="{Binding CloseUiCommand}"
                                Classes="ScrollToBottomBtn"
                                ToolTip.Tip="Свернуть окно звонка"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Width="50" Height="50" CornerRadius="12">
                            <Path Data="{StaticResource ChevronIcon}"
                                  Margin="14" Stretch="Uniform"
                                  Fill="{DynamicResource TextSecondary}"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- Тайлы участников -->
                <Grid Grid.Row="1">
                    <ItemsControl ItemsSource="{Binding Participants}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Margin="24,0,24,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="{Binding GridColumns}" Rows="{Binding GridRows}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:CallParticipantViewModel">
                                <Border Classes="CallTile"
                                        Classes.Speaking="{Binding IsSpeaking}"
                                        Background="{DynamicResource ThirdBG}"
                                        CornerRadius="16" Margin="6" ClipToBounds="True">
                                    <Grid>
                                        <controls:AvatarControl
                                            Size="{Binding AvatarSize}"
                                            Source="{Binding AvatarUrl}"
                                            DisplayName="{Binding DisplayName}"
                                            ShowOnlineIndicator="False"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>

                                        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                Background="#C8000000" Margin="12"
                                                CornerRadius="10" Padding="12,8" MaxWidth="220"
                                                BoxShadow="0 4 8 0 #40000000">
                                            <TextBlock Text="{Binding DisplayName}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="White"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                        </Border>

                                        <Border IsVisible="{Binding IsMuted}"
                                                Background="{DynamicResource SecondaryBG}"
                                                Width="32" Height="32" CornerRadius="16"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="12" BoxShadow="0 2 8 0 #30000000">
                                            <Path Data="{StaticResource MicOff}"
                                                  Fill="{DynamicResource DangerBrush}"
                                                  Width="14" Height="14" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- Панель управления -->
                <Border Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,32" Padding="8"
                        CornerRadius="32"
                        Background="{DynamicResource SecondaryBG}"
                        BorderBrush="{DynamicResource ControlBorder}"
                        BorderThickness="1"
                        BoxShadow="0 8 24 0 #1A000000">
                    <Grid ColumnDefinitions="Auto,*,Auto">

                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    Spacing="12" Margin="16,0">

                            <ToggleButton Classes="IconButton CallToggleButton"                                          IsChecked="{Binding NoiseSuppressionEnabled}"
                                          ToolTip.Tip="Шумоподавление"
                                          Width="48" Height="48" CornerRadius="24">
                                <Path Data="{StaticResource Noise}"
                                      Stretch="Uniform" Margin="12"/>
                            </ToggleButton>

                            <Button Command="{Binding ToggleMuteCommand}"
                                    Classes="IconButton"
                                    Classes.Active="{Binding IsMuted}"
                                    Width="48" Height="48" CornerRadius="24"
                                    ToolTip.Tip="{Binding IsMuted, Converter={conv:Converter Name=BoolToString},
                                                 ConverterParameter='Включить микрофон|Выключить микрофон'}">
                                <Path Data="{Binding IsMuted, Converter={conv:Converter Name=BoolToGeometry},
                                            ConverterParameter='M3.28 2.22a.75.75 0 1 0-1.06 1.06L8 9.06V12a4 4 0 0 0 6.248 3.309l1.146 1.146A5.227 5.227 0 0 1 12.25 17.5h-.5l-.216-.004A5.25 5.25 0 0 1 6.5 12.25v-.5l-.007-.102A.75.75 0 0 0 5 11.75v.5l.004.236a6.75 6.75 0 0 0 6.246 6.496v2.268l.007.102a.75.75 0 0 0 1.493-.102l.001-2.268a6.718 6.718 0 0 0 3.712-1.458l4.256 4.256a.75.75 0 0 0 1.061-1.06L3.28 2.22ZM17.196 14.014l1.146 1.146A6.725 6.725 0 0 0 19 12.25v-.5l-.007-.102a.75.75 0 0 0-1.493.102v.5l-.004.216a5.233 5.233 0 0 1-.3 1.548ZM8.138 4.956l7.792 7.792c.046-.242.07-.492.07-.748V6a4 4 0 0 0-7.862-1.044Z|M18.25 11a.75.75 0 0 1 .743.648l.007.102v.5a6.75 6.75 0 0 1-6.249 6.732l-.001 2.268a.75.75 0 0 1-1.493.102l-.007-.102v-2.268a6.75 6.75 0 0 1-6.246-6.496L5 12.25v-.5a.75.75 0 0 1 1.493-.102l.007.102v.5a5.25 5.25 0 0 0 5.034 5.246l.216.004h.5a5.25 5.25 0 0 0 5.246-5.034l.004-.216v-.5a.75.75 0 0 1 .75-.75ZM12 2a4 4 0 0 1 4 4v6a4 4 0 0 1-8 0V6a4 4 0 0 1 4-4Z'}"
                                      Fill="{DynamicResource TextPrimary}"
                                      Stretch="Uniform" Margin="12"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>

                            <!-- Кнопка чата с бейджем -->
                            <Panel Width="48" Height="48">
                                <Button Command="{Binding ToggleChatPanelCommand}"
                                        Classes="IconButton CallToggleButton"
                                        Classes.Active="{Binding IsChatPanelOpen}"
                                        Width="48" Height="48" CornerRadius="24"
                                        ToolTip.Tip="Чат звонка">
                                    <Path Data="{StaticResource ChatsIcon}"
                                          Stretch="Uniform" Margin="12"/>
                                </Button>
                                <Border IsVisible="{Binding HasUnread}"
                                        Background="{DynamicResource DangerBrush}"
                                        CornerRadius="10" Padding="5,1"
                                        MinWidth="20" Height="20"
                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                        Margin="0,0,-2,0"
                                        BorderBrush="{DynamicResource SecondaryBG}"
                                        BorderThickness="2">
                                    <TextBlock Text="{Binding UnreadChatCount}"
                                               FontSize="11" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Panel>

                        </StackPanel>

                        <!-- Кнопка завершить — справа отдельно -->
                        <Button Grid.Column="2"
                                Command="{Binding LeaveCallCommand}"
                                Classes="IconButton Danger"
                                Background="{DynamicResource DangerBrush}"
                                Width="64" Height="48" CornerRadius="24" Padding="0"
                                ToolTip.Tip="Завершить звонок">
                            <Path Data="{StaticResource DeclineCallIcon}"
                                  Fill="White" Stretch="Uniform" Margin="14,12"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                    </Grid>
                </Border>

            </Grid>

            <!-- Боковая панель -->
            <Border x:Name="SidePanel"
                    Grid.Column="1"
                    Width="340"
                    Background="{DynamicResource PrimaryBG}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1,0,0,0"
                    BoxShadow="-4 0 16 0 #0D000000">
                <Grid RowDefinitions="64,*,Auto">

                    <!-- Шапка панели -->
                    <Border Grid.Row="0"
                            BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="0,0,0,1"
                            Padding="16,0">
                        <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                            <Panel VerticalAlignment="Center">
                                <TextBlock Text="Чат звонка"
                                           IsVisible="{Binding IsChatMode}"
                                           FontWeight="SemiBold" FontSize="16"/>
                                <TextBlock Text="Участники"
                                           IsVisible="{Binding IsParticipantsMode}"
                                           FontWeight="SemiBold" FontSize="16"/>
                            </Panel>
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleChatPanelCommand}"
                                    Classes="IconButton Small">
                                <PathIcon Data="{StaticResource CloseIcon}" Width="12" Height="12"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Содержимое -->
                    <Grid Grid.Row="1">

                        <!-- Режим чата -->
                        <ScrollViewer Name="ChatScrollViewer"
                                      IsVisible="{Binding IsChatMode}"
                                      Classes="ThinScrollbar AutoHideScrollbar"
                                      Padding="12,8">
                            <ItemsControl ItemsSource="{Binding ChatMessages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:CallChatMessageViewModel">
                                        <Grid Margin="0,4">

                                            <!-- Своё — справа -->
                                            <Border IsVisible="{Binding IsOwn}"
                                                    HorizontalAlignment="Right"
                                                    MaxWidth="240"
                                                    Background="{DynamicResource Accent}"
                                                    CornerRadius="12,12,2,12"
                                                    Padding="10,7">
                                                <StackPanel Spacing="3">
                                                    <TextBlock Text="{Binding Text}"
                                                               FontSize="13" Foreground="White"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding TimeText}"
                                                               FontSize="10" Foreground="#99FFFFFF"
                                                               HorizontalAlignment="Right"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Чужое — слева -->
                                            <StackPanel IsVisible="{Binding !IsOwn}"
                                                        HorizontalAlignment="Left"
                                                        MaxWidth="240" Spacing="3">
                                                <TextBlock Text="{Binding SenderName}"
                                                           FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Accent}"
                                                           Margin="4,0,0,0"/>
                                                <Border Background="{DynamicResource SecondaryBG}"
                                                        CornerRadius="2,12,12,12"
                                                        Padding="10,7">
                                                    <StackPanel Spacing="3">
                                                        <TextBlock Text="{Binding Text}"
                                                                   FontSize="13" TextWrapping="Wrap"/>
                                                        <TextBlock Text="{Binding TimeText}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   HorizontalAlignment="Right"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Режим участников -->
                        <ScrollViewer IsVisible="{Binding IsParticipantsMode}"
                                      Classes="ThinScrollbar AutoHideScrollbar"
                                      Padding="8">
                            <ItemsControl ItemsSource="{Binding Participants}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:CallParticipantViewModel">
                                        <Border Padding="8,6" CornerRadius="8" Margin="0,2">
                                            <Grid ColumnDefinitions="Auto,*,Auto">

                                                <Border Width="40" Height="40"
                                                        CornerRadius="20"
                                                        BorderThickness="2"
                                                        BorderBrush="Transparent"
                                                        Classes.Speaking="{Binding IsSpeaking}">
                                                    <Border.Styles>
                                                        <Style Selector="Border.Speaking">
                                                            <Setter Property="BorderBrush" Value="#4CAF50"/>
                                                        </Style>
                                                    </Border.Styles>
                                                    <controls:AvatarControl
                                                        Size="36"
                                                        Source="{Binding AvatarUrl}"
                                                        DisplayName="{Binding DisplayName}"
                                                        ShowOnlineIndicator="False"/>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding DisplayName}"
                                                           FontSize="14"
                                                           VerticalAlignment="Center"
                                                           Margin="10,0,0,0"
                                                           TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            Spacing="4"
                                                            VerticalAlignment="Center">
                                                    <Path IsVisible="{Binding IsMuted}"
                                                          Data="{StaticResource MicOff}"
                                                          Width="14" Height="14"
                                                          Stretch="Uniform"
                                                          Fill="{DynamicResource DangerBrush}"/>
                                                    <Ellipse IsVisible="{Binding IsSpeaking}"
                                                             Width="8" Height="8"
                                                             Fill="#4CAF50"
                                                             VerticalAlignment="Center"/>
                                                </StackPanel>

                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                    </Grid>

                    <!-- Поле ввода — только в режиме чата -->
                    <Border Grid.Row="2"
                            IsVisible="{Binding IsChatMode}"
                            BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="0,1,0,0"
                            Padding="12"
                            Background="{DynamicResource PrimaryBG}">
                        <Border Background="{DynamicResource PrimaryBG}"
                                CornerRadius="14">
                            <Grid Margin="4" ColumnDefinitions="*,Auto,Auto">
                                <TextBox Grid.Column="0"
                                         Classes="ChatInput"
                                         Text="{Binding MessageInput, Mode=TwoWay}"
                                         PlaceholderText="Сообщение..."
                                         MaxLength="2000">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter"
                                                    Command="{Binding SendChatMessageCommand}"/>
                                    </TextBox.KeyBindings>
                                </TextBox>

                                <Button Grid.Column="1"
                                        Classes="IconButton"
                                        ToolTip.Tip="Эмодзи"
                                        Width="44" Height="44"
                                        CornerRadius="10"
                                        VerticalAlignment="Bottom">
                                    <Button.Flyout>
                                        <Flyout Placement="TopEdgeAlignedRight"
                                                ShowMode="TransientWithDismissOnPointerMoveAway"
                                                FlyoutPresenterClasses="EmojiPickerFlyout">
                                            <StackPanel Spacing="6" Width="300">
                                                <TextBlock Text="ЭМОДЗИ"
                                                           Classes="CategoryHeader"
                                                           Margin="4,0,0,2"/>
                                                <ItemsControl ItemsSource="{Binding PopularEmojis}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Classes="EmojiButton"
                                                                    Content="{Binding}"
                                                                    Command="{Binding $parent[UserControl].((vm:CallViewModel)DataContext).InsertEmojiCommand}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                    <Path Data="{StaticResource EmojiIcon}"
                                          Fill="{DynamicResource TextSecondary}"
                                          Width="20" Height="20"
                                          Stretch="Uniform"/>
                                </Button>

                                <Button Grid.Column="2"
                                        Classes="Primary"
                                        Margin="4"
                                        Width="36" Height="36"
                                        CornerRadius="10"
                                        Padding="0"
                                        Command="{Binding SendChatMessageCommand}"
                                        VerticalAlignment="Bottom"
                                        ToolTip.Tip="Отправить">
                                    <Path Data="{StaticResource SendIcon}"
                                          Fill="White" Width="18" Height="18"
                                          Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>
                    </Border>

                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>