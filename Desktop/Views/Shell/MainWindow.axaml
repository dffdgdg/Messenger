<Window
    x:Class="Desktop.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:auth="using:Desktop.Views.Auth"
    xmlns:call="using:Desktop.ViewModels.Call"
    xmlns:callView="using:Desktop.Views.Call"
    xmlns:chat="using:Desktop.Views.Chat"
    xmlns:controls="using:Desktop.Views.Controls"
    xmlns:conv="using:Desktop.Converters"
    xmlns:department="using:Desktop.Views.Department"
    xmlns:dialog="using:Desktop.Views.Dialog"
    xmlns:dialogs="using:Desktop.Views.Dialogs"
    xmlns:views="using:Desktop.Views"
    xmlns:vm="using:Desktop.ViewModels"
    xmlns:vmChat="using:Desktop.ViewModels.Chat"
    xmlns:vmDepartment="using:Desktop.ViewModels.Department"
    xmlns:vmDialog="using:Desktop.ViewModels.Dialog"
    x:Name="MainWindowRoot"
    Title="ВнутрьСеть"
    MinWidth="700"
    MinHeight="500"
    x:DataType="vm:MainWindowViewModel"
    Background="{DynamicResource PrimaryBG}"
    CanResize="True"
    ExtendClientAreaTitleBarHeightHint="-1"
    ExtendClientAreaToDecorationsHint="True"
    Icon="/Assets/logo-circle.ico"
    TransparencyLevelHint="AcrylicBlur"
    WindowDecorations="Full">

    <Window.Styles>
        <Style Selector="WindowDrawnDecorations /template/ Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="Width" Value="0" />
        </Style>
        <Style Selector="WindowDrawnDecorations /template/ Panel#PART_TitleTextPanel > TextBlock">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.DialogOverlay">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Opacity"
                        Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.DialogOverlay.Open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <Style Selector="Border.DialogAnimWrapper">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform" Value="scale(0.9,0.9) translateY(30px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Opacity"
                        Duration="0:0:0.2" />
                    <TransformOperationsTransition
                        Easing="CubicEaseOut"
                        Property="RenderTransform"
                        Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.DialogAnimWrapper.Open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1,1) translateY(0px)" />
        </Style>
        <Style Selector="Border.DialogAnimWrapper.Closing">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(0.95,0.95) translateY(20px)" />
        </Style>

        <Style Selector="Button.NavArrowButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.55" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NavArrowButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.NavArrowButton:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.NavArrowButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
        </Style>
        <Style Selector="Button.NavArrowButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderHover}" />
        </Style>
        <Style Selector="Button.NavArrowButton:disabled">
            <Setter Property="Opacity" Value="0.2" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
    </Window.Styles>

    <Panel>

        <ContentControl
            Margin="{Binding IsMainMenuActive, Converter={conv:Converter Name=BoolToThickness}, ConverterParameter='0,48,0,0|0'}"
            Content="{Binding CurrentViewModel}"
            ZIndex="0">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:LoginViewModel">
                    <auth:LoginView />
                </DataTemplate>
                <DataTemplate DataType="vm:MainMenuViewModel">
                    <views:MainMenuView />
                </DataTemplate>
                <DataTemplate DataType="vm:ChatsViewModel">
                    <views:ChatsView />
                </DataTemplate>
                <DataTemplate DataType="vmChat:ChatViewModel">
                    <chat:ChatView />
                </DataTemplate>
                <DataTemplate DataType="vm:AdminViewModel">
                    <views:AdminView />
                </DataTemplate>
                <DataTemplate DataType="vm:ProfileViewModel">
                    <views:ProfileView />
                </DataTemplate>
                <DataTemplate DataType="vm:SettingsViewModel">
                    <views:SettingsView />
                </DataTemplate>
                <DataTemplate DataType="vmDepartment:DepartmentManagementViewModel">
                    <department:DepartmentManagementView />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

        <Grid
            Height="48"
            VerticalAlignment="Top"
            ColumnDefinitions="*,Auto,*"
            IsVisible="{Binding IsMainMenuActive}"
            ZIndex="100">

            <Panel
                Grid.Column="0"
                Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed" />

            <Panel
                Grid.Column="1"
                Width="360"
                MinWidth="160"
                MaxWidth="460"
                IsHitTestVisible="False" />

            <Panel
                Grid.Column="2"
                Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed" />
        </Grid>

        <Grid
            Height="48"
            VerticalAlignment="Top"
            ColumnDefinitions="*,Auto,*"
            IsVisible="{Binding IsMainMenuActive}"
            ZIndex="101">

            <StackPanel
                Grid.Column="0"
                Margin="0,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    Classes="NavArrowButton"
                    Command="{Binding MainMenu.GoBackCommand}"
                    IsEnabled="{Binding MainMenu.CanGoBack}"
                    ToolTip.Tip="Назад">
                    <Path
                        Width="9"
                        Height="15"
                        Data="{StaticResource ChevronLeftIcon}"
                        Fill="{DynamicResource TextPrimary}"
                        Stretch="Uniform" />
                </Button>
                <Button
                    Classes="NavArrowButton"
                    Command="{Binding MainMenu.GoForwardCommand}"
                    IsEnabled="{Binding MainMenu.CanGoForward}"
                    ToolTip.Tip="Вперёд">
                    <Path
                        Width="9"
                        Height="15"
                        Data="{StaticResource ChevronForwardIcon}"
                        Fill="{DynamicResource TextPrimary}"
                        Stretch="Uniform" />
                </Button>
            </StackPanel>

            <controls:SearchBox
                x:Name="GlobalSearchBox"
                Grid.Column="1"
                Width="360"
                MinWidth="160"
                MaxWidth="460"
                VerticalAlignment="Bottom"
                SearchText="{Binding MainMenu.SearchText, Mode=TwoWay}"
                Watermark="{Binding MainMenu.SearchManager.SelectedScope, Converter={conv:Converter Name=SearchScopeToWatermark}}" />

            <Grid
                Grid.Column="2"
                Margin="0,0,138,0"
                IsHitTestVisible="False" />
        </Grid>

        <Grid
            Height="48"
            VerticalAlignment="Top"
            ColumnDefinitions="Auto,*,Auto"
            ZIndex="99">

            <TextBlock
                Grid.Column="0"
                Margin="16,0,16,0"
                VerticalAlignment="Center"
                FontSize="14"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimary}"
                IsVisible="{Binding #MainWindowRoot.IsCompactMode, Converter={conv:Converter Name=Equality}, ConverterParameter=False}"
                PointerPressed="OnTitleBarPointerPressed"
                Text="ВнутрьСеть" />

            <Panel
                Grid.Column="1"
                Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed" />

            <Panel
                Grid.Column="2"
                Background="Transparent"
                PointerPressed="OnTitleBarPointerPressed" />
        </Grid>

        <controls:NotificationOverlay ZIndex="9000" />

        <Border
            Margin="82,56,9,9"
            ClipToBounds="True"
            IsVisible="{Binding ActiveCallStore.IsCallUiOpen}"
            ZIndex="1001">
            <ContentControl Content="{Binding ActiveCallStore.ActiveCall}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="call:CallViewModel">
                        <callView:CallView />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>

        <Border
            x:Name="DialogOverlay"
            Background="#80000000"
            Classes="DialogOverlay"
            IsVisible="{Binding IsDialogVisible}"
            PointerPressed="OnDialogBackgroundPressed"
            ZIndex="10000" />

        <!--  Контейнер диалогов  -->
        <Border
            x:Name="DialogAnimWrapper"
            Margin="0,56,0,24"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="DialogAnimWrapper"
            IsVisible="{Binding IsDialogVisible}"
            ZIndex="10001">
            <ContentControl Content="{Binding CurrentDialog}">
                <ContentControl.DataTemplates>
                    <DataTemplate DataType="vmDialog:ServerUrlDialogViewModel">
                        <dialog:ServerUrlDialogView />
                    </DataTemplate>
                    <DataTemplate DataType="vmDialog:UserProfileDialogViewModel">
                        <views:UserProfileDialog />
                    </DataTemplate>
                    <DataTemplate DataType="vmDialog:SearchFiltersDialogViewModel">
                        <dialog:SearchFiltersDialog />
                    </DataTemplate>
                    <DataTemplate DataType="vmDialog:PollDialogViewModel">
                        <views:PollDialog />
                    </DataTemplate>
                    <DataTemplate DataType="vmDialog:ChatEditDialogViewModel">
                        <views:ChatEditDialog />
                    </DataTemplate>
                    <DataTemplate DataType="vmDialog:UserEditDialogViewModel">
                        <views:UserEditDialog />
                    </DataTemplate>
                    <DataTemplate DataType="vmDialog:DepartmentDialogViewModel">
                        <views:DepartmentDialog />
                    </DataTemplate>
                    <DataTemplate DataType="vmDialog:ConfirmDialogViewModel">
                        <dialogs:ConfirmDialog />
                    </DataTemplate>
                    <DataTemplate DataType="vmDialog:DepartmentHeadDialogViewModel">
                        <views:DepartmentHeadDialog />
                    </DataTemplate>
                    <DataTemplate DataType="vmDialog:UserPickerDialogViewModel">
                        <dialog:UserPickerDialog />
                    </DataTemplate>
                    <DataTemplate DataType="vmDialog:UserListDialogViewModel">
                        <dialog:UserListDialog />
                    </DataTemplate>
                    <DataTemplate DataType="vmDialog:ChatPickerDialogViewModel">
                        <dialog:ChatPickerDialog />
                    </DataTemplate>
                    <DataTemplate DataType="call:IncomingCallViewModel">
                        <callView:IncomingCallDialog />
                    </DataTemplate>
                    <DataTemplate DataType="vmChat:PollResultsDialogViewModel">
                        <dialog:PollResultsDialog />
                    </DataTemplate>
                </ContentControl.DataTemplates>
            </ContentControl>
        </Border>
    </Panel>
</Window>