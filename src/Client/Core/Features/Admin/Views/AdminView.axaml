<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:adminCon="using:Core.Features.Admin.Views.Controls"
             xmlns:controls="using:Core.Shared.Controls"
             xmlns:conv="using:Core.Shared.Converters"
             xmlns:local="using:Core.Features.Admin.Views"
             xmlns:skeleton="using:Core.Features.Admin.Views.Controls.Skeleton"
             xmlns:vm="using:Core.Features.Admin.ViewModels"
			 x:Class="Core.Features.Admin.Views.AdminView"
			 x:DataType="vm:AdminViewModel"
			 x:Name="Root"
			 Background="{DynamicResource PrimaryBG}"
			 Design.Width="1280" Design.Height="720">

	<UserControl.Styles>
		<Style Selector="ListBox.NavMenu">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Padding" Value="0"/>
		</Style>

		<Style Selector="ListBox.NavMenu ListBoxItem">
			<Setter Property="Padding" Value="10,11"/>
			<Setter Property="Margin" Value="0,1"/>
			<Setter Property="CornerRadius" Value="10"/>
			<Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
			<Setter Property="Transitions">
				<Transitions>
					<BrushTransition Property="Background" Duration="0:0:0.15"/>
				</Transitions>
			</Setter>
		</Style>

		<Style Selector="ListBox.NavMenu ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
		</Style>

		<Style Selector="ListBox.NavMenu ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
			<Setter Property="Background" Value="{DynamicResource AccentMuted}"/>
		</Style>

		<Style Selector="ListBox.NavMenu ListBoxItem:selected">
			<Setter Property="Foreground" Value="{DynamicResource Accent}"/>
		</Style>

		<Style Selector="ListBox.NavMenu ListBoxItem:selected PathIcon">
			<Setter Property="Foreground" Value="{DynamicResource Accent}"/>
		</Style>

		<Style Selector="ListBox.NavMenu ListBoxItem:selected TextBlock">
			<Setter Property="Foreground" Value="{DynamicResource Accent}"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
		</Style>
	</UserControl.Styles>

	<Border Classes="PageContainer">
		<Grid x:Name="MainGrid">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="240" MinWidth="52" MaxWidth="360"/>
				<ColumnDefinition Width="8"/>
				<ColumnDefinition MinWidth="400"/>
			</Grid.ColumnDefinitions>

			<Border Grid.Column="0"
					Grid.ColumnSpan="2"
					Background="{DynamicResource SecondaryBG}"
					BorderThickness="0,0,1,0"
					BorderBrush="{DynamicResource BorderDefault}">
				<DockPanel>

					<Border DockPanel.Dock="Top" Padding="16,20,16,16">
						<Panel>
							<StackPanel Spacing="2"
										IsVisible="{Binding !IsCompactMode, ElementName=Root}">
								<TextBlock Text="Администрирование"
										   FontSize="17"
										   FontWeight="Bold"
										   Foreground="{DynamicResource TextPrimary}"/>
								<TextBlock Text="Управление системой"
										   FontSize="11"
										   Foreground="{DynamicResource TextMuted}"/>
							</StackPanel>

							<Button Classes="IconButton"
									IsVisible="{Binding IsCompactMode, ElementName=Root}"
									Click="OnExpandButtonClick"
									ToolTip.Tip="Развернуть"
									HorizontalAlignment="Center">
								<PathIcon Data="{StaticResource MenuIcon}"
										  Width="18" Height="18"
										  Foreground="{DynamicResource Icon}"/>
							</Button>
						</Panel>
					</Border>

					<Border DockPanel.Dock="Top"
							Height="1"
							Background="{DynamicResource BorderDefault}"
							Margin="12,0,12,0"
							Opacity="0.5"/>

					<ScrollViewer DockPanel.Dock="Top" Margin="8,12,8,8">
						<StackPanel Spacing="4">
							<TextBlock Text="РАЗДЕЛЫ"
									   Classes="CategoryHeader"
									   Margin="10,0,0,6"
									   IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>

							<ListBox SelectedIndex="{Binding SelectedTabIndex}"
									 Classes="NavMenu">

								<ListBoxItem ToolTip.Tip="Сотрудники">
									<Grid ColumnDefinitions="Auto,*">
										<Border Grid.Column="0"
												Width="28" Height="28"
												CornerRadius="7"
												Background="{DynamicResource ThirdBG}"
												Margin="0,0,10,0">
											<PathIcon Data="{StaticResource PersonIcon}"
													  Width="14" Height="14"
													  Foreground="{DynamicResource Icon}"/>
										</Border>
										<TextBlock Grid.Column="1"
												   Text="Сотрудники"
												   FontSize="13"
												   VerticalAlignment="Center"
												   IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>
									</Grid>
								</ListBoxItem>

								<ListBoxItem ToolTip.Tip="Отделы">
									<Grid ColumnDefinitions="Auto,*">
										<Border Grid.Column="0"
												Width="28" Height="28"
												CornerRadius="7"
												Background="{DynamicResource ThirdBG}"
												Margin="0,0,10,0">
											<PathIcon Data="{StaticResource OrganizationIcon}"
													  Width="14" Height="14"
													  Foreground="{DynamicResource Icon}"/>
										</Border>
										<TextBlock Grid.Column="1"
												   Text="Отделы"
												   FontSize="13"
												   VerticalAlignment="Center"
												   IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>
									</Grid>
								</ListBoxItem>
							</ListBox>
						</StackPanel>
					</ScrollViewer>

				</DockPanel>
			</Border>

			<GridSplitter x:Name="GridSplitter"
						  Grid.Column="1"
						  ZIndex="10"
						  ResizeDirection="Columns"
						  ResizeBehavior="PreviousAndNext"
						  HorizontalAlignment="Stretch"
						  VerticalAlignment="Stretch"
						  Background="Transparent"
						  Cursor="SizeWestEast"/>

			<Border Grid.Column="2" Background="{DynamicResource PrimaryBG}">
				<DockPanel Margin="28,24,28,0">

					<Grid DockPanel.Dock="Top"
						  ColumnDefinitions="*,Auto"
						  Margin="0,0,0,20">
						<StackPanel Grid.Column="0" Spacing="3">
							<TextBlock FontSize="22"
									   FontWeight="Bold"
									   Foreground="{DynamicResource TextPrimary}"
									   Text="{Binding SelectedTabIndex,
									   Converter={conv:Converter Name=IndexToText},
									   ConverterParameter='Сотрудники|Отделы'}"/>
							<TextBlock FontSize="12"
									   Foreground="{DynamicResource TextMuted}"
									   Text="{Binding SelectedTabIndex,
									   Converter={conv:Converter Name=IndexToText},
									   ConverterParameter='Управление учётными записями|Структура отделов организации'}"/>
						</StackPanel>
					</Grid>

					<Border DockPanel.Dock="Top"
							Margin="0,0,0,16"
							Padding="12"
							CornerRadius="12"
							Background="{DynamicResource SecondaryBG}"
							BorderThickness="1"
							BorderBrush="{DynamicResource BorderDefault}">
						<Grid ColumnDefinitions="*,Auto,Auto">

							<controls:SearchBox x:Name="SearchTextBox"
												Grid.Column="0"
												SearchText="{Binding SearchQuery}"
												Watermark="Поиск..."/>

							<Button Grid.Column="1"
									Command="{Binding RefreshCommand}"
									Classes="IconButton"
									Margin="8,0,0,0"
									VerticalAlignment="Center"
									ToolTip.Tip="Обновить">
								<PathIcon Data="{StaticResource RefreshIcon}"
										  Width="15" Height="15"
										  Foreground="{DynamicResource Icon}"/>
							</Button>

							<Button Grid.Column="2"
									Classes="Primary"
									Command="{Binding CreateCommand}"
									Margin="8,0,0,0"
									VerticalAlignment="Center"
									ToolTip.Tip="{Binding SelectedTabIndex,
									Converter={conv:Converter Name=IndexToText},
									ConverterParameter='Добавить сотрудника|Создать отдел'}">
								<StackPanel Orientation="Horizontal" Spacing="6">
									<PathIcon Data="{StaticResource AddIcon}"
											  Width="13" Height="13"
											  Foreground="{DynamicResource TextOnAccent}"/>
									<TextBlock Foreground="{DynamicResource TextOnAccent}"
											   FontWeight="SemiBold"
											   FontSize="13"
											   Text="{Binding SelectedTabIndex,
											   Converter={conv:Converter Name=IndexToText},
											   ConverterParameter='Добавить|Создать'}"
											   IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>
								</StackPanel>
							</Button>
						</Grid>
					</Border>

					<Panel>
						<Border IsVisible="{Binding IsBusy}"
								Background="{DynamicResource PrimaryBG}"
								ZIndex="10"
								CornerRadius="14,14,0,0">
							<Grid>
								<skeleton:AdminUsersSkeleton IsVisible="{Binding SelectedTabIndex,
								Converter={conv:Converter Name=Equals},
								ConverterParameter=0}"/>
								<skeleton:AdminDepartmentsSkeleton IsVisible="{Binding SelectedTabIndex, Converter={conv:Converter Name=Equals},
								ConverterParameter=1}"/>
							</Grid>
						</Border>

						<TransitioningContentControl Content="{Binding CurrentTab}"
													 IsVisible="{Binding IsBusy, Converter={x:Static BoolConverters.Not}}"
													 HorizontalContentAlignment="Stretch"
													 VerticalContentAlignment="Stretch">
							<TransitioningContentControl.PageTransition>
								<CrossFade Duration="0:0:0.18"/>
							</TransitioningContentControl.PageTransition>

							<TransitioningContentControl.DataTemplates>

								<DataTemplate DataType="vm:UsersTabViewModel">
									<Border Background="{DynamicResource SecondaryBG}"
											BorderThickness="1,1,1,0"
											BorderBrush="{DynamicResource BorderDefault}"
											CornerRadius="14,14,0,0">
										<Panel>
											<ListBox ItemsSource="{Binding $parent[local:AdminView].DataContext.FilteredGroupedUsers}"
													 IsVisible="{Binding $parent[local:AdminView].DataContext.HasUsers, FallbackValue=False}"
													 Margin="12,12,12,24"
													 Background="Transparent"
													 BorderThickness="0"
													 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
												<ListBox.Styles>
													<Style Selector="ListBoxItem">
														<Setter Property="Padding" Value="0,0,0,12"/>
														<Setter Property="Background" Value="Transparent"/>
													</Style>
													<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
														<Setter Property="Background" Value="Transparent"/>
													</Style>
													<Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
														<Setter Property="Background" Value="Transparent"/>
													</Style>
												</ListBox.Styles>
												<ListBox.ItemTemplate>
													<DataTemplate DataType="vm:DepartmentGroup">
														<adminCon:DepartmentGroupView
														EditUserCommand="{Binding $parent[local:AdminView].DataContext.OpenEditUserDialogCommand}"
														BanUserCommand="{Binding $parent[local:AdminView].DataContext.ToggleBanCommand}"/>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>

											<StackPanel VerticalAlignment="Center"
														HorizontalAlignment="Center"
														Spacing="12" Margin="24">
												<StackPanel.IsVisible>
													<MultiBinding Converter="{conv:MultiConverter Name=BooleanAnd}">
														<Binding Path="$parent[local:AdminView].DataContext.HasUsers" Converter="{x:Static BoolConverters.Not}"/>
														<Binding Path="$parent[local:AdminView].DataContext.IsBusy" Converter="{x:Static BoolConverters.Not}"/>
														<Binding Path="$parent[local:AdminView].DataContext.SearchQuery" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
													</MultiBinding>
												</StackPanel.IsVisible>
												<Border Width="64" Height="64" CornerRadius="20"
														HorizontalAlignment="Center"
														Background="{DynamicResource ThirdBG}">
													<PathIcon Data="{StaticResource SearchIcon}"
															  Width="28" Height="28"
															  Foreground="{DynamicResource TextMuted}"
															  Opacity="0.5"/>
												</Border>
												<TextBlock Text="Ничего не найдено"
														   FontSize="16" FontWeight="SemiBold"
														   Foreground="{DynamicResource TextSecondary}"
														   HorizontalAlignment="Center"/>
												<TextBlock FontSize="13"
														   Foreground="{DynamicResource TextMuted}"
														   HorizontalAlignment="Center"
														   TextAlignment="Center"
														   TextWrapping="Wrap" MaxWidth="260">
													<Run Text="По запросу «"/>
													<Run Text="{Binding $parent[local:AdminView].DataContext.SearchQuery}"
														 FontWeight="Medium"
														 Foreground="{DynamicResource TextPrimary}"/>
													<Run Text="» сотрудников не найдено"/>
												</TextBlock>
											</StackPanel>
										</Panel>
									</Border>
								</DataTemplate>

								<DataTemplate DataType="vm:DepartmentsTabViewModel">
									<Border Background="{DynamicResource SecondaryBG}"
											BorderThickness="1,1,1,0"
											BorderBrush="{DynamicResource BorderDefault}"
											CornerRadius="14,14,0,0">
										<Panel>
											<ListBox ItemsSource="{Binding $parent[local:AdminView].DataContext.FilteredHierarchicalDepartments}"
													 IsVisible="{Binding $parent[local:AdminView].DataContext.HasDepartments, FallbackValue=False}"
													 Margin="12,12,12,24"
													 Background="Transparent"
													 BorderThickness="0"
													 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
												<ListBox.Styles>
													<Style Selector="ListBoxItem">
														<Setter Property="Padding" Value="0,0,0,6"/>
														<Setter Property="Background" Value="Transparent"/>
													</Style>
													<Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
														<Setter Property="Background" Value="Transparent"/>
													</Style>
													<Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
														<Setter Property="Background" Value="Transparent"/>
													</Style>
												</ListBox.Styles>
												<ListBox.ItemTemplate>
													<DataTemplate DataType="vm:HierarchicalDepartmentViewModel">
														<adminCon:DepartmentCardView
														EditCommand="{Binding $parent[local:AdminView].DataContext.OpenEditDepartmentCommand}"/>
													</DataTemplate>
												</ListBox.ItemTemplate>
											</ListBox>

											<StackPanel VerticalAlignment="Center"
														HorizontalAlignment="Center"
														Spacing="12" Margin="24">
												<StackPanel.IsVisible>
													<MultiBinding Converter="{conv:MultiConverter Name=BooleanAnd}">
														<Binding Path="$parent[local:AdminView].DataContext.HasDepartments" Converter="{x:Static BoolConverters.Not}"/>
														<Binding Path="$parent[local:AdminView].DataContext.IsBusy" Converter="{x:Static BoolConverters.Not}"/>
														<Binding Path="$parent[local:AdminView].DataContext.SearchQuery" Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
													</MultiBinding>
												</StackPanel.IsVisible>
												<Border Width="64" Height="64" CornerRadius="20"
														HorizontalAlignment="Center"
														Background="{DynamicResource ThirdBG}">
													<PathIcon Data="{StaticResource SearchIcon}"
															  Width="28" Height="28"
															  Foreground="{DynamicResource TextMuted}"
															  Opacity="0.5"/>
												</Border>
												<TextBlock Text="Ничего не найдено"
														   FontSize="16" FontWeight="SemiBold"
														   Foreground="{DynamicResource TextSecondary}"
														   HorizontalAlignment="Center"/>
												<TextBlock FontSize="13"
														   Foreground="{DynamicResource TextMuted}"
														   HorizontalAlignment="Center"
														   TextAlignment="Center"
														   TextWrapping="Wrap" MaxWidth="260">
													<Run Text="Отдел «"/>
													<Run Text="{Binding $parent[local:AdminView].DataContext.SearchQuery}"
														 FontWeight="Medium"
														 Foreground="{DynamicResource TextPrimary}"/>
													<Run Text="» не найден"/>
												</TextBlock>
											</StackPanel>
										</Panel>
									</Border>
								</DataTemplate>

							</TransitioningContentControl.DataTemplates>
						</TransitioningContentControl>
					</Panel>
				</DockPanel>
			</Border>
		</Grid>
	</Border>
</UserControl>