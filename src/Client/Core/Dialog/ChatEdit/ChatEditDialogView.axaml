<UserControl
    x:Class="Core.Dialog.ChatEdit.ChatEditDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Core.Shared.Controls"
    xmlns:conv="using:Core.Shared.Converters"
    xmlns:vm="using:Core.Dialog.ChatEdit"
    x:Name="Root"
    x:DataType="vm:ChatEditDialogViewModel">

    <Border
        x:Name="DialogContainer"
        Background="{DynamicResource SecondaryBG}"
        Classes="DialogContainer">
        <Grid x:Name="RootGrid" RowDefinitions="Auto,Auto,*,Auto,Auto">

            <Grid
                x:Name="CompactHeader"
                Grid.Row="0"
                Height="52"
                IsVisible="False"
                ColumnDefinitions="Auto,*,Auto">
                <Button
                    Grid.Column="0"
                    Width="44"
                    Height="44"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Classes="IconButton"
                    Click="OnBackButtonClick"
                    ToolTip.Tip="Закрыть">
                    <Path
                        Width="18"
                        Height="18"
                        Data="{StaticResource ChevronLeftIcon}"
                        Fill="{DynamicResource TextPrimary}"
                        Stretch="Uniform" />
                </Button>
                <TextBlock
                    Grid.Column="1"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="{Binding Title}"
                    TextTrimming="CharacterEllipsis" />
                <Panel Grid.Column="2" Width="44" />
            </Grid>

            <Grid
                x:Name="NormalHeader"
                Grid.Row="0"
                Margin="24,24,24,16"
                ColumnDefinitions="Auto,*,Auto">

                <Panel
                    Grid.Column="0"
                    Width="80"
                    Height="80"
                    Margin="0,0,16,0"
                    Classes="AvatarEditContainer">
                    <controls:AvatarControl
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="XLarge"
                        FallbackIcon="{StaticResource GroupIcon}"
                        ImageBitmap="{Binding AvatarPreView}"
                        PlaceholderBackground="{DynamicResource SurfaceVariant}"
                        PlaceholderForeground="White"
                        ShowOnlineIndicator="False" />
                    <Button
                        Width="80"
                        Height="80"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Classes="AvatarEditOverlay"
                        Command="{Binding SelectAvatarCommand}"
                        CornerRadius="40"
                        ToolTip.Tip="Изменить аватар">
                        <Border
                            Width="80"
                            Height="80"
                            Background="#66000000"
                            Classes="AvatarOverlay"
                            CornerRadius="40">
                            <PathIcon
                                Width="22"
                                Height="22"
                                Data="{StaticResource CameraIcon}"
                                Foreground="White" />
                        </Border>
                    </Button>
                    <Button
                        Width="22"
                        Height="22"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Classes="AvatarDeleteBadge"
                        Command="{Binding ClearAvatarCommand}"
                        CornerRadius="11"
                        IsVisible="{Binding AvatarPreView, Converter={x:Static ObjectConverters.IsNotNull}}"
                        ToolTip.Tip="Удалить аватар">
                        <Path
                            Width="8"
                            Height="8"
                            Data="{StaticResource CloseIcon}"
                            Fill="White"
                            Stretch="Uniform" />
                    </Button>
                </Panel>

                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="8">
                    <TextBlock
                        FontSize="18"
                        FontWeight="Bold"
                        Text="{Binding Title}" />
                    <StackPanel Spacing="4">
                        <TextBlock
                            FontSize="12"
                            FontWeight="DemiBold"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="Название группы" />
                        <TextBox
                            Classes="Input"
                            IsEnabled="{Binding CanEditChatSettings}"
                            MaxLength="100"
                            PlaceholderText="Введите название..."
                            Text="{Binding Name}" />
                    </StackPanel>
                </StackPanel>

                <Button
                    Grid.Column="2"
                    Classes="IconButton"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    Click="OnBackButtonClick"
                    ToolTip.Tip="Закрыть">
                    <PathIcon
                        Width="14"
                        Height="14"
                        Data="{StaticResource CloseIcon}"
                        Foreground="{DynamicResource TextSecondary}" />
                </Button>
            </Grid>

            <Border Grid.Row="1" Classes="DialogDivider" />

            <ScrollViewer
                Grid.Row="2"
                Classes="ThinScrollbar"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">

                    <Border
                        x:Name="CompactAvatarSection"
                        Padding="16,16,16,4"
                        IsVisible="False">
                        <Grid ColumnDefinitions="Auto,*">
                            <Panel
                                Grid.Column="0"
                                Width="56"
                                Height="56"
                                Margin="0,0,16,0"
                                Classes="AvatarEditContainer">
                                <controls:AvatarControl
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Classes="Large"
                                    FallbackIcon="{StaticResource GroupIcon}"
                                    ImageBitmap="{Binding AvatarPreView}"
                                    PlaceholderBackground="{DynamicResource SurfaceVariant}"
                                    PlaceholderForeground="White"
                                    ShowOnlineIndicator="False" />
                                <Button
                                    Width="56"
                                    Height="56"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Classes="AvatarEditOverlay"
                                    Command="{Binding SelectAvatarCommand}"
                                    CornerRadius="28"
                                    ToolTip.Tip="Изменить аватар">
                                    <Border
                                        Width="56"
                                        Height="56"
                                        Background="#66000000"
                                        Classes="AvatarOverlay"
                                        CornerRadius="28">
                                        <PathIcon
                                            Width="18"
                                            Height="18"
                                            Data="{StaticResource CameraIcon}"
                                            Foreground="White" />
                                    </Border>
                                </Button>
                                <Button
                                    Width="22"
                                    Height="22"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Classes="AvatarDeleteBadge"
                                    Command="{Binding ClearAvatarCommand}"
                                    CornerRadius="11"
                                    IsVisible="{Binding AvatarPreView, Converter={x:Static ObjectConverters.IsNotNull}}"
                                    ToolTip.Tip="Удалить аватар">
                                    <Path
                                        Width="8"
                                        Height="8"
                                        Data="{StaticResource CloseIcon}"
                                        Fill="White"
                                        Stretch="Uniform" />
                                </Button>
                            </Panel>
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="4">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="DemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="Название группы" />
                                <TextBox
                                    Classes="Input"
                                    IsEnabled="{Binding CanEditChatSettings}"
                                    MaxLength="100"
                                    PlaceholderText="Введите название..."
                                    Text="{Binding Name}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="24,12,24,12" Spacing="12">

                        <TextBlock
                            Margin="0"
                            Classes="CategoryHeader"
                            Text="УПРАВЛЕНИЕ" />

                        <Border Padding="4" Classes="Section">
                            <StackPanel Spacing="0">
                                <Button
                                    Padding="12,10"
                                    Classes="MemberItem"
                                    Command="{Binding ManageParticipantsCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <PathIcon
                                            Width="20"
                                            Height="20"
                                            Data="{StaticResource GroupIcon}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="Участники" />
                                        <Border
                                            Grid.Column="2"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Classes="CountBadge">
                                            <TextBlock Text="{Binding ParticipantsCount}" />
                                        </Border>
                                        <Path
                                            Grid.Column="3"
                                            Width="12"
                                            Height="12"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource ChevronRightIcon}"
                                            Fill="{DynamicResource TextMuted}"
                                            Stretch="Uniform" />
                                    </Grid>
                                </Button>

                                <Border
                                    Height="1"
                                    Margin="40,0,12,0"
                                    Background="{DynamicResource BorderDefault}" />

                                <Button
                                    Padding="12,10"
                                    Classes="MemberItem"
                                    Command="{Binding ManageAdminsCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <PathIcon
                                            Width="20"
                                            Height="20"
                                            Data="{StaticResource ShieldIcon}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Text="Администраторы" />
                                        <Border
                                            Grid.Column="2"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Center"
                                            Classes="CountBadge">
                                            <TextBlock Text="{Binding AdminsCount}" />
                                        </Border>
                                        <Path
                                            Grid.Column="3"
                                            Width="12"
                                            Height="12"
                                            VerticalAlignment="Center"
                                            Data="{StaticResource ChevronRightIcon}"
                                            Fill="{DynamicResource TextMuted}"
                                            Stretch="Uniform" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border
                            Padding="12,8"
                            Background="{DynamicResource ThirdBG}"
                            BorderBrush="{DynamicResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon
                                    Width="16"
                                    Height="16"
                                    Data="{StaticResource UserRoleIcon}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="Ваша роль" />
                                <Border
                                    Grid.Column="2"
                                    Padding="10,3"
                                    Background="{DynamicResource AccentMuted}"
                                    CornerRadius="6">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource Accent}"
                                        Text="{Binding CurrentUserRoleDisplay}" />
                                </Border>
                            </Grid>
                        </Border>

                        <StackPanel IsVisible="{Binding ShowDeleteGroupOption}" Spacing="12">
                            <TextBlock
                                Margin="0,8,0,0"
                                Classes="CategoryHeader"
                                Text="НАСТРОЙКИ" />
                            <Border Padding="4" Classes="Section">
                                <Border Padding="12,10" CornerRadius="8">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <PathIcon
                                            Width="20"
                                            Height="20"
                                            Data="{StaticResource HistoryIcon}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="12,0,12,0"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <TextBlock
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Text="История для новых участников" />
                                        </StackPanel>
                                        <ToggleSwitch
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding ShowHistoryForNewMembers}"
                                            IsEnabled="{Binding CanManageParticipants}"
                                            OffContent=""
                                            OnContent="" />
                                    </Grid>
                                </Border>
                            </Border>
                        </StackPanel>

                        <Border
                            Padding="4"
                            Background="{DynamicResource ThirdBG}"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            IsVisible="{Binding ShowDeleteGroupOption}">
                            <Button
                                Padding="12,10"
                                Classes="MemberItem"
                                Command="{Binding DeleteGroupCommand}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon
                                        Width="20"
                                        Height="20"
                                        Data="{StaticResource DeleteIcon}"
                                        Foreground="{DynamicResource DangerBrush}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource DangerBrush}"
                                            Text="Удалить группу" />
                                    </StackPanel>
                                    <Path
                                        Grid.Column="2"
                                        Width="12"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Data="{StaticResource ChevronRightIcon}"
                                        Fill="{DynamicResource DangerBrush}"
                                        Opacity="0.6"
                                        Stretch="Uniform" />
                                </Grid>
                            </Button>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3" Classes="DialogDivider" />

            <Grid
                Grid.Row="4"
                Margin="24,16,24,24"
                ColumnDefinitions="*,Auto,Auto">

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock
                        Foreground="{DynamicResource ErrorColor}"
                        IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Text="{Binding ErrorMessage}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{DynamicResource SuccessColor}"
                        IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                        Text="{Binding SuccessMessage}"
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    MinWidth="100"
                    Margin="0,0,12,0"
                    Classes="DialogOutline"
                    Command="{Binding CancelCommand}"
                    Content="Отмена" />

                <Button
                    Grid.Column="2"
                    MinWidth="100"
                    Classes="DialogAccent"
                    Command="{Binding SaveCommand}"
                    Content="{Binding IsNewChat, Converter={conv:Converter Name=BoolToString}, ConverterParameter='Создать|Сохранить'}"
                    IsEnabled="{Binding CanSave}" />
            </Grid>

        </Grid>
    </Border>
</UserControl>