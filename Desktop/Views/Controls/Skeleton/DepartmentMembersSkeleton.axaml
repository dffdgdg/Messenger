<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Desktop.Views.Controls.Skeleton.DepartmentMembersSkeleton">
    <ScrollViewer Classes="ThinScrollbar" Padding="24">
        <StackPanel Spacing="24" MaxWidth="1000" HorizontalAlignment="Stretch">
            <Border Classes="Section" MaxWidth="800" HorizontalAlignment="Stretch">
                <StackPanel Spacing="20">

                    <!-- Заголовок секции -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Classes="Skeleton" Width="18" Height="18" CornerRadius="4"/>
                            <Border Classes="Skeleton" Width="140" Height="20" CornerRadius="6"/>
                            <Border Classes="Skeleton" Width="32" Height="18" CornerRadius="5"/>
                        </StackPanel>
                        <Border Grid.Column="1"
                                Classes="Skeleton"
                                Width="250" Height="40"
                                CornerRadius="8"/>
                    </Grid>

                    <!-- Карточки сотрудников -->
                    <StackPanel Spacing="8">

                        <!-- 1 -->
                        <Border Background="{DynamicResource ItemBgBrush}"
                                CornerRadius="10" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                                <Border Classes="Skeleton" Width="44" Height="44" CornerRadius="22"/>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="180" Height="16" CornerRadius="5"/>
                                    <Border Classes="Skeleton" Width="120" Height="12" CornerRadius="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="8" Height="8" CornerRadius="4"/>
                                    <Border Classes="Skeleton" Width="60" Height="12" CornerRadius="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="32" Height="32" CornerRadius="6"/>
                                    <Border Classes="Skeleton" Width="32" Height="32" CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 2 -->
                        <Border Background="{DynamicResource ItemBgBrush}"
                                CornerRadius="10" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                                <Border Classes="Skeleton" Width="44" Height="44" CornerRadius="22"/>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="150" Height="16" CornerRadius="5"/>
                                    <Border Classes="Skeleton" Width="100" Height="12" CornerRadius="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="8" Height="8" CornerRadius="4"/>
                                    <Border Classes="Skeleton" Width="50" Height="12" CornerRadius="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="32" Height="32" CornerRadius="6"/>
                                    <Border Classes="Skeleton" Width="32" Height="32" CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 3 -->
                        <Border Background="{DynamicResource ItemBgBrush}"
                                CornerRadius="10" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                                <Border Classes="Skeleton" Width="44" Height="44" CornerRadius="22"/>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="200" Height="16" CornerRadius="5"/>
                                    <Border Classes="Skeleton" Width="130" Height="12" CornerRadius="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="8" Height="8" CornerRadius="4"/>
                                    <Border Classes="Skeleton" Width="65" Height="12" CornerRadius="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="32" Height="32" CornerRadius="6"/>
                                    <Border Classes="Skeleton" Width="32" Height="32" CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 4 -->
                        <Border Background="{DynamicResource ItemBgBrush}"
                                CornerRadius="10" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                                <Border Classes="Skeleton" Width="44" Height="44" CornerRadius="22"/>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="160" Height="16" CornerRadius="5"/>
                                    <Border Classes="Skeleton" Width="110" Height="12" CornerRadius="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="8" Height="8" CornerRadius="4"/>
                                    <Border Classes="Skeleton" Width="55" Height="12" CornerRadius="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="32" Height="32" CornerRadius="6"/>
                                    <Border Classes="Skeleton" Width="32" Height="32" CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 5 -->
                        <Border Background="{DynamicResource ItemBgBrush}"
                                CornerRadius="10" Padding="16,12">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                                <Border Classes="Skeleton" Width="44" Height="44" CornerRadius="22"/>
                                <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="140" Height="16" CornerRadius="5"/>
                                    <Border Classes="Skeleton" Width="95" Height="12" CornerRadius="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="8" Height="8" CornerRadius="4"/>
                                    <Border Classes="Skeleton" Width="45" Height="12" CornerRadius="4"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Classes="Skeleton" Width="32" Height="32" CornerRadius="6"/>
                                    <Border Classes="Skeleton" Width="32" Height="32" CornerRadius="6"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>