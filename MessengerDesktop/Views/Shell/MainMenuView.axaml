<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:conv="using:MessengerDesktop.Converters"
             xmlns:controls="using:MessengerDesktop.Views.Controls"
             xmlns:chat="using:MessengerDesktop.ViewModels.Chat"
             xmlns:chatItem="using:MessengerDesktop.ViewModels.Chats"
             x:Class="MessengerDesktop.Views.MainMenuView"
             x:Name="Root"
             x:DataType="vm:MainMenuViewModel"
             xmlns:vm="using:MessengerDesktop.ViewModels"
             Background="{DynamicResource PrimaryBG}">

    <UserControl.Resources>
        <sys:Int32 x:Key="Index0">0</sys:Int32>
        <sys:Int32 x:Key="Index1">1</sys:Int32>
        <sys:Int32 x:Key="Index2">2</sys:Int32>
        <sys:Int32 x:Key="Index3">3</sys:Int32>
        <sys:Int32 x:Key="Index4">4</sys:Int32>
        <sys:Int32 x:Key="Index5">5</sys:Int32>
        <sys:Int32 x:Key="Index6">6</sys:Int32>
    </UserControl.Resources>

    <UserControl.Styles>
        <Style Selector="Button.SearchResultItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusAdorner" Value="{x:Null}"/>
        </Style>
        <Style Selector="Button.SearchResultItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.SearchResultItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderHover}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="TextBlock.SearchGroupLabel">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="Margin" Value="8,6,8,2"/>
        </Style>
    </UserControl.Styles>

    <Panel>
        <Grid ColumnDefinitions="82,*">

            <!-- Боковая навигация -->
            <DockPanel Grid.Column="0"
                       LastChildFill="False"
                       Margin="5,0,5,0">

                <StackPanel DockPanel.Dock="Top"
                            Spacing="2"
                            Margin="0,5,0,10"
                            HorizontalAlignment="Center">

                    <RadioButton Classes="NavButton" GroupName="MainNav"
                                 Tag="{DynamicResource ChatsIcon}"
                                 Content="Чаты" ToolTip.Tip="Чаты"
                                 IsChecked="{Binding SelectedMenuIndex, Mode=OneWay,
                                     Converter={conv:Converter Name=Equality},
                                     ConverterParameter=1}"
                                 Command="{Binding SetItemCommand}"
                                 CommandParameter="{StaticResource Index1}"/>

                    <RadioButton Classes="NavButton" GroupName="MainNav"
                                 Tag="{DynamicResource ContactsIcon}"
                                 Content="Контакты" ToolTip.Tip="Контакты"
                                 IsChecked="{Binding SelectedMenuIndex, Mode=OneWay,
                                     Converter={conv:Converter Name=Equality},
                                     ConverterParameter=5}"
                                 Command="{Binding SetItemCommand}"
                                 CommandParameter="{StaticResource Index5}"/>

                    <RadioButton Classes="NavButton" GroupName="MainNav"
                                 Tag="{DynamicResource OrganizationIcon}"
                                 Content="Отдел" ToolTip.Tip="Управление отделом"
                                 IsChecked="{Binding SelectedMenuIndex, Mode=OneWay,
                                     Converter={conv:Converter Name=Equality},
                                     ConverterParameter=6}"
                                 Command="{Binding SetItemCommand}"
                                 CommandParameter="{StaticResource Index6}"
                                 IsVisible="{Binding .,
                                     Converter={conv:Converter Name=HasRole},
                                     ConverterParameter=Admin}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom"
                            Spacing="2"
                            Margin="0,0,0,10"
                            HorizontalAlignment="Center">

                    <RadioButton Classes="NavButton" GroupName="MainNav"
                                 Tag="{DynamicResource ProfileIcon}"
                                 Content="Профиль" ToolTip.Tip="Мой профиль"
                                 IsChecked="{Binding SelectedMenuIndex, Mode=OneWay,
                                     Converter={conv:Converter Name=Equality},
                                     ConverterParameter=3}"
                                 Command="{Binding SetItemCommand}"
                                 CommandParameter="{StaticResource Index3}"/>

                    <RadioButton Classes="NavButton" GroupName="MainNav"
                                 Tag="{DynamicResource SettingsIcon}"
                                 Content="Настройки" ToolTip.Tip="Настройки приложения"
                                 IsChecked="{Binding SelectedMenuIndex, Mode=OneWay,
                                     Converter={conv:Converter Name=Equality},
                                     ConverterParameter=0}"
                                 Command="{Binding SetItemCommand}"
                                 CommandParameter="{StaticResource Index0}"/>

                    <RadioButton Classes="NavButton" GroupName="MainNav"
                                 Tag="{DynamicResource AdminIcon}"
                                 Content="Админ" ToolTip.Tip="Панель администратора"
                                 IsChecked="{Binding SelectedMenuIndex, Mode=OneWay,
                                     Converter={conv:Converter Name=Equality},
                                     ConverterParameter=4}"
                                 Command="{Binding SetItemCommand}"
                                 CommandParameter="{StaticResource Index4}"
                                 IsVisible="{Binding .,
                                     Converter={conv:Converter Name=HasRole},
                                     ConverterParameter=Admin}"/>
                </StackPanel>
            </DockPanel>

            <!-- Контентная область -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SecondaryBG}"
                    Margin="0,8,9,9"
                    CornerRadius="8">
                <ContentControl Content="{Binding CurrentMenuViewModel}"/>
            </Border>
        </Grid>

        <Border x:Name="SearchPopup"
                ZIndex="500"
                IsVisible="{Binding SearchManager.IsSearchMode}"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Background="{DynamicResource SecondaryBG}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="10"
                Width="460"
                MaxHeight="540"
                Padding="6">

            <StackPanel>

                <!-- Тулбар: скоупы + фильтры -->
                <Grid ColumnDefinitions="*,Auto"
                      Margin="4,4,4,6">

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">

                        <ToggleButton Classes="SwitchSmall"
                                      IsChecked="{Binding SearchManager.IsAllScope}"
                                      Command="{Binding SetSearchScopeCommand}"
                                      CommandParameter="{x:Static chat:SearchScopeMode.All}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource SearchIcon}" Width="11" Height="11"/>
                                <TextBlock Text="Все"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton Classes="SwitchSmall"
                                      IsChecked="{Binding SearchManager.IsChatsScope}"
                                      Command="{Binding SetSearchScopeCommand}"
                                      CommandParameter="{x:Static chat:SearchScopeMode.Chats}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource ChatsIcon}" Width="11" Height="11"/>
                                <TextBlock Text="Чаты"/>
                            </StackPanel>
                        </ToggleButton>

                        <ToggleButton Classes="SwitchSmall"
                                      IsChecked="{Binding SearchManager.IsContactsScope}"
                                      Command="{Binding SetSearchScopeCommand}"
                                      CommandParameter="{x:Static chat:SearchScopeMode.Contacts}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <PathIcon Data="{StaticResource ContactsIcon}" Width="11" Height="11"/>
                                <TextBlock Text="Контакты"/>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Кнопка фильтров -->
                    <Button Grid.Column="1"
                            Classes="IconButton Small"
                            Command="{Binding OpenSearchFiltersCommand}"
                            ToolTip.Tip="Фильтры"
                            VerticalAlignment="Center">
                        <Panel>
                            <PathIcon Data="{StaticResource FilterIcon}"
                                      Width="13" Height="13"
                                      Foreground="{DynamicResource Icon}"/>
                            <Ellipse Width="6" Height="6"
                                     Fill="{DynamicResource Accent}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Top"
                                     Margin="0,-2,-2,0"
                                     IsVisible="{Binding SearchManager.HasActiveFilters}"/>
                        </Panel>
                    </Button>
                </Grid>

                <!-- Разделитель -->
                <Border Height="1"
                        Background="{DynamicResource BorderDefault}"
                        Margin="4,0,4,6"/>

                <!-- Индикатор загрузки -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Spacing="8"
                            Margin="0,4,0,8"
                            IsVisible="{Binding SearchManager.IsSearching}">
                    <PathIcon Data="{StaticResource SearchIcon}"
                              Width="14" Height="14"
                              Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Text="Поиск..."
                               Classes="SearchGroupLabel"
                               Margin="0"/>
                </StackPanel>

                <!-- Результаты -->
                <ScrollViewer MaxHeight="380"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Classes="ThinScrollbar">
                    <StackPanel Spacing="2">

                        <!-- ── Чаты ── -->
                        <StackPanel IsVisible="{Binding SearchManager.HasChatResults}">
                            <TextBlock Text="ЧАТЫ" Classes="SearchGroupLabel"/>

                            <ItemsControl ItemsSource="{Binding SearchManager.ChatResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="chatItem:ChatListItemViewModel">
                                        <Button Classes="SearchResultItem"
                                                Command="{Binding $parent[UserControl].((vm:MainMenuViewModel)DataContext).OpenSearchedChatCommand}"
                                                CommandParameter="{Binding}">

                                            <Grid ColumnDefinitions="Auto,*"
                                                  Margin="2,2">
                                                <controls:AvatarControl
                                                    Grid.Column="0"
                                                    Classes="Small"
                                                    Source="{Binding Avatar}"
                                                    DisplayName="{Binding Name}"
                                                    FallbackIcon="{StaticResource GroupIcon}"
                                                    ShowOnlineIndicator="False"
                                                    VerticalAlignment="Center"/>

                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0,0,0"
                                                            VerticalAlignment="Center"
                                                            Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding LastMessagePreview}"
                                                               Foreground="{DynamicResource TextMuted}"
                                                               FontSize="12"
                                                               MaxLines="1"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding LastMessagePreview,
                                                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Разделитель между секциями -->
                        <Border Height="1"
                                Background="{DynamicResource BorderDefault}"
                                Margin="8,4">
                            <Border.IsVisible>
                                <MultiBinding Converter="{conv:MultiConverter Name=BooleanAnd}">
                                    <Binding Path="SearchManager.HasChatResults"/>
                                    <Binding Path="SearchManager.HasMessageResults"/>
                                </MultiBinding>
                            </Border.IsVisible>
                        </Border>

                        <!-- ── Сообщения ── -->
                        <StackPanel IsVisible="{Binding SearchManager.HasMessageResults}">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,4,0">
                                <TextBlock Grid.Column="0"
                                           Text="СООБЩЕНИЯ"
                                           Classes="SearchGroupLabel"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding SearchManager.TotalMessagesText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="0,6,0,2"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding SearchManager.MessageResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="chat:SearchMessageResultViewModel">
                                        <Button Classes="SearchResultItem"
                                                Command="{Binding $parent[UserControl].((vm:MainMenuViewModel)DataContext).OpenSearchResultCommand}"
                                                CommandParameter="{Binding Source}">

                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  Margin="2,2">

                                                <!-- Аватар чата -->
                                                <controls:AvatarControl
                                                    Grid.Column="0"
                                                    Classes="Small"
                                                    Source="{Binding ChatAvatar}"
                                                    DisplayName="{Binding ChatName}"
                                                    FallbackIcon="{StaticResource GroupIcon}"
                                                    ShowOnlineIndicator="False"
                                                    VerticalAlignment="Center"/>

                                                <!-- Тело результата -->
                                                <StackPanel Grid.Column="1"
                                                            Margin="10,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Spacing="3">

                                                    <!-- Чат · Отправитель -->
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="4">
                                                        <TextBlock Text="{Binding ChatName}"
                                                                   FontWeight="SemiBold"
                                                                   FontSize="13"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="·"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   FontSize="13"
                                                                   IsVisible="{Binding SenderName,
                                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="{Binding SenderName}"
                                                                   Foreground="{DynamicResource Accent}"
                                                                   FontSize="13"
                                                                   MaxLines="1"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   IsVisible="{Binding SenderName,
                                                                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                    </StackPanel>

                                                    <!-- Превью сообщения -->
                                                    <TextBlock Text="{Binding Preview}"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               FontSize="12"
                                                               MaxLines="2"
                                                               TextTrimming="CharacterEllipsis"
                                                               IsVisible="{Binding Preview,
                                                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                </StackPanel>

                                                <!-- Дата -->
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding CreatedAt,
                                                               Converter={conv:Converter Name=MessageTime}}"
                                                           Foreground="{DynamicResource TextMuted}"
                                                           FontSize="11"
                                                           VerticalAlignment="Top"
                                                           Margin="0,2,0,0"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- ── Пустые состояния ── -->
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,20"
                                    Spacing="10">
                            <StackPanel.IsVisible>
                                <MultiBinding Converter="{conv:MultiConverter Name=BooleanAnd}">
                                    <Binding Path="!SearchManager.IsSearching"/>
                                    <Binding Path="!SearchManager.HasResults"/>
                                    <Binding Path="SearchManager.IsSearchMode"/>
                                </MultiBinding>
                            </StackPanel.IsVisible>

                            <PathIcon Data="{StaticResource SearchIcon}"
                                      Width="32" Height="32"
                                      Foreground="{DynamicResource TextMuted}"
                                      Opacity="0.4"
                                      HorizontalAlignment="Center"/>

                            <!-- Нет запроса -->
                            <TextBlock HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"
                                       FontSize="13"
                                       IsVisible="{Binding SearchManager.SearchQuery,
                                           Converter={x:Static StringConverters.IsNullOrEmpty}}">
                                Введите запрос для поиска
                            </TextBlock>

                            <!-- Нет результатов -->
                            <StackPanel HorizontalAlignment="Center"
                                        Spacing="4"
                                        IsVisible="{Binding SearchManager.SearchQuery,
                                            Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="Ничего не найдено"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="13"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Попробуйте изменить запрос или фильтры"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontSize="11"
                                           Opacity="0.7"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Кнопка "Показать ещё" -->
                        <Button Classes="DialogOutline"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,4"
                                Padding="16,8"
                                IsVisible="{Binding SearchManager.HasMoreMessages}"
                                Command="{Binding LoadMoreSearchResultsCommand}">
                            Показать ещё результаты
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

    </Panel>
</UserControl>