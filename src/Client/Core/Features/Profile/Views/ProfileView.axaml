<UserControl x:Class="Core.Features.Profile.Views.ProfileView"
             x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Core.Shared.Controls"
             xmlns:conv="using:Core.Shared.Converters"
             xmlns:vm="using:Core.Features.Profile.ViewModels"
             x:DataType="vm:ProfileViewModel"
             Background="{DynamicResource PrimaryBG}">
    <UserControl.Styles>
        <Style Selector="TextBlock.FieldValue">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style Selector="TextBlock.ValidationError">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector="Border.PreViewBanner">
            <Setter Property="Background" Value="{DynamicResource AccentMuted}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>
        <Style Selector="Border.InputPrefix">
            <Setter Property="Background" Value="{DynamicResource ControlBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorder}"/>
            <Setter Property="BorderThickness" Value="1,1,0,1"/>
            <Setter Property="CornerRadius" Value="8,0,0,8"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="40"/>
        </Style>
    </UserControl.Styles>
    <Border Classes="PageContainer">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Classes="ThinScrollbar">
            <Border Padding="16,16,16,40">
                <StackPanel MaxWidth="480"
                            HorizontalAlignment="Stretch"
                            Spacing="18">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Профиль" Classes="PageTitle"/>
                        <TextBlock Text="Управление личными данными и безопасностью"
                                   Classes="SectionSubtitle"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <Border Classes="Section">
                        <Grid ColumnDefinitions="Auto,*">
                            <Panel Classes="AvatarEditContainer"
                                   Width="80" Height="80"
                                   Margin="0,0,4,0">

                                <controls:AvatarControl Classes="XLarge"
                                                        ImageBitmap="{Binding AvatarBitmap}"
                                                        Source="{Binding AvatarUrl}"
                                                        DisplayName="{Binding FullName}"
                                                        ShowOnlineIndicator="False"/>

                                <Button Classes="AvatarEditOverlay"
                                        Width="80" Height="80"
                                        CornerRadius="40"
                                        Command="{Binding UploadAvatarCommand}"
                                        ToolTip.Tip="Изменить аватар">
                                    <Border Classes="AvatarOverlay"
                                            Width="80" Height="80"
                                            CornerRadius="40"
                                            Background="#66000000">
                                        <PathIcon Data="{StaticResource CameraIcon}"
                                                  Width="24" Height="24"
                                                  Foreground="White"/>
                                    </Border>
                                </Button>

                                <Button Classes="AvatarDeleteBadge"
                                        Width="24" Height="24" CornerRadius="12"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-2,-2,0"
                                        Command="{Binding DeleteAvatarCommand}"
                                        IsVisible="{Binding HasAvatar}"
                                        ToolTip.Tip="Удалить аватар">
                                    <Path Data="{StaticResource CloseIcon}"
                                          Width="9" Height="9" Stretch="Uniform"
                                          Fill="White"/>
                                </Button>
                            </Panel>

                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Spacing="6"
                                        Margin="16,0,0,0">
                                <TextBlock Text="{Binding FullName}"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="@"
                                               Classes="TextMuted"
                                               FontSize="14"/>
                                    <TextBlock Text="{Binding Username, FallbackValue='username'}"
                                               Classes="TextSecondary"
                                               FontSize="14"/>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="Section">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Ellipse Width="14" Height="14"
                                             Fill="{Binding CurrentStatusColor}"
                                             VerticalAlignment="Center"/>
                                    <TextBlock Text="Статус"
                                               Classes="SectionItemTitle"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Classes="IconButton Small"
                                        ToolTip.Tip="Сменить статус">
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuItem Header="В сети" Command="{Binding SetStatusCommand}" CommandParameter="Online">
                                                <MenuItem.Icon>
                                                    <Ellipse Width="10" Height="10" Fill="#43A047" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Отошёл" Command="{Binding SetStatusCommand}" CommandParameter="Away">
                                                <MenuItem.Icon>
                                                    <Ellipse Width="10" Height="10" Fill="#FFA000" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Занят" Command="{Binding SetStatusCommand}" CommandParameter="Busy">
                                                <MenuItem.Icon>
                                                    <Ellipse Width="10" Height="10" Fill="#E53935" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Не беспокоить" Command="{Binding SetStatusCommand}" CommandParameter="DnD">
                                                <MenuItem.Icon>
                                                    <Ellipse Width="10" Height="10" Fill="#9C27B0" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Занят на 15 мин" Command="{Binding SetStatusCommand}" CommandParameter="Busy15m" />
                                            <MenuItem Header="Занят на 30 мин" Command="{Binding SetStatusCommand}" CommandParameter="Busy30m" />
                                            <MenuItem Header="Занят на 1 час" Command="{Binding SetStatusCommand}" CommandParameter="Busy1h" />
                                            <MenuItem Header="Не беспокоить 1 час" Command="{Binding SetStatusCommand}" CommandParameter="DnD1h" />
                                            <MenuItem Header="Не беспокоить 2 часа" Command="{Binding SetStatusCommand}" CommandParameter="DnD2h" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                    <PathIcon Data="{StaticResource EditIcon}"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource TextSecondary}"/>
                                </Button>
                            </Grid>

                            <TextBlock Text="{Binding CurrentStatusText}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Classes="Section">
                        <StackPanel Spacing="16">

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource ProfileIcon}"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Личные данные"
                                               Classes="SectionItemTitle"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Classes="IconButton Small"
                                        Command="{Binding StartEditProfileCommand}"
                                        IsVisible="{Binding !IsEditingProfile}"
                                        ToolTip.Tip="Редактировать">
                                    <PathIcon Data="{StaticResource EditIcon}"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource TextSecondary}"/>
                                </Button>
                            </Grid>

                            <StackPanel Spacing="12" IsVisible="{Binding !IsEditingProfile}">
                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      ColumnDefinitions="90,*"
                                      RowSpacing="10">

                                    <TextBlock Text="Фамилия" Classes="FieldLabel" Opacity="0.7"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding SurnameDisplay}"
                                               Classes="FieldValue"/>

                                    <TextBlock Grid.Row="1" Text="Имя" Classes="FieldLabel" Opacity="0.7"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1"
                                               Text="{Binding NameDisplay}"
                                               Classes="FieldValue"/>

                                    <TextBlock Grid.Row="2" Text="Отчество" Classes="FieldLabel" Opacity="0.7"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1"
                                               Text="{Binding MidnameDisplay}"
                                               Classes="FieldValue"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Spacing="16" IsVisible="{Binding IsEditingProfile}">

                                <Border Classes="PreViewBanner">
                                    <Grid ColumnDefinitions="Auto,*">
                                        <TextBlock Text="Отображается как:"
                                                   Classes="TextSecondary"
                                                   FontSize="12"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding TempFullName}"
                                                   FontSize="14"
                                                   FontWeight="Medium"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch"
                                            IsVisible="{Binding LayoutMode,
                                            Converter={conv:Converter Name=LayoutModeToSideNavVisible},
                                            ElementName=Root}">
                                    <StackPanel Spacing="6" Width="130" Margin="0,0,12,0">
                                        <TextBlock Text="Фамилия" Classes="FieldLabel" FontSize="12"/>
                                        <TextBox Text="{Binding TempSurname}" Classes="Input" PlaceholderText="Иванов"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6" Width="130" Margin="0,0,12,0">
                                        <TextBlock Text="Имя" Classes="FieldLabel" FontSize="12"/>
                                        <TextBox Text="{Binding TempName}" Classes="Input" PlaceholderText="Иван"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6" Width="130">
                                        <TextBlock Text="Отчество" Classes="FieldLabel" FontSize="12"/>
                                        <TextBox Text="{Binding TempMidname}" Classes="Input" PlaceholderText="Иванович"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="10"
                                            IsVisible="{Binding LayoutMode,
                                            Converter={conv:Converter Name=LayoutModeToBottomNavVisible},
                                            ElementName=Root}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Фамилия" Classes="FieldLabel" FontSize="12"/>
                                        <TextBox Text="{Binding TempSurname}" Classes="Input" PlaceholderText="Иванов"
                                                 HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Имя" Classes="FieldLabel" FontSize="12"/>
                                        <TextBox Text="{Binding TempName}" Classes="Input" PlaceholderText="Иван"
                                                 HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Отчество" Classes="FieldLabel" FontSize="12"/>
                                        <TextBox Text="{Binding TempMidname}" Classes="Input" PlaceholderText="Иванович"
                                                 HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10" Classes="FormActions">
                                    <Button Content="Сохранить"
                                            Classes="DialogAccent"
                                            Command="{Binding SaveProfileCommand}"
                                            Padding="20,8"/>
                                    <Button Content="Отмена"
                                            Classes="DialogOutline"
                                            Command="{Binding CancelEditProfileCommand}"
                                            Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="Section">
                        <StackPanel Spacing="16">

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource MentionIcon}"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Имя пользователя"
                                               Classes="SectionItemTitle"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Classes="IconButton Small"
                                        Command="{Binding StartEditUsernameCommand}"
                                        IsVisible="{Binding !IsEditingUsername}"
                                        ToolTip.Tip="Изменить">
                                    <PathIcon Data="{StaticResource EditIcon}"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource TextSecondary}"/>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="90,*"
                                  IsVisible="{Binding !IsEditingUsername}">
                                <TextBlock Text="Username" Classes="FieldLabel" Opacity="0.7"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                                    <TextBlock Text="@" Classes="TextMuted" FontSize="14"/>
                                    <TextBlock Text="{Binding Username}" Classes="FieldValue"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Spacing="14" IsVisible="{Binding IsEditingUsername}">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Новый username" Classes="FieldLabel" FontSize="12"/>
                                    <Grid ColumnDefinitions="Auto,*">
                                        <Border Classes="InputPrefix">
                                            <TextBlock Text="@"
                                                       VerticalAlignment="Center"
                                                       FontSize="14"
                                                       Foreground="{DynamicResource TextMuted}"/>
                                        </Border>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding TempUsername}"
                                                 Classes="Input"
                                                 CornerRadius="0,8,8,0"
                                                 PlaceholderText="username"
                                                 MaxLength="30"/>
                                    </Grid>

                                    <Panel Height="16">
                                        <TextBlock Text="{Binding UsernameValidationMessage}"
                                                   Classes="ValidationError"
                                                   IsVisible="{Binding UsernameValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <TextBlock Text="Латинские буквы, цифры и подчёркивания (3-30 символов)"
                                                   Classes="ValidationHint"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding UsernameValidationMessage, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                                    </Panel>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Spacing="10" Classes="FormActions">
                                    <Button Content="Сохранить"
                                            Classes="DialogAccent"
                                            Command="{Binding SaveUsernameCommand}"
                                            IsEnabled="{Binding CanSaveUsername}"
                                            Padding="20,8"/>
                                    <Button Content="Отмена"
                                            Classes="DialogOutline"
                                            Command="{Binding CancelEditUsernameCommand}"
                                            Padding="16,8"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="Section">
                        <StackPanel Spacing="16">

                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="10"
                                            VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource LockClosedIcon}"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Безопасность"
                                               Classes="SectionItemTitle"/>
                                </StackPanel>

                                <Button Grid.Column="2"
                                        Classes="IconButton Small"
                                        Command="{Binding StartEditPasswordCommand}"
                                        IsVisible="{Binding !IsEditingPassword}"
                                        ToolTip.Tip="Изменить пароль">
                                    <PathIcon Data="{StaticResource EditIcon}"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource TextSecondary}"/>
                                </Button>
                            </Grid>

                            <Grid ColumnDefinitions="90,*"
                                  IsVisible="{Binding !IsEditingPassword}">
                                <TextBlock Text="Пароль"
                                           Classes="FieldLabel"
                                           Opacity="0.7"/>
                                <TextBlock Grid.Column="1"
                                           Text="••••••••••••"
                                           Classes="FieldValue"
                                           Foreground="{DynamicResource TextSecondary}"
                                           LetterSpacing="2"/>
                            </Grid>

                            <StackPanel Spacing="16"
                                        IsVisible="{Binding IsEditingPassword}">

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Текущий пароль"
                                               Classes="FieldLabel"
                                               FontSize="12"/>
                                    <TextBox Text="{Binding CurrentPassword}"
                                             Classes="Input"
                                             PasswordChar="•"
                                             PlaceholderText="Введите текущий пароль"
                                             HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <Separator Background="{DynamicResource BorderDefault}"
                                           Margin="0,4"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch"
                                            IsVisible="{Binding LayoutMode,
                                            Converter={conv:Converter Name=LayoutModeToSideNavVisible},
                                            ElementName=Root}">
                                    <StackPanel Spacing="6" Width="200" Margin="0,0,12,0">
                                        <TextBlock Text="Новый пароль" Classes="FieldLabel" FontSize="12"/>
                                        <TextBox Text="{Binding NewPassword}" Classes="Input" PasswordChar="•" PlaceholderText="Минимум 6 символов"/>
                                        <TextBlock Text="{Binding NewPasswordValidationMessage}" Classes="ValidationHint" TextWrapping="Wrap"
                                                   IsVisible="{Binding NewPasswordValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6" Width="200">
                                        <TextBlock Text="Подтвердите пароль" Classes="FieldLabel" FontSize="12"/>
                                        <TextBox Text="{Binding ConfirmPassword}" Classes="Input" PasswordChar="•" PlaceholderText="Повторите пароль"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Spacing="10"
                                            IsVisible="{Binding LayoutMode,
                                            Converter={conv:Converter Name=LayoutModeToBottomNavVisible},
                                            ElementName=Root}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Новый пароль" Classes="FieldLabel" FontSize="12"/>
                                        <TextBox Text="{Binding NewPassword}" Classes="Input" PasswordChar="•"
                                                 PlaceholderText="Минимум 6 символов"
                                                 HorizontalAlignment="Stretch"/>
                                        <TextBlock Text="{Binding NewPasswordValidationMessage}" Classes="ValidationHint" TextWrapping="Wrap"
                                                   IsVisible="{Binding NewPasswordValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    </StackPanel>
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="Подтвердите пароль" Classes="FieldLabel" FontSize="12"/>
                                        <TextBox Text="{Binding ConfirmPassword}" Classes="Input" PasswordChar="•"
                                                 PlaceholderText="Повторите пароль"
                                                 HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                </StackPanel>

                                <controls:PasswordStrengthControl
                                    Strength="{Binding NewPasswordStrength}"
                                    StrengthLabel="{Binding NewPasswordStrengthLabel}"
                                    PasswordsMatch="{Binding PasswordsMatch}"
                                    ShowMatch="True"/>

                                <StackPanel Orientation="Horizontal"
                                            Spacing="10"
                                            Margin="0,4,0,0"
                                            Classes="FormActions">
                                    <Button Content="Изменить пароль"
                                            Classes="DialogAccent"
                                            Command="{Binding SavePasswordCommand}"
                                            IsEnabled="{Binding CanSavePassword}"
                                            Padding="20,8"/>
                                    <Button Content="Отмена"
                                            Classes="DialogOutline"
                                            Command="{Binding CancelEditPasswordCommand}"
                                            Padding="16,8"/>
                                </StackPanel>

                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Classes="Section"
                            IsVisible="{Binding HasDepartment}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <PathIcon Data="{StaticResource OrganizationIcon}"
                                      Width="18" Height="18"
                                      Foreground="{DynamicResource Accent}"
                                      VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Отдел" Classes="TextSecondary" FontSize="12"/>
                                <TextBlock Text="{Binding DepartmentDisplay}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Classes="Section">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <PathIcon Data="{StaticResource SignOutIcon}"
                                      Width="18" Height="18"
                                      Foreground="{DynamicResource DangerBrush}"
                                      VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Выход из аккаунта"
                                           FontSize="14"
                                           FontWeight="Medium"/>
                                <TextBlock Text="Вы будете перенаправлены на страницу входа"
                                           Classes="TextMuted"
                                           FontSize="12"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Content="Выйти"
                                    Classes="DialogDanger"
                                    Command="{Binding LogoutCommand}"
                                    VerticalAlignment="Center"
                                    Padding="20,8"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Border>
</UserControl>