<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Desktop.Views.Controls"
             xmlns:shared="using:Desktop.Views.Controls.Shared"
             x:Class="Desktop.Views.Controls.FilterAutocomplete"
             x:Name="Root"
             x:DataType="controls:FilterAutocomplete">
    
    <TextBox x:Name="InputTextBox"
             Classes="Input"
             Text="{Binding #Root.SearchText, Mode=TwoWay}"
             PlaceholderText="{Binding #Root.Placeholder}"
             GotFocus="OnInputFocused"
             LostFocus="OnInputLostFocus">
        
        <TextBox.InnerLeftContent>
            <Panel>
                <controls:AvatarControl Classes="Small"
                                        Source="{Binding #Root.SelectedItem.Avatar, FallbackValue={x:Null}}"
                                        DisplayName="{Binding #Root.SelectedItem.DisplayName, FallbackValue=''}"
                                        ShowOnlineIndicator="False"
                                        Margin="8,0,4,0"
                                        IsVisible="{Binding #Root.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
                <PathIcon Data="{Binding #Root.Icon}"
                          Classes="InputIcon"
                          Margin="12,0,8,0"
                          IsVisible="{Binding #Root.SelectedItem, Converter={x:Static ObjectConverters.IsNull}}"/>
                <shared:CircularProgress IsIndeterminate="True"
                                         Size="16"
                                         StrokeWidth="2"
                                         Margin="12,0,8,0"
                                         IsVisible="{Binding #Root.IsLoading}"
                                         HorizontalAlignment="Left"
                                         VerticalAlignment="Center"/>
            </Panel>
        </TextBox.InnerLeftContent>

        <TextBox.InnerRightContent>
            <Button Classes="IconButton Small"
                    Margin="0,0,8,0"
                    Command="{Binding #Root.ClearCommand}"
                    IsVisible="{Binding #Root.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"
                    ToolTip.Tip="Очистить">
                <PathIcon Data="{StaticResource CloseIcon}"
                          Width="10" Height="10"
                          Foreground="{DynamicResource TextMuted}"/>
            </Button>
        </TextBox.InnerRightContent>
    </TextBox>
</UserControl>