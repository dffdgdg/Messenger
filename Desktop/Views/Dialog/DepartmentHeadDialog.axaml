<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmDialog="using:Desktop.ViewModels.Dialog"
             xmlns:controls="using:Desktop.Views.Controls"
             xmlns:department="using:Shared.Dto.Department"
             x:Class="Desktop.Views.DepartmentHeadDialog"
             x:DataType="vmDialog:DepartmentHeadDialogViewModel">
    <UserControl.Styles>
        <Style Selector="Border.AlertInfo">
		<Setter Property="CornerRadius" Value="8"/>
		<Setter Property="Padding" Value="14,12"/>
		<Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
		<Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
	</Style>
    </UserControl.Styles>
    <Border Classes="DialogContainer">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

            <!-- Шапка -->
            <Grid ColumnDefinitions="*,Auto"
                  Margin="24,24,24,16">
                <StackPanel VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="{Binding Title}" Classes="DialogTitle Small"/>
                    <TextBlock Text="Отдел" Classes="DialogSubtitle" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="1"
                        Classes="IconButton"
                        Command="{Binding CancelCommand}"
                        ToolTip.Tip="Закрыть">
                    <PathIcon Data="{StaticResource CloseIcon}"
                              Width="14" Height="14"
                              Foreground="{DynamicResource TextSecondary}"/>
                </Button>
            </Grid>

            <!-- Разделитель -->
            <Border Grid.Row="1" Classes="DialogDivider"/>

            <!-- Тело -->
            <ScrollViewer Grid.Row="2"
                          Classes="ThinScrollbar"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="16" Margin="24,16,24,16">

                    <!-- Название -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Название отдела" Classes="FieldLabel Secondary"/>
                        <TextBox Text="{Binding Name}"
                                 Classes="Input"
                                 PlaceholderText="Введите название отдела...">
                            <TextBox.InnerLeftContent>
                                <PathIcon Data="{StaticResource FolderIcon}"
                                          Classes="InputIcon"
                                          Margin="12,0,8,0"/>
                            </TextBox.InnerLeftContent>
                        </TextBox>
                    </StackPanel>

                    <!-- Родительский отдел -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Родительский отдел" Classes="FieldLabel Secondary"/>
                        <ComboBox ItemsSource="{Binding AvailableParents}"
                                  SelectedItem="{Binding SelectedParent}"
                                  Classes="DialogCombo"
                                  PlaceholderText="Выбрать родительский отдел"
                                  HorizontalAlignment="Stretch">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="department:DepartmentDto">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <PathIcon Data="{StaticResource OrganizationIcon}"
                                                  Width="14" Height="14"
                                                  Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Руководитель -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Руководитель отдела" Classes="FieldLabel Secondary"/>
                        <Border Background="{DynamicResource SurfaceVariant}"
                                CornerRadius="10"
                                Padding="12"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource BorderDefault}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                <controls:AvatarControl Grid.Column="0"
                                                        Classes="Small"
                                                        Source="{Binding HeadAvatar}"
                                                        DisplayName="{Binding HeadDisplayText}"
                                                        IsVisible="{Binding HasHead}"
                                                        Margin="0,0,12,0"/>
                                <Border Width="36" Height="36"
                                        CornerRadius="18"
                                        Background="{DynamicResource SurfaceBrush}"
                                        IsVisible="{Binding !HasHead}"
                                        Margin="0,0,12,0">
                                    <PathIcon Data="{StaticResource PersonIcon}"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource TextTertiary}"/>
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                    <TextBlock Text="{Binding HeadDisplayText}"
                                               FontSize="14"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="Руководитель отдела"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiary}"
                                               IsVisible="{Binding HasHead}"/>
                                </StackPanel>
                                <Button Grid.Column="2"
                                        Classes="IconButton Small"
                                        Command="{Binding ClearHeadCommand}"
                                        IsVisible="{Binding HasHead}"
                                        ToolTip.Tip="Убрать руководителя"
                                        Margin="8,0,4,0">
                                    <PathIcon Data="{StaticResource CloseIcon}"
                                              Width="16" Height="16"
                                              Foreground="{DynamicResource DangerBrush}"/>
                                </Button>
                                <Button Grid.Column="3"
                                        Classes="IconButton"
                                        Command="{Binding SelectHeadCommand}"
                                        ToolTip.Tip="Выбрать руководителя">
                                    <PathIcon Data="{StaticResource AddIcon}"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource AccentBrush}"/>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Инфо-блок -->
                    <Border Classes="AlertInfo"
                            IsVisible="{Binding !IsNewDepartment}">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Grid.Column="0"
                                          Data="{StaticResource PersonIcon}"
                                          Width="14" Height="14"
                                          Foreground="{DynamicResource TextSecondary}"
                                          Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="Сотрудников в отделе"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding UserCount}"
                                           FontSize="12"
                                           FontWeight="SemiBold"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*"
                                  IsVisible="{Binding HasChildren}">
                                <PathIcon 
                                          Data="{StaticResource WarningIcon}"
                                          Width="14" Height="14"
                                          Foreground="{DynamicResource WarningBrush}"
                                          Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1"
                                           Text="Имеет дочерние отделы"
                                           FontSize="12"
                                           Foreground="{DynamicResource WarningBrush}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Ошибка -->
                    <Border Classes="AlertError"
                            IsVisible="{Binding ErrorMessage,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Grid.Column="0"
                                      Data="{StaticResource ErrorIcon}"
                                      Width="16" Height="16"
                                      Foreground="{DynamicResource DangerBrush}"
                                      Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ErrorMessage}"
                                       Foreground="{DynamicResource DangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                    <!-- Успех -->
                    <Border Classes="AlertSuccess"
                            IsVisible="{Binding SuccessMessage,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <Grid ColumnDefinitions="Auto,*">
                            <PathIcon Grid.Column="0"
                                      Data="{StaticResource CheckmarkIcon}"
                                      Width="16" Height="16"
                                      Foreground="{DynamicResource SuccessBrush}"
                                      Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SuccessMessage}"
                                       Foreground="{DynamicResource SuccessBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Разделитель -->
            <Border Grid.Row="3" Classes="DialogDivider"/>

            <!-- Футер -->
            <Grid Grid.Row="4"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  Margin="24,16,24,24">
                <Button Grid.Column="0"
                        Classes="DialogDanger"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding !IsNewDepartment}"
                        IsEnabled="{Binding CanDelete}"
                        ToolTip.Tip="{Binding DeleteTooltip}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource DeleteIcon}"
                                  Width="14" Height="14"/>
                        <TextBlock Text="Удалить"/>
                    </StackPanel>
                </Button>
                <Border Grid.Column="1"/>
                <Button Grid.Column="2"
                        Content="Отмена"
                        Classes="DialogOutline"
                        Command="{Binding CancelCommand}"
                        MinWidth="100"
                        Margin="0,0,12,0"/>
                <Button Grid.Column="3"
                        Classes="DialogAccent"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        MinWidth="100">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource CheckmarkIcon}"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource TextOnAccent}"/>
                        <TextBlock Text="Сохранить"
                                   Foreground="{DynamicResource TextOnAccent}"/>
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>
    </Border>
</UserControl>