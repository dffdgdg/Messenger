<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<EnableDefaultContentItems>true</EnableDefaultContentItems>
		<OutputType>WinExe</OutputType>

		<TargetFrameworks>net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
		<RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
		<UseRidGraph>true</UseRidGraph>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<ApplicationIcon>Assets\logo.ico</ApplicationIcon>
		<ServerGarbageCollection>true</ServerGarbageCollection>
		<AssemblyName>ВнутрьСеть</AssemblyName>
		<AssemblyTitle></AssemblyTitle>
		<ImplicitUsings>enable</ImplicitUsings>

		<PlatformTarget>x64</PlatformTarget>

		<GenerateDocumentationFile>False</GenerateDocumentationFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
		<PackageReference Include="Avalonia.X11" Version="12.0.4" />
		<PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
		<PackageReference Include="Silk.NET.OpenAL.Extensions.Creative" Version="2.23.0" />
		<PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
		<PackageReference Include="Tmds.DBus.Protocol" Version="0.94.2" />
		<PackageReference Include="SIPSorcery" Version="10.0.10" />
		<PackageReference Include="Concentus" Version="2.2.2" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.4" />
		<PackageReference Include="Avalonia.Markup.Declarative" Version="12.0.1" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.9" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.9" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Scrutor" Version="7.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
		<PackageReference Include="sqlite-net-pcl" Version="1.9.172" />
		<PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
		<PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.19.1" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Remove="Assets\Animations\**" />
		<AvaloniaXaml Remove="Assets\Animations\**" />
		<AvaloniaXaml Remove="Models\**" />
		<Compile Remove="Assets\Animations\**" />
		<Compile Remove="Models\**" />
		<EmbeddedResource Remove="Assets\Animations\**" />
		<EmbeddedResource Remove="Models\**" />
		<None Remove="Assets\Animations\**" />
		<None Remove="Models\**" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaXaml Remove="Assets\Animations.axaml" />
		<AvaloniaXaml Remove="Assets\LightTheme.axaml" />
		<AvaloniaXaml Remove="Assets\MainStyle.axaml" />
		<AvaloniaXaml Remove="Assets\Styles\ChatInfoSkeleton.axaml" />
		<AvaloniaXaml Remove="Assets\Styles\ChatListSkeleton.axaml" />
		<AvaloniaXaml Remove="Assets\Styles\ChatMessagesSkeleton.axaml" />
		<AvaloniaXaml Remove="Assets\Styles\Controls.axaml" />
		<AvaloniaXaml Remove="Assets\Styles\MessageStyles.axaml" />
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="Assets\Styles\ChatInfoSkeleton.axaml.cs" />
		<Compile Remove="Assets\Styles\ChatListSkeleton.axaml.cs" />
		<Compile Remove="Assets\Styles\ChatMessagesSkeleton.axaml.cs" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Assets\logo.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\Core.csproj" />
		<ProjectReference Include="..\Shared\Shared.csproj" />
	</ItemGroup>

	<ItemGroup>
		<AvaloniaResource Update="Assets\Styles\Base\MainStyle.axaml">
			<SubType>Designer</SubType>
		</AvaloniaResource>
		<AvaloniaResource Update="Assets\Styles\Base\Animations.axaml">
			<SubType>Designer</SubType>
		</AvaloniaResource>
		<AvaloniaResource Update="Assets\Styles\MessageStyles.axaml">
			<SubType>Designer</SubType>
		</AvaloniaResource>
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Views\Call\IncomingCallDialog.axaml.cs">
			<DependentUpon>IncomingCallDialog.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Chat\ChatEditDialogView.axaml.cs">
			<DependentUpon>ChatEditDialogView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Chat\MessageParts\Shared\MessageMetaBlock.axaml.cs">
			<DependentUpon>MessageMetaBlock.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Department\DepartmentManagementView.axaml.cs">
			<DependentUpon>DepartmentManagementView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Shared\ConfirmDialog.axaml.cs">
			<DependentUpon>ConfirmDialog.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Shell\MainMenuView.axaml.cs">
			<DependentUpon>MainMenuView.axaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Assets\Images\Icons\" />
		<Folder Include="Assets\Images\Avatars\" />
		<Folder Include="Assets\Images\Illustrations\" />
		<Folder Include="Views\Chat\Poll\" />
		<Folder Include="Views\Controls\Admin\" />
	</ItemGroup>

	<ItemGroup>
		<None Update="appsettings.Wsl.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="appsettings.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="appsettings.Local.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

	<ItemGroup>
		<Service Include="{508349b6-6b84-4df5-91f0-309beebad82d}" />
	</ItemGroup>

	<PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
		<BaseOutputPath>/tmp/MessengerDesktop/bin/</BaseOutputPath>
		<BaseIntermediateOutputPath>/tmp/MessengerDesktop/obj/</BaseIntermediateOutputPath>
	</PropertyGroup>

	<Target Name="CopyToWindowsOutput" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'win-x64'">
		<RemoveDir Directories="$(SolutionDir)Publish\Windows\" />
		<Copy SourceFiles="@(PublishedFiles)" DestinationFolder="$(SolutionDir)Publish\Windows\%(RecursiveDir)" />
		<Message Importance="high" Text="Published for Windows to $(SolutionDir)Publish\Windows" />
	</Target>

	<Target Name="CopyToLinuxOutput" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
		<RemoveDir Directories="$(SolutionDir)Publish\Linux\" />
		<Copy SourceFiles="@(PublishedFiles)" DestinationFolder="$(SolutionDir)Publish\Linux\%(RecursiveDir)" />
		<Message Importance="high" Text="Published for Linux to $(SolutionDir)Publish\Linux" />
	</Target>
</Project>