<UserControl
    x:Class="Desktop.Views.Auth.LoginView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Core.Features.Auth.ViewModels"
    x:DataType="vm:LoginViewModel">
    <UserControl.Styles>
        <Style Selector="Border.AlertSuccess, Border.MessageSuccess">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="CheckBox.RememberMe">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Border.AlertError, Border.MessageError">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!--  Стиль для иконки сервера  -->
        <Style Selector="Button.ServerButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="Button.ServerButton:pointerover">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.ServerButton:disabled">
            <Setter Property="Opacity" Value="0.2" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <!--  Фон с декоративными элементами  -->
        <Panel>
            <Border>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Offset="0" Color="{DynamicResource LoginBgStart}" />
                        <GradientStop Offset="0.5">
                            <GradientStop.Color>
                                <DynamicResource ResourceKey="LoginBgMiddle" />
                            </GradientStop.Color>
                        </GradientStop>
                        <GradientStop Offset="1" Color="{DynamicResource LoginBgEnd}" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border IsHitTestVisible="False" Opacity="0.3">
                <Border.OpacityMask>
                    <RadialGradientBrush Center="0.5,0.5" RadiusX="0.7" RadiusY="0.7">
                        <GradientStop Offset="0" Color="#FF000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </RadialGradientBrush>
                </Border.OpacityMask>
                <Border.Background>
                    <VisualBrush
                        DestinationRect="0,0,80,80"
                        SourceRect="0,0,80,80"
                        TileMode="Tile">
                        <VisualBrush.Visual>
                            <Canvas Width="80" Height="80">
                                <Line
                                    Stroke="{DynamicResource LoginGridLine}"
                                    StrokeThickness="1"
                                    StartPoint="79,0"
                                    EndPoint="79,80" />
                                <Line
                                    Stroke="{DynamicResource LoginGridLine}"
                                    StrokeThickness="1"
                                    StartPoint="0,79"
                                    EndPoint="80,79" />
                            </Canvas>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.Background>
            </Border>

            <Ellipse
                Width="600"
                Height="600"
                Margin="-250,-200,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="{DynamicResource LoginGlowPrimary}"
                IsHitTestVisible="False" />
            <Ellipse
                Width="500"
                Height="500"
                Margin="0,0,-150,-150"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Fill="{DynamicResource LoginGlowSecondary}"
                IsHitTestVisible="False" />
        </Panel>

        <!--  Основная карточка логина  -->
        <Border
            MinWidth="360"
            MaxWidth="400"
            Padding="32,28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource LoginCardBg}"
            BorderBrush="{DynamicResource LoginCardBorder}"
            BorderThickness="1"
            CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="60"
                    OffsetY="12"
                    Opacity="0.4"
                    Color="Black" />
            </Border.Effect>

            <Grid>
                <!--  Основное содержимое карточки  -->
                <StackPanel Spacing="24">
                    <!--  Логотип и заголовок  -->
                    <StackPanel HorizontalAlignment="Center" Spacing="12">
                        <Path
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Center"
                            Data="{StaticResource LogoIcon}"
                            Fill="{DynamicResource Accent}"
                            Stretch="Uniform" />

                        <StackPanel Spacing="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="ВнутрьСеть" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="Войдите в свой аккаунт" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Сообщения об ошибках и успехе  -->
                    <Border Classes="MessageError" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource ErrorBrush}"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap" />
                    </Border>

                    <Border Classes="MessageSuccess" IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            Foreground="{DynamicResource SuccessBrush}"
                            Text="{Binding SuccessMessage}"
                            TextWrapping="Wrap" />
                    </Border>

                    <!--  Поля ввода  -->
                    <StackPanel IsEnabled="{Binding !IsBusy}" Spacing="16">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="FieldLabel" Text="Логин" />
                            <TextBox
                                Classes="Input"
                                PlaceholderText="Введите логин"
                                Text="{Binding Username}" />
                        </StackPanel>

                        <StackPanel Spacing="6">
                            <TextBlock Classes="FieldLabel" Text="Пароль" />
                            <TextBox
                                x:Name="PasswordBox"
                                Classes="Input"
                                PasswordChar="•"
                                PlaceholderText="Введите пароль"
                                Text="{Binding Password}" />
                        </StackPanel>
                    </StackPanel>

                    <Grid VerticalAlignment="Center" ColumnDefinitions="*, Auto">
                        <CheckBox
                            Grid.Column="0"
                            Classes="RememberMe"
                            Content="Запомнить меня"
                            IsChecked="{Binding RememberMe}"
                            IsEnabled="{Binding !IsBusy}" />

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Classes="ServerButton"
                            Command="{Binding SetServerUrlCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            ToolTip.Placement="Bottom"
                            ToolTip.Tip="{Binding ServerUrl, FallbackValue='Сервер не задан'}">
                            <Path
                                Width="16"
                                Height="16"
                                Data="{StaticResource SettingsIcon}"
                                Fill="{DynamicResource TextSecondary}"
                                Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!--  Кнопка входа  -->
                    <Button Classes="Primary FullWidth" Command="{Binding LoginCommand}">
                        <Panel>
                            <TextBlock
                                HorizontalAlignment="Center"
                                Foreground="White"
                                IsVisible="{Binding !IsBusy}"
                                Text="Войти" />

                            <StackPanel
                                HorizontalAlignment="Center"
                                IsVisible="{Binding IsBusy}"
                                Orientation="Horizontal"
                                Spacing="8">
                                <TextBlock VerticalAlignment="Center" Text="Вход..." />
                            </StackPanel>
                        </Panel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--  Оверлей инициализации  -->
        <Border
            Background="#80000000"
            IsHitTestVisible="{Binding IsInitializing}"
            IsVisible="{Binding IsInitializing}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Border Width="32" Height="32">
                    <ProgressBar
                        Width="32"
                        Height="32"
                        Classes="Circular"
                        Foreground="{DynamicResource Accent}"
                        IsIndeterminate="True" />
                </Border>
                <TextBlock
                    HorizontalAlignment="Center"
                    FontSize="14"
                    Foreground="White"
                    Text="Подключение..." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>