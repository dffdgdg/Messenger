<UserControl
    x:Class="Core.Dialog.UserProfile.UserProfileDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Core.Shared.Controls"
    xmlns:conv="using:Core.Shared.Converters"
    xmlns:local="using:Core.Dialog.UserProfile"
    x:DataType="local:UserProfileDialogViewModel">

    <UserControl.KeyBindings>
        <KeyBinding Command="{Binding CloseOnBackgroundClickCommand}" Gesture="Escape" />
    </UserControl.KeyBindings>

    <UserControl.Styles>

        <Style Selector="Button.ProfileActionButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Height" Value="68" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition
                        Easing="CubicEaseOut"
                        Property="RenderTransform"
                        Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ProfileActionButton /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentMuted}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ProfileActionButton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>

        <Style Selector="Button.ProfileActionButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentPressed}" />
        </Style>

        <Style Selector="Button.ProfileActionButton:pressed">
            <Setter Property="RenderTransform" Value="scale(0.95)" />
        </Style>

        <Style Selector="Button.ProfileActionButton PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ProfileActionButton:pointerover PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        </Style>

        <Style Selector="Button.ProfileActionButton TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Foreground" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ProfileActionButton:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
        </Style>

        <Style Selector="Button.InfoRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style Selector="Button.InfoRow /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.InfoRow:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
        </Style>

        <Style Selector="Button.InfoRow:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
        </Style>

        <Style Selector="Button.InfoRow PathIcon.CopyHint">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="translateX(6px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition
                        Easing="CubicEaseOut"
                        Property="Opacity"
                        Duration="0:0:0.15" />
                    <TransformOperationsTransition
                        Easing="CubicEaseOut"
                        Property="RenderTransform"
                        Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.InfoRow:pointerover PathIcon.CopyHint">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="RenderTransform" Value="translateX(0px)" />
        </Style>

    </UserControl.Styles>

    <Border
        Width="340"
        MaxHeight="600"
        Classes="DialogContainer"
        ClipToBounds="True">
        <Grid RowDefinitions="Auto,*">

            <Border
                Grid.Row="0"
                Padding="16,14,16,20"
                Background="{DynamicResource SecondaryBG}"
                ClipToBounds="False"
                CornerRadius="16,16,0,0">
                <Grid RowDefinitions="Auto,Auto,Auto">

                    <Button
                        Grid.Row="0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Classes="IconButton Small"
                        Command="{Binding CloseOnBackgroundClickCommand}"
                        ToolTip.Tip="Закрыть (Esc)">
                        <PathIcon
                            Width="11"
                            Height="11"
                            Data="{StaticResource CloseIcon}"
                            Foreground="{DynamicResource TextSecondary}" />
                    </Button>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,8,0,18"
                        HorizontalAlignment="Center"
                        Spacing="12">

                        <Border
                            HorizontalAlignment="Center"
                            BoxShadow="0 8 24 4 #402B74D9, 0 2 8 0 #20000000"
                            ClipToBounds="False"
                            CornerRadius="999">
                            <Border ClipToBounds="True" CornerRadius="999">
                                <controls:AvatarControl
                                    Classes="XXLarge"
                                    DisplayName="{Binding User.DisplayName}"
                                    IsOnline="{Binding User.IsOnline}"
                                    Source="{Binding User.Avatar}"
                                    StatusType="{Binding User.StatusType}" />
                            </Border>
                        </Border>

                        <StackPanel HorizontalAlignment="Center" Spacing="5">

                            <TextBlock
                                MaxWidth="280"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="Bold"
                                Text="{Binding User.DisplayName}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap"
                                ToolTip.Tip="{Binding User.DisplayName}" />

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="5">
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource OnlineStatus}"
                                    IsVisible="{Binding User.IsOnline}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextSecondary}">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{conv:MultiConverter Name=LastSeen}">
                                            <Binding Path="User.IsOnline" />
                                            <Binding Path="User.LastOnline" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                        </StackPanel>
                    </StackPanel>

                    <Grid Grid.Row="2" IsVisible="{Binding CanSendMessage}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="{Binding CanCall}" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            Classes="ProfileActionButton"
                            Command="{Binding SendMessageCommand}"
                            IsVisible="{Binding CanCall}">
                            <StackPanel VerticalAlignment="Center" Spacing="5">
                                <PathIcon HorizontalAlignment="Center" Data="{StaticResource ChatsIcon}" />
                                <TextBlock HorizontalAlignment="Center" Text="Чат" />
                            </StackPanel>
                        </Button>

                        <Button
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Classes="ProfileActionButton"
                            Command="{Binding SendMessageCommand}"
                            IsVisible="{Binding !CanCall}">
                            <StackPanel VerticalAlignment="Center" Spacing="5">
                                <PathIcon HorizontalAlignment="Center" Data="{StaticResource ChatsIcon}" />
                                <TextBlock HorizontalAlignment="Center" Text="Чат" />
                            </StackPanel>
                        </Button>

                        <Button
                            Grid.Column="1"
                            Margin="6,0,0,0"
                            Classes="ProfileActionButton"
                            Command="{Binding StartCallCommand}"
                            IsVisible="{Binding CanCall}">
                            <StackPanel VerticalAlignment="Center" Spacing="5">
                                <PathIcon HorizontalAlignment="Center" Data="{StaticResource Call}" />
                                <TextBlock HorizontalAlignment="Center" Text="Звонок" />
                            </StackPanel>
                        </Button>
                    </Grid>

                </Grid>
            </Border>

            <Border
                Grid.Row="0"
                Height="1"
                VerticalAlignment="Bottom"
                Background="{DynamicResource BorderDefault}"
                IsHitTestVisible="False" />

            <ScrollViewer
                Grid.Row="1"
                Background="{DynamicResource PrimaryBG}"
                Classes="ThinScrollbar"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8,10,8,14" Spacing="2">

                    <TextBlock
                        Margin="8,0,8,4"
                        Classes="SectionHeader"
                        Text="ИНФОРМАЦИЯ" />

                    <Button Classes="InfoRow" ToolTip.Tip="Скопировать">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                Data="{StaticResource MentionIcon}"
                                Foreground="{DynamicResource TextSecondary}" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="2">
                                <TextBlock
                                    FontSize="15"
                                    FontWeight="Medium"
                                    Foreground="{DynamicResource Accent}"
                                    Text="{Binding User.Username, StringFormat='@{0}'}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="Имя пользователя" />
                            </StackPanel>
                            <PathIcon
                                Grid.Column="2"
                                Width="14"
                                Height="14"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Classes="CopyHint"
                                Data="{StaticResource CopyIcon}"
                                Foreground="{DynamicResource TextMuted}" />
                        </Grid>
                    </Button>

                    <StackPanel IsVisible="{Binding Department, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <Border
                            Height="1"
                            Margin="46,2,8,2"
                            Background="{DynamicResource BorderDefault}" />
                        <Button Classes="InfoRow" ToolTip.Tip="Скопировать">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon
                                    Grid.Column="0"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,14,0"
                                    VerticalAlignment="Center"
                                    Data="{StaticResource OrganizationIcon}"
                                    Foreground="{DynamicResource TextSecondary}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="Medium"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Text="{Binding Department}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="Отдел" />
                                </StackPanel>
                                <PathIcon
                                    Grid.Column="2"
                                    Width="14"
                                    Height="14"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="CopyHint"
                                    Data="{StaticResource CopyIcon}"
                                    Foreground="{DynamicResource TextMuted}" />
                            </Grid>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

        </Grid>
    </Border>
</UserControl>