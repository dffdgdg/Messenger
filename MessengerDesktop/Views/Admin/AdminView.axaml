<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:admin="using:MessengerDesktop.ViewModels.Admin"
             xmlns:adminCon="using:MessengerDesktop.Views.Controls.Admin"
             xmlns:views="using:MessengerDesktop.Views"
             xmlns:controls="using:MessengerDesktop.Views.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MessengerDesktop.ViewModels"
             xmlns:conv="using:MessengerDesktop.Converters"
             x:Class="MessengerDesktop.Views.AdminView"
             x:DataType="vm:AdminViewModel"
             x:Name="Root"
             Background="{DynamicResource PrimaryBG}"
             Design.Width="1280" Design.Height="720">

    <Panel>
        <Border Classes="PageContainer">
            <Grid x:Name="MainGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" MinWidth="52" MaxWidth="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition MinWidth="400"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SecondaryBG}"
                        BorderThickness="0,0,1,0"
                        BorderBrush="{DynamicResource BorderDefault}">
                    <DockPanel>

                        <!-- Шапка -->
                        <Border DockPanel.Dock="Top" Padding="16,20,16,14">
                            <Panel>
                                <StackPanel Spacing="2"
                                            IsVisible="{Binding !IsCompactMode, ElementName=Root}">
                                    <TextBlock Text="Администрирование"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Управление системой"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>

                                <Button Classes="IconButton"
                                        IsVisible="{Binding IsCompactMode, ElementName=Root}"
                                        Click="OnExpandButtonClick"
                                        ToolTip.Tip="Развернуть"
                                        HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource MenuIcon}"
                                              Width="18" Height="18"
                                              Foreground="{DynamicResource Icon}"/>
                                </Button>
                            </Panel>
                        </Border>

                        <!-- Разделитель -->
                        <Border DockPanel.Dock="Top"
                                Height="1"
                                Background="{DynamicResource BorderDefault}"
                                Margin="12,0,12,0"
                                Opacity="0.6"/>

                        <!-- Навигация -->
                        <ScrollViewer DockPanel.Dock="Top" Margin="8,12,8,8">
                            <StackPanel Spacing="2">

                                <TextBlock Text="РАЗДЕЛЫ"
                                           Classes="CategoryHeader"
                                           IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>

                                <ListBox SelectedIndex="{Binding SelectedTabIndex}"
                                         Classes="NavMenu">

                                    <ListBoxItem ToolTip.Tip="Сотрудники">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <PathIcon Data="{StaticResource PersonIcon}"
                                                      Width="16" Height="16"/>
                                            <TextBlock Text="Сотрудники"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>
                                        </StackPanel>
                                    </ListBoxItem>

                                    <ListBoxItem ToolTip.Tip="Отделы">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <PathIcon Data="{StaticResource OrganizationIcon}"
                                                      Width="16" Height="16"/>
                                            <TextBlock Text="Отделы"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>
                                        </StackPanel>
                                    </ListBoxItem>
                                </ListBox>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- GridSplitter -->
                <GridSplitter x:Name="GridSplitter"
                              Grid.Column="1"
                              Width="6"
                              ResizeDirection="Columns"
                              Background="Transparent"
                              ResizeBehavior="PreviousAndNext">
                    <GridSplitter.Template>
                        <ControlTemplate>
                            <Border Background="Transparent">
                                <Border Width="1"
                                        CornerRadius="1"
                                        Background="{DynamicResource BorderDefault}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Stretch"
                                        Opacity="0.5"/>
                            </Border>
                        </ControlTemplate>
                    </GridSplitter.Template>
                </GridSplitter>

                <!-- ══════════════════════════════
                     ОСНОВНОЕ СОДЕРЖИМОЕ
                ══════════════════════════════ -->
                <Border Grid.Column="2"
                        Background="{DynamicResource PrimaryBG}">
                    <Grid Margin="24,24,24,0"
                          RowDefinitions="Auto,Auto,*">

                        <!-- Заголовок раздела -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,20">
                            <TextBlock FontSize="24"
                                       FontWeight="Bold"
                                       Text="{Binding SelectedTabIndex,
                                              Converter={conv:Converter Name=IndexToText},
                                              ConverterParameter='Сотрудники|Отделы'}"/>
                            <TextBlock FontSize="13"
                                       Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding SelectedTabIndex,
                                              Converter={conv:Converter Name=IndexToText},
                                              ConverterParameter='Управление учётными записями|Структура отделов организации'}"/>
                        </StackPanel>

                        <!-- Тулбар -->
                        <Grid Grid.Row="1"
                              ColumnDefinitions="*,Auto,Auto"
                              Margin="0,0,0,16">

                            <Border Background="{DynamicResource ThirdBG}"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    VerticalAlignment="Center">
                                <controls:SearchBox x:Name="SearchTextBox"
                                                    SearchText="{Binding SearchQuery}"
                                                    Watermark="Поиск..."
                                                    Classes="Borderless"/>
                            </Border>

                            <Button Grid.Column="1"
                                    Command="{Binding RefreshCommand}"
                                    Classes="IconButton"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="Обновить">
                                <PathIcon Data="{StaticResource RefreshIcon}"
                                          Width="15" Height="15"
                                          Foreground="{DynamicResource Icon}"/>
                            </Button>

                            <Button Grid.Column="2"
                                    Classes="Primary"
                                    Command="{Binding CreateCommand}"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{Binding SelectedTabIndex,
                                                  Converter={conv:Converter Name=IndexToText},
                                                  ConverterParameter='Добавить сотрудника|Создать отдел'}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <PathIcon Data="{StaticResource AddIcon}"
                                              Width="13" Height="13"
                                              Foreground="{DynamicResource TextOnAccent}"/>
                                    <TextBlock Foreground="{DynamicResource TextOnAccent}"
                                               FontWeight="SemiBold"
                                               FontSize="13"
                                               Text="{Binding SelectedTabIndex,
                                                      Converter={conv:Converter Name=IndexToText},
                                                      ConverterParameter='Добавить|Создать'}"
                                               IsVisible="{Binding !IsCompactMode, ElementName=Root}"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid Grid.Row="2">

                            <!-- Оверлей загрузки -->
                            <Border IsVisible="{Binding IsBusy}"
                                    Background="{DynamicResource PrimaryBG}"
                                    Opacity="0.85"
                                    ZIndex="10"
                                    CornerRadius="16,16,0,0"/>

                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Spacing="12"
                                        ZIndex="11"
                                        IsVisible="{Binding IsBusy}">
                                <Border Width="40" Height="40"
                                        CornerRadius="20"
                                        Background="{DynamicResource AccentMuted}"
                                        HorizontalAlignment="Center">
                                    <ProgressBar IsIndeterminate="True"
                                                 Width="20" Height="20"
                                                 Classes="Circular"
                                                 Foreground="{DynamicResource Accent}"/>
                                </Border>
                                <TextBlock Text="Загрузка..."
                                           FontSize="13"
                                           FontWeight="Medium"
                                           Foreground="{DynamicResource TextSecondary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>

                            <!-- ── Вкладка: Сотрудники ── -->
                            <Border Background="{DynamicResource SecondaryBG}"
                                    BorderThickness="1,1,1,0"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    CornerRadius="14,14,0,0"
                                    IsVisible="{Binding SelectedTabIndex,
                                                Converter={conv:Converter Name=Equality},
                                                ConverterParameter=0}">
                                <Panel>

                                    <!-- Список -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  IsVisible="{Binding HasUsers}">
                                        <ItemsControl ItemsSource="{Binding FilteredGroupedUsers}"
                                                      Margin="12,12,12,24">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="12"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="admin:DepartmentGroup">
                                                    <adminCon:DepartmentGroupView
                                                        EditUserCommand="{Binding $parent[views:AdminView].DataContext.OpenEditUserDialogCommand}"
                                                        BanUserCommand="{Binding $parent[views:AdminView].DataContext.ToggleBanCommand}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Пусто: нет результатов поиска -->
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Spacing="12"
                                                Margin="24">
                                        <StackPanel.IsVisible>
                                            <MultiBinding Converter="{conv:MultiConverter Name=BooleanAnd}">
                                                <Binding Path="!HasUsers"/>
                                                <Binding Path="!IsBusy"/>
                                                <Binding Path="SearchQuery"
                                                         Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                            </MultiBinding>
                                        </StackPanel.IsVisible>

                                        <PathIcon Data="{StaticResource SearchIcon}"
                                                  Width="40" Height="40"
                                                  Foreground="{DynamicResource TextMuted}"
                                                  Opacity="0.2"
                                                  HorizontalAlignment="Center"/>

                                        <TextBlock Text="Ничего не найдено"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="220">
                                            <Run Text="По запросу «"/>
                                            <Run Text="{Binding SearchQuery}"
                                                 FontWeight="Medium"
                                                 Foreground="{DynamicResource TextSecondary}"/>
                                            <Run Text="» сотрудников не найдено"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Panel>
                            </Border>

                            <!-- ── Вкладка: Отделы ── -->
                            <Border Background="{DynamicResource SecondaryBG}"
                                    BorderThickness="1,1,1,0"
                                    BorderBrush="{DynamicResource BorderDefault}"
                                    CornerRadius="14,14,0,0"
                                    IsVisible="{Binding SelectedTabIndex,
                                                Converter={conv:Converter Name=Equality},
                                                ConverterParameter=1}">
                                <Panel>

                                    <!-- Список -->
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                                  IsVisible="{Binding HasDepartments}">
                                        <ItemsControl ItemsSource="{Binding FilteredHierarchicalDepartments}"
                                                      Margin="12,12,12,24">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="8"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:HierarchicalDepartmentViewModel">
                                                    <adminCon:DepartmentCardView
                                                        EditCommand="{Binding $parent[views:AdminView].DataContext.OpenEditDepartmentCommand}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <!-- Пусто: нет результатов поиска -->
                                    <StackPanel VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Spacing="12"
                                                Margin="24">
                                        <StackPanel.IsVisible>
                                            <MultiBinding Converter="{conv:MultiConverter Name=BooleanAnd}">
                                                <Binding Path="!HasDepartments"/>
                                                <Binding Path="!IsBusy"/>
                                                <Binding Path="SearchQuery"
                                                         Converter="{x:Static StringConverters.IsNotNullOrEmpty}"/>
                                            </MultiBinding>
                                        </StackPanel.IsVisible>

                                        <PathIcon Data="{StaticResource SearchIcon}"
                                                  Width="40" Height="40"
                                                  Foreground="{DynamicResource TextMuted}"
                                                  Opacity="0.2"
                                                  HorizontalAlignment="Center"/>

                                        <TextBlock Text="Ничего не найдено"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   HorizontalAlignment="Center"/>

                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   MaxWidth="220">
                                            <Run Text="Отдел «"/>
                                            <Run Text="{Binding SearchQuery}"
                                                 FontWeight="Medium"
                                                 Foreground="{DynamicResource TextSecondary}"/>
                                            <Run Text="» не найден"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Panel>
                            </Border>

                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ══════════════════════════════
             ТОСТЫ / УВЕДОМЛЕНИЯ
        ══════════════════════════════ -->
        <StackPanel VerticalAlignment="Bottom"
                    HorizontalAlignment="Right"
                    Margin="20"
                    Spacing="8"
                    ZIndex="100">

            <Border Classes="Toast AlertError"
                    IsVisible="{Binding ErrorMessage,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0"
                            Width="28" Height="28"
                            CornerRadius="14"
                            Background="{DynamicResource DangerBrush}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource WarningIcon}"
                                  Width="14" Height="14"
                                  Foreground="White"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource DangerBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="Toast AlertSuccess"
                    IsVisible="{Binding SuccessMessage,
                                Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <Grid ColumnDefinitions="Auto,*">
                    <Border Grid.Column="0"
                            Width="28" Height="28"
                            CornerRadius="14"
                            Background="{DynamicResource SuccessBrush}"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center">
                        <PathIcon Data="{StaticResource CheckmarkIcon}"
                                  Width="14" Height="14"
                                  Foreground="White"/>
                    </Border>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SuccessMessage}"
                               Foreground="{DynamicResource SuccessBrush}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

        </StackPanel>

    </Panel>
    <!-- /Panel -->

</UserControl>