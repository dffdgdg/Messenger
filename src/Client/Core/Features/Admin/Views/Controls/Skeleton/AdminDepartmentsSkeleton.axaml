<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Core.Features.Admin.Views.Controls.Skeleton.AdminDepartmentsSkeleton">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="12,12,12,24">
        <StackPanel Spacing="10">
            <Border Classes="Skeleton" Height="96" CornerRadius="12" Padding="14">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="Skeleton" Width="42" Height="42" CornerRadius="10"/>
                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                            <Border Classes="Skeleton" Width="220" Height="16" CornerRadius="5" HorizontalAlignment="Left"/>
                            <Border Classes="Skeleton" Width="140" Height="12" CornerRadius="4" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <Border Grid.Column="2" Classes="Skeleton" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Classes="Skeleton" Height="96" CornerRadius="12" Padding="14" Margin="24,0,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="Skeleton" Width="42" Height="42" CornerRadius="10"/>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <Border Classes="Skeleton" Width="180" Height="16" CornerRadius="5" HorizontalAlignment="Left"/>
                        <Border Classes="Skeleton" Width="120" Height="12" CornerRadius="4" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="Skeleton" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="Skeleton" Height="96" CornerRadius="12" Padding="14">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="Skeleton" Width="42" Height="42" CornerRadius="10"/>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <Border Classes="Skeleton" Width="240" Height="16" CornerRadius="5" HorizontalAlignment="Left"/>
                        <Border Classes="Skeleton" Width="160" Height="12" CornerRadius="4" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="Skeleton" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Classes="Skeleton" Height="96" CornerRadius="12" Padding="14" Margin="24,0,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="Skeleton" Width="42" Height="42" CornerRadius="10"/>
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <Border Classes="Skeleton" Width="170" Height="16" CornerRadius="5" HorizontalAlignment="Left"/>
                        <Border Classes="Skeleton" Width="110" Height="12" CornerRadius="4" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Border Grid.Column="2" Classes="Skeleton" Width="28" Height="28" CornerRadius="14" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>