<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:vm="using:MessengerDesktop.ViewModels.Call"
			 xmlns:controls="using:MessengerDesktop.Views.Controls"
			 xmlns:conv="using:MessengerDesktop.Converters"
			 x:Class="MessengerDesktop.Views.Call.CallView"
			 x:DataType="vm:CallViewModel">

	<Border Classes="PageContainer" Margin="0">
		<Grid RowDefinitions="Auto,*,Auto">

			<Border Grid.Row="0" Padding="24,18">
				<Grid ColumnDefinitions="*,Auto,*">

					<StackPanel Orientation="Horizontal" Grid.Column="1" Spacing="12">

						<Border Background="{DynamicResource HoverOverlay}" CornerRadius="8" Padding="12,8">
							<StackPanel HorizontalAlignment="Center" Spacing="8" Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="{Binding ChatName}"
										   Classes="ChatName"
										   FontSize="15"
										   VerticalAlignment="Center"/>
								<TextBlock Text="{Binding DurationText}"
										   Classes="TextSecondary"
										   FontSize="13"
										   VerticalAlignment="Center"/>
							</StackPanel>
						</Border>

						<Border Background="{DynamicResource HoverOverlay}" CornerRadius="8" Padding="12,8">
							<StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
								<Path Data="{StaticResource PeopleIcon}"
									  Width="14" Height="14"
									  Stretch="Uniform"
									  Fill="{DynamicResource TextSecondary}"/>
								<TextBlock Text="{Binding Participants.Count}"
										   Classes="TextSecondary"
										   FontSize="13"
										   FontWeight="SemiBold"
										   VerticalAlignment="Center"/>
							</StackPanel>
						</Border>
					</StackPanel>

					<Button Grid.Column="2"
							Command="{Binding CloseUiCommand}"
							Classes="IconButton"
							ToolTip.Tip="Свернуть"
							HorizontalAlignment="Right"
							VerticalAlignment="Center">
						<Path Data="{StaticResource ChevronIcon}"
							  Width="16" Height="16"
							  Stretch="Uniform"
							  Fill="{DynamicResource TextSecondary}"/>
					</Button>

				</Grid>
			</Border>

			<Grid Grid.Row="1">
				<ItemsControl ItemsSource="{Binding Participants}"
							  HorizontalAlignment="Stretch"
							  VerticalAlignment="Stretch"
							  Margin="16">

					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<UniformGrid Columns="{Binding GridColumns}"
										 Rows="{Binding GridRows}"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate DataType="vm:CallParticipantViewModel">
							<Border Classes="CallTile"
									Classes.Speaking="{Binding IsSpeaking}"
									Background="{DynamicResource ThirdBG}"
									CornerRadius="16"
									Margin="4"
									ClipToBounds="True">
								<Grid>

									<!-- Аватар — Size из родительского VM -->
									<controls:AvatarControl
    Size="{Binding AvatarSize}"
    Source="{Binding AvatarUrl}"
    DisplayName="{Binding DisplayName}"
    ShowOnlineIndicator="False"
    HorizontalAlignment="Center"
    VerticalAlignment="Center"/>

									<!-- Нижняя плашка -->
									<Border Padding="10,7"
											HorizontalAlignment="Left"
											VerticalAlignment="Bottom"
											Background="#B2000000"
											Margin="12"
											CornerRadius="8"
											MaxWidth="200">
										<StackPanel Orientation="Horizontal"
													Spacing="7"
													VerticalAlignment="Center">
											<Ellipse Width="7" Height="7"
													 Fill="{DynamicResource Accent}"
													 VerticalAlignment="Center"
													 IsVisible="{Binding IsSpeaking}"/>
											<TextBlock Text="{Binding DisplayName}"
													   FontSize="13"
													   FontWeight="Medium"
													   Foreground="White"
													   TextTrimming="CharacterEllipsis"
													   MaxLines="1"/>
										</StackPanel>
									</Border>

									<!-- Mute badge -->
									<Border IsVisible="{Binding IsMuted}"
											Background="{DynamicResource DangerBrush}"
											Width="28" Height="28"
											CornerRadius="14"
											HorizontalAlignment="Right"
											VerticalAlignment="Top"
											Margin="12"
											BoxShadow="0 2 6 0 #40000000">
										<TextBlock Text="🔇"
												   FontSize="12"
												   HorizontalAlignment="Center"
												   VerticalAlignment="Center"/>
									</Border>

								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Grid>

			<Border Grid.Row="2"
					HorizontalAlignment="Center"
					Margin="0,0,0,32"
					Padding="24,16"
					CornerRadius="40"
					Background="{DynamicResource SecondaryBG}"
					BorderBrush="{DynamicResource ControlBorder}"
					BorderThickness="1"
					BoxShadow="0 4 12 0 #1A000000">

				<StackPanel Orientation="Horizontal" Spacing="24">

					<Button Command="{Binding ToggleMuteCommand}"
							Classes="IconButton"
							Classes.Active="{Binding IsMuted}"
							Width="56" Height="56" CornerRadius="28" Padding="0"
							ToolTip.Tip="{Binding IsMuted, Converter={conv:Converter Name=BoolToString}, ConverterParameter='Включить микрофон|Выключить микрофон'}">

						<Path Data="{Binding IsMuted, Converter={conv:Converter Name=BoolToGeometry}, ConverterParameter='M3.28 2.22a.75.75 0 1 0-1.06 1.06L8 9.06V12a4 4 0 0 0 6.248 3.309l1.146 1.146A5.227 5.227 0 0 1 12.25 17.5h-.5l-.216-.004A5.25 5.25 0 0 1 6.5 12.25v-.5l-.007-.102A.75.75 0 0 0 5 11.75v.5l.004.236a6.75 6.75 0 0 0 6.246 6.496v2.268l.007.102a.75.75 0 0 0 1.493-.102l.001-2.268a6.718 6.718 0 0 0 3.712-1.458l4.256 4.256a.75.75 0 0 0 1.061-1.06L3.28 2.22ZM17.196 14.014l1.146 1.146A6.725 6.725 0 0 0 19 12.25v-.5l-.007-.102a.75.75 0 0 0-1.493.102v.5l-.004.216a5.233 5.233 0 0 1-.3 1.548ZM8.138 4.956l7.792 7.792c.046-.242.07-.492.07-.748V6a4 4 0 0 0-7.862-1.044Z|M18.25 11a.75.75 0 0 1 .743.648l.007.102v.5a6.75 6.75 0 0 1-6.249 6.732l-.001 2.268a.75.75 0 0 1-1.493.102l-.007-.102v-2.268a6.75 6.75 0 0 1-6.246-6.496L5 12.25v-.5a.75.75 0 0 1 1.493-.102l.007.102v.5a5.25 5.25 0 0 0 5.034 5.246l.216.004h.5a5.25 5.25 0 0 0 5.246-5.034l.004-.216v-.5a.75.75 0 0 1 .75-.75ZM12 2a4 4 0 0 1 4 4v6a4 4 0 0 1-8 0V6a4 4 0 0 1 4-4Z'}"
							  Fill="{DynamicResource TextPrimary}"
							  Stretch="Uniform"
							  Margin="12"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"/>
					</Button>

					<Button Command="{Binding LeaveCallCommand}"
							Classes="IconButton Danger"
							Background="{DynamicResource DangerBrush}"
							Width="56" Height="56" CornerRadius="28" Padding="0">
						<Path Data="{StaticResource DeclineCallIcon}"
							  Fill="White"
							  Stretch="Uniform"
							  Margin="12"
							  HorizontalAlignment="Center"
							  VerticalAlignment="Center"/>
					</Button>

				</StackPanel>
			</Border>

		</Grid>
	</Border>
</UserControl>