<UserControl x:Name="Root"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmDialog="using:Desktop.ViewModels.Dialog"
             xmlns:conv="clr-namespace:Desktop.Converters;assembly=Desktop"
             xmlns:controls="using:Desktop.Views.Controls"
             x:Class="Desktop.Views.ChatEditDialog"
             x:DataType="vmDialog:ChatEditDialogViewModel">

    <Border Classes="DialogContainer"
            Background="{DynamicResource SecondaryBG}">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

            <!-- Шапка: аватар + название -->
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*"
                  Margin="24,24,24,16">

                <Panel Classes="AvatarEditContainer"
                       Width="80" Height="80"
                       Margin="0,0,16,0">
                    <controls:AvatarControl Classes="XLarge"
                                            ImageBitmap="{Binding AvatarPreview}"
                                            FallbackIcon="{StaticResource GroupIcon}"
                                            ShowOnlineIndicator="False"
                                            PlaceholderBackground="{DynamicResource SurfaceVariant}"
                                            PlaceholderForeground="White"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                    <Button Classes="AvatarEditOverlay"
                            Width="80" Height="80"
                            CornerRadius="40"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Command="{Binding SelectAvatarCommand}"
                            ToolTip.Tip="Изменить аватар">
                        <Border Classes="AvatarOverlay"
                                Width="80" Height="80"
                                CornerRadius="40"
                                Background="#66000000">
                            <PathIcon Data="{StaticResource CameraIcon}"
                                      Width="22" Height="22"
                                      Foreground="White"/>
                        </Border>
                    </Button>
                    <Button Classes="AvatarDeleteBadge"
                            Width="22" Height="22"
                            CornerRadius="11"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Command="{Binding ClearAvatarCommand}"
                            IsVisible="{Binding AvatarPreview,
                                Converter={x:Static ObjectConverters.IsNotNull}}"
                            ToolTip.Tip="Удалить аватар">
                        <Path Data="{StaticResource CloseIcon}"
                              Width="8" Height="8"
                              Stretch="Uniform"
                              Fill="White"/>
                    </Button>
                </Panel>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="8">
                    <TextBlock Text="{Binding Title}"
                               FontWeight="Bold"
                               FontSize="18"/>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Название группы"
                                   FontWeight="DemiBold"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}"/>
                        <TextBox Text="{Binding Name}"
                                 PlaceholderText="Введите название..."
                                 Classes="Input"
                                 MaxLength="100"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Разделитель -->
            <Border Grid.Row="1" Classes="DialogDivider"/>

            <!-- Тело -->
            <ScrollViewer Grid.Row="2"
                          Classes="ThinScrollbar"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="24,16,24,16">

                    <TextBlock Text="УПРАВЛЕНИЕ"
                               Classes="CategoryHeader"
                               Margin="0"/>

                    <Border Classes="Section" Padding="4">
                        <StackPanel Spacing="0">
                            <Button Classes="MemberItem"
                                    Command="{Binding ManageParticipantsCommand}"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <PathIcon Data="{StaticResource GroupIcon}"
                                              Width="20" Height="20"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Участники"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                    <Border Grid.Column="2"
                                            Classes="CountBadge"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding ParticipantsCount}"/>
                                    </Border>
                                    <Path Grid.Column="3"
                                          Data="{StaticResource ChevronRightIcon}"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource TextMuted}"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Button>

                            <Border Height="1"
                                    Background="{DynamicResource BorderDefault}"
                                    Margin="40,0,12,0"/>

                            <Button Classes="MemberItem"
                                    Command="{Binding ManageAdminsCommand}"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                    <PathIcon Data="{StaticResource ShieldIcon}"
                                              Width="20" Height="20"/>
                                    <TextBlock Grid.Column="1"
                                               Text="Администраторы"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               VerticalAlignment="Center"
                                               Margin="12,0,0,0"/>
                                    <Border Grid.Column="2"
                                            Classes="CountBadge"
                                            VerticalAlignment="Center"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding AdminsCount}"/>
                                    </Border>
                                    <Path Grid.Column="3"
                                          Data="{StaticResource ChevronRightIcon}"
                                          Width="12" Height="12"
                                          Stretch="Uniform"
                                          Fill="{DynamicResource TextMuted}"
                                          VerticalAlignment="Center"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Роль -->
                    <Border CornerRadius="8"
                            Padding="12,8"
                            Background="{DynamicResource ThirdBG}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderDefault}">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <PathIcon Data="{StaticResource UserRoleIcon}"
                                      Width="16" Height="16"/>
                            <TextBlock Grid.Column="1"
                                       Text="Ваша роль"
                                       FontSize="13"
                                       Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                            <Border Grid.Column="2"
                                    Background="{DynamicResource AccentMuted}"
                                    CornerRadius="6"
                                    Padding="10,3">
                                <TextBlock Text="{Binding CurrentUserRoleDisplay}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Настройки -->
                    <StackPanel Spacing="12"
                                IsVisible="{Binding ShowDeleteGroupOption}">
                        <TextBlock Text="НАСТРОЙКИ"
                                   Classes="CategoryHeader"
                                   Margin="0,8,0,0"/>
                        <Border Classes="Section" Padding="4">
                            <Border Padding="12,10" CornerRadius="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <PathIcon Data="{StaticResource HistoryIcon}"
                                              Width="20" Height="20"/>
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="12,0,12,0"
                                                Spacing="2">
                                        <TextBlock Text="История для новых участников"
                                                   FontWeight="SemiBold"
                                                   FontSize="14"/>
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="2"
                                                  VerticalAlignment="Center"
                                                  OnContent="" OffContent=""
                                                  IsChecked="{Binding ShowHistoryForNewMembers}"
                                                  IsEnabled="{Binding CanManageParticipants}" />
                                </Grid>
                            </Border>
                        </Border>
                    </StackPanel>

                    <!-- Удалить группу -->
                    <Border CornerRadius="12"
                            Padding="4"
                            Background="{DynamicResource ThirdBG}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource DangerBorderBrush}"
                            IsVisible="{Binding !IsNewChat}">
                        <Button Classes="MemberItem" Padding="12,10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <PathIcon Data="{StaticResource DeleteIcon}"
                                          Width="20" Height="20"
                                          Foreground="{DynamicResource DangerBrush}"/>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="12,0,0,0"
                                            Spacing="2">
                                    <TextBlock Text="Удалить группу"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               Foreground="{DynamicResource DangerBrush}"/>
                                </StackPanel>
                                <Path Grid.Column="2"
                                      Data="{StaticResource ChevronRightIcon}"
                                      Width="12" Height="12"
                                      Stretch="Uniform"
                                      Fill="{DynamicResource DangerBrush}"
                                      Opacity="0.6"
                                      VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Разделитель -->
            <Border Grid.Row="3" Classes="DialogDivider"/>

            <!-- Футер -->
            <Grid Grid.Row="4"
                  ColumnDefinitions="*,Auto,Auto"
                  Margin="24,16,24,24">

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource ErrorColor}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage,
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                    <TextBlock Text="{Binding SuccessMessage}"
                               Foreground="{DynamicResource SuccessColor}"
                               TextWrapping="Wrap"
                               IsVisible="{Binding SuccessMessage,
                                   Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>

                <Button Grid.Column="1"
                        Content="Отмена"
                        Classes="DialogOutline"
                        Command="{Binding CancelCommand}"
                        MinWidth="100"
                        Margin="0,0,12,0"/>

                <Button Grid.Column="2"
                        Classes="DialogAccent"
                        Content="{Binding IsNewChat,
                            Converter={conv:Converter Name=BoolToString},
                            ConverterParameter='Создать|Сохранить'}"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        MinWidth="100"/>
            </Grid>

        </Grid>
    </Border>
</UserControl>