<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:parts="using:MessengerDesktop.Views.Chat.MessageParts.Shared"
             xmlns:vmChat="using:MessengerDesktop.ViewModels.Chat"
             x:Class="MessengerDesktop.Views.Chat.MessageParts.DeletedMessagePart"
             x:DataType="vmChat:MessageViewModel">

    <StackPanel IsVisible="{Binding IsDeleted}">
        <TextBlock Text="{Binding DisplayContent}"
                   FontStyle="Italic"
                   Foreground="{DynamicResource TextSecondary}"
                   TextWrapping="Wrap"
                   FontSize="15"
                   LineHeight="22"/>
        <parts:MessageMetaBlock
            HorizontalAlignment="Right"
            Margin="0,-2,0,0"
            Opacity="0.7"/>
    </StackPanel>
</UserControl>