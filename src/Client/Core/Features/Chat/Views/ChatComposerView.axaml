<UserControl
    x:Class="Core.Features.Chat.Views.ChatComposerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Core.Shared.Controls"
    xmlns:conv="using:Core.Shared.Converters"
    xmlns:managers="using:Core.Features.Chat.ViewModels.Managers"
    xmlns:messages="using:Core.Features.Chat.ViewModels.Messages"
    xmlns:vm="using:Core.Features.Chat.ViewModels"
    xmlns:voice="using:Core.Features.Chat.ViewModels.Voice"
    x:DataType="vm:ChatViewModel">

    <UserControl.Styles>
        <Style Selector="Button.MentionItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Button.MentionItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.MentionItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverOverlay}" />
        </Style>
        <Style Selector="Button.MentionItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderHover}" />
        </Style>

        <Style Selector="Border.AttachmentPreView">
            <Setter Property="Background" Value="{DynamicResource PrimaryBG}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10" />
        </Style>
        <Style Selector="Border.EditModePanel">
            <Setter Property="Background" Value="{DynamicResource PrimaryBG}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="TextBox.ChatInput">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,12" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="MaxHeight" Value="400" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
        </Style>
        <Style Selector="TextBox.ChatInput /template/ Border,
        TextBox.ChatInput:focus-within /template/ Border,
        TextBox.ChatInput:pointerover /template/ Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </UserControl.Styles>

    <Border Padding="16,0,16,20" VerticalAlignment="Bottom">
        <Grid>
            <Popup
                x:Name="MentionPopup"
                IsLightDismissEnabled="False"
                IsOpen="{Binding Composer.IsMentionSuggestionsOpen}"
                Placement="TopEdgeAlignedLeft"
                PlacementTarget="{Binding #InputRow}"
                HorizontalOffset="0"
                VerticalOffset="-8">
                <Border
                    MinWidth="240"
                    MaxWidth="420"
                    Padding="4,6"
                    Background="{DynamicResource SecondaryBG}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="10"
                    BoxShadow="0 4 24 0 #28000000">
                    <ScrollViewer MaxHeight="200" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Composer.MentionSuggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Classes="MentionItem"
                                        Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).SelectMentionCommand}"
                                        CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                            <controls:AvatarControl
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Classes="Small"
                                                DisplayName="{Binding DisplayName}"
                                                ShowOnlineIndicator="False"
                                                Source="{Binding Avatar}" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding DisplayName}"
                                                    IsVisible="{Binding DisplayName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Text="{Binding Username}"
                                                    IsVisible="{Binding DisplayName, Converter={x:Static StringConverters.IsNullOrEmpty}}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextSecondary}"
                                                    IsVisible="{Binding Username, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                    Text="{Binding Username, StringFormat='@{0}'}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Popup>

            <Grid x:Name="InputRow" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                <Border Grid.Row="0" Classes="EditModePanel" IsVisible="{Binding EditDelete.IsEditMode}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="4" Margin="0,0,12,0" Background="{DynamicResource Accent}" CornerRadius="2" />
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Text="Редактирование" />
                            <ContentControl MinHeight="0" Padding="0" BorderThickness="0" Content="{Binding EditDelete.EditingMessage}">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate x:DataType="messages:MessageViewModel">
                                        <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" MaxLines="2" Text="{Binding Content}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="IconButton Small" Command="{Binding EditDelete.CancelEditCommand}" ToolTip.Tip="Отменить редактирование">
                            <PathIcon Width="14" Height="14" Data="{StaticResource CloseIcon}" Foreground="{DynamicResource TextSecondary}" />
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Classes="EditModePanel" IsVisible="{Binding Reply.IsReplyMode}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Border Grid.Column="0" Width="4" Margin="0,0,12,0" Background="{DynamicResource Accent}" CornerRadius="2" />
                        <ContentControl Grid.Column="1" MinHeight="0" Padding="0" BorderThickness="0" Content="{Binding Reply.ReplyingToMessage}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="messages:MessageViewModel">
                                    <StackPanel Spacing="2">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" Text="{Binding SenderName, StringFormat='Ответ для {0}'}" />
                                        <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondary}" MaxLines="2" Text="{Binding ContentPreView}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <Button Grid.Column="2" Classes="IconButton Small" Command="{Binding Reply.CancelReplyCommand}" ToolTip.Tip="Отменить ответ">
                            <PathIcon Width="14" Height="14" Data="{StaticResource CloseIcon}" Foreground="{DynamicResource TextSecondary}" />
                        </Button>
                    </Grid>
                </Border>

                <ItemsControl Grid.Row="3" Margin="0,0,0,8" IsVisible="{Binding Attachments.Attachments.Count}" ItemsSource="{Binding Attachments.Attachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Classes="AttachmentPreView">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Grid.Column="0" Width="44" Height="44" Background="{DynamicResource SecondaryBG}" ClipToBounds="True" CornerRadius="8">
                                        <Panel>
                                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNull}}" Text="📎" />
                                            <Image IsVisible="{Binding Thumbnail, Converter={x:Static ObjectConverters.IsNotNull}}" Source="{Binding Thumbnail}" />
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding FileSizeFormatted}" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Classes="IconButton Small" Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).RemoveAttachmentCommand}" CommandParameter="{Binding}" ToolTip.Tip="Удалить">                                        
                                        <PathIcon Width="14" Height="14" Data="{StaticResource CloseIcon}" Foreground="{DynamicResource TextSecondary}" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="4" Margin="0,0,0,8" Padding="12,10" Background="{DynamicResource PrimaryBG}" CornerRadius="12" IsVisible="{Binding Voice.IsVoiceRecording}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <Ellipse Grid.Column="0" Width="12" Height="12" Margin="0,0,10,0" VerticalAlignment="Center" Fill="#FF4444">
                            <Ellipse.Styles>
                                <Style Selector="Ellipse">
                                    <Style.Animations>
                                        <Animation IterationCount="INFINITE" Duration="0:0:1">
                                            <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                                            <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.3" /></KeyFrame>
                                            <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                                        </Animation>
                                    </Style.Animations>
                                </Style>
                            </Ellipse.Styles>
                        </Ellipse>
                        <ContentControl Grid.Column="1" MinHeight="0" Margin="0,0,12,0" Padding="0" VerticalContentAlignment="Center" BorderThickness="0" Content="{Binding Voice.VoiceRecording}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate x:DataType="voice:VoiceRecordingViewModel">
                                    <TextBlock VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding ElapsedFormatted}" />
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="Запись голосового сообщения..." />
                        <Button Grid.Column="3" Classes="IconButton Small" Command="{Binding Voice.CancelRecordingCommand}" ToolTip.Tip="Отменить запись">
                            <PathIcon Width="16" Height="16" Data="{StaticResource CloseIcon}" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="4" Margin="0,0,0,8" Padding="12,10" Background="{DynamicResource PrimaryBG}" CornerRadius="12" IsVisible="{Binding Voice.IsVoiceSending}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" FontSize="16" Text="📤" />
                        <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="Отправка голосового сообщения..." />
                        <Button Classes="IconButton Small" Command="{Binding Voice.CancelRecordingCommand}" ToolTip.Tip="Отменить отправку">
                            <PathIcon Width="14" Height="14" Data="{StaticResource CloseIcon}" Foreground="{DynamicResource DangerBrush}" />
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Margin="0,0,0,8" Padding="10,8" Background="#33FF4444" CornerRadius="10" IsVisible="{Binding Voice.VoiceError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <TextBlock FontSize="12" Foreground="{DynamicResource DangerBrush}" Text="{Binding Voice.VoiceError}" TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="5" Background="{DynamicResource PrimaryBG}" BoxShadow="0 4 20 0 #18000000" CornerRadius="14" IsVisible="{Binding !Voice.IsVoiceRecording}">
                    <Grid Margin="4" ColumnDefinitions="Auto,*,Auto,Auto,Auto">
                        <Button Grid.Column="0" Width="44" Height="44" Classes="IconButton" Command="{Binding AttachFileCommand}" CornerRadius="10" IsVisible="{Binding !EditDelete.IsEditMode}" ToolTip.Tip="Прикрепить файл">
                            <Path Width="20" Height="20" Data="{StaticResource AttachIcon}" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" />
                        </Button>

                        <TextBox x:Name="ComposerTextBox" Grid.Column="1" Classes="ChatInput" IsVisible="{Binding !EditDelete.IsEditMode}" KeyDown="ComposerTextBox_OnKeyDown" KeyUp="ComposerTextBox_OnKeyUp" PlaceholderText="Сообщение..." PointerReleased="ComposerTextBox_OnPointerReleased" Text="{Binding Composer.NewMessage, Mode=TwoWay}">
                            <TextBox.KeyBindings>
                                <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Enter" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <TextBox Grid.Column="1" Classes="ChatInput" IsVisible="{Binding EditDelete.IsEditMode}" PlaceholderText="Редактирование..." Text="{Binding EditDelete.EditMessageContent, Mode=TwoWay}">
                            <TextBox.KeyBindings>
                                <KeyBinding Command="{Binding SendMessageCommand}" Gesture="Enter" />
                            </TextBox.KeyBindings>
                        </TextBox>

                        <Button Grid.Column="2" Width="44" Height="44" VerticalAlignment="Bottom" Classes="IconButton" CornerRadius="10" ToolTip.Tip="Эмодзи">
                            <Button.Flyout>
                                <Flyout FlyoutPresenterClasses="EmojiPickerFlyout" Placement="TopEdgeAlignedRight" ShowMode="TransientWithDismissOnPointerMoveAway">
                                    <StackPanel Width="300" Spacing="6">
                                        <TextBlock Margin="4,0,0,2" Classes="CategoryHeader" Text="ЭМОДЗИ" />
                                        <ItemsControl ItemsSource="{Binding Composer.PopularEmojis}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Classes="EmojiButton" Command="{Binding $parent[UserControl].((vm:ChatViewModel)DataContext).InsertEmojiCommand}" CommandParameter="{Binding}" Content="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Path Width="20" Height="20" Data="{StaticResource EmojiIcon}" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" />
                        </Button>

                        <Button Grid.Column="3" Width="44" Height="44" VerticalAlignment="Bottom" Classes="IconButton" Command="{Binding Voice.StartRecordingCommand}" CornerRadius="10" IsVisible="{Binding Composer.ShowVoiceMessageButton}" ToolTip.Tip="Записать голосовое сообщение">
                            <Path Width="20" Height="20" Data="{StaticResource MicrophoneIcon}" Fill="{DynamicResource TextSecondary}" Stretch="Uniform" />
                        </Button>

                        <Button Grid.Column="3" Width="36" Height="36" Margin="4" Padding="0" VerticalAlignment="Bottom" Classes="Primary" Command="{Binding SendMessageCommand}" CornerRadius="10" IsVisible="{Binding Composer.ShowSendMessageButton}" ToolTip.Tip="Отправить">
                            <Path Width="18" Height="18" Data="{StaticResource SendIcon}" Fill="White" Stretch="Uniform" />
                        </Button>

                        <Button Grid.Column="4" Width="36" Height="36" Margin="4" Padding="0" VerticalAlignment="Bottom" Classes="Primary" Command="{Binding SendMessageCommand}" CornerRadius="10" IsVisible="{Binding EditDelete.IsEditMode}" ToolTip.Tip="Сохранить">
                            <Path Width="18" Height="18" Data="{StaticResource CheckmarkIcon}" Fill="White" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Row="5" Background="{DynamicResource PrimaryBG}" BoxShadow="0 4 20 0 #18000000" CornerRadius="14" IsVisible="{Binding Voice.IsVoiceRecording}">
                    <Grid Margin="4" ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Margin="12,0" VerticalAlignment="Center" FontSize="14" Foreground="{DynamicResource TextSecondary}" Text="Нажмите для отправки →" />
                        <Button Grid.Column="1" Width="44" Height="44" Margin="4" Padding="0" Classes="Primary" Command="{Binding Voice.StopAndSendCommand}" CornerRadius="10" ToolTip.Tip="Остановить и отправить">
                            <Path Width="20" Height="20" Data="{StaticResource SendIcon}" Fill="White" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>

            </Grid>
        </Grid>
    </Border>
</UserControl>