<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:admin="using:MessengerDesktop.ViewModels.Admin"
             xmlns:adminCon="using:MessengerDesktop.Views.Controls.Admin"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MessengerDesktop.Views.Controls.Admin"
             xmlns:user="using:MessengerShared.Dto.User"
             x:Class="MessengerDesktop.Views.Controls.Admin.DepartmentGroupView"
             x:DataType="admin:DepartmentGroup">

    <StackPanel Spacing="4">

        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center">
                <Border Width="32" Height="32"
                        CornerRadius="8"
                        Background="{DynamicResource ThirdBG}">
                    <PathIcon Data="{StaticResource OrganizationIcon}"
                              Width="14" Height="14"
                              Foreground="{DynamicResource TextSecondary}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="{Binding DepartmentName}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>

                <Border CornerRadius="10"
                        Background="{DynamicResource AccentMuted}"
                        Padding="8,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Users.Count}"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="{DynamicResource Accent}"/>
                </Border>
            </StackPanel>

            <Border Grid.Column="1"
                    Height="1"
                    Background="{DynamicResource BorderDefault}"
                    Margin="16,0,0,0"
                    Opacity="0.4"
                    VerticalAlignment="Center"/>
        </Grid>

        <Border Background="{DynamicResource ThirdBG}"
                CornerRadius="12"
                Padding="4">
            <ListBox ItemsSource="{Binding Users}"
                     Background="Transparent"
                     BorderThickness="0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="user:UserDto">
                        <local:UserCardView
                            EditCommand="{Binding $parent[adminCon:DepartmentGroupView].EditUserCommand}"
                            BanCommand="{Binding $parent[adminCon:DepartmentGroupView].BanUserCommand}"
                            DeleteCommand="{Binding $parent[adminCon:DepartmentGroupView].DeleteUserCommand}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </StackPanel>
</UserControl>