<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MessengerDesktop.Views.Controls.Admin"
             xmlns:user="using:MessengerShared.Dto.User"
             x:Class="MessengerDesktop.Views.Controls.Admin.UserCardView"
             x:DataType="user:UserDto">

    <Border Classes="Hoverable HoverActions"
            CornerRadius="12"
            Padding="16,12"
            Background="Transparent" 
            Margin="0,0,0,4">
        <Border.Transitions>
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.2"/>
            </Transitions>
        </Border.Transitions>

        <Border.Styles>
            <Style Selector="Border.Hoverable:pointerover">
                <Setter Property="Background" Value="{DynamicResource SecondaryBG}" />
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </Border.Styles>

        <Grid ColumnDefinitions="Auto,*,Auto">
            
            <Grid Width="42" Height="42" Margin="0,0,16,0">
                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="21"
                        BoxShadow="0 2 4 0 #0D000000">
                    <PathIcon Data="{StaticResource PersonIcon}"
                              Width="20" Height="20"
                              Foreground="{DynamicResource TextSecondary}"/>
                </Border>

                <Border Width="12" Height="12"
                        CornerRadius="6"
                        Background="{DynamicResource DangerBrush}"
                        BorderBrush="{DynamicResource PrimaryBG}"
                        BorderThickness="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        IsVisible="{Binding IsBanned}"
                        ToolTip.Tip="Аккаунт заблокирован"/>
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                <TextBlock Text="{Binding DisplayName}"
                           FontWeight="Bold"
                           FontSize="15"
                           Foreground="{DynamicResource TextPrimary}"/>

                <TextBlock Text="{Binding Username, StringFormat='@{0}'}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="13"/>

                <Border Background="{DynamicResource DangerSubtle}"
                        CornerRadius="6" Padding="8,2"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsBanned}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource BlockIcon}" Width="10" Height="10" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="Заблокирован" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Classes="Actions" VerticalAlignment="Center">
                <Button Classes="IconButton Small" Command="{Binding $parent[local:UserCardView].EditCommand}" CommandParameter="{Binding .}" ToolTip.Tip="Редактировать">
                    <PathIcon Data="{StaticResource EditIcon}" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}"/>
                </Button>

                <Button Classes="IconButton Small" Command="{Binding $parent[local:UserCardView].BanCommand}" CommandParameter="{Binding .}" ToolTip.Tip="Блокировка">
                    <Panel>
                        <PathIcon Data="{StaticResource BlockIcon}" Width="16" Height="16" Foreground="{DynamicResource DangerBrush}" IsVisible="{Binding !IsBanned}"/>
                        <PathIcon Data="{StaticResource UnblockIcon}" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" IsVisible="{Binding IsBanned}"/>
                    </Panel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>