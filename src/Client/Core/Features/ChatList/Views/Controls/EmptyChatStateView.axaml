<UserControl
    x:Class="Core.Features.ChatList.Views.Controls.EmptyChatStateView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
        <PathIcon
            Width="64"
            Height="64"
            Data="{StaticResource ChatOutlineIcon}"
            Foreground="{DynamicResource TextMuted}"
            Opacity="0.5" />

        <TextBlock
            Margin="0,16,0,0"
            HorizontalAlignment="Center"
            FontSize="18"
            FontWeight="Medium"
            Foreground="{DynamicResource TextMuted}"
            Text="Выберите чат" />

        <TextBlock
            HorizontalAlignment="Center"
            FontSize="14"
            Foreground="{DynamicResource TextMuted}"
            Opacity="0.7"
            Text="или начните новый диалог" />
    </StackPanel>
</UserControl>