<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MessengerDesktop.Views.Controls.Admin"
             xmlns:user="using:MessengerShared.Dto.User"
             x:Class="MessengerDesktop.Views.Controls.Admin.UserCardView"
             x:DataType="user:UserDto">

    <Border Classes="Hoverable HoverActions"
            CornerRadius="8"
            Padding="12,10">

        <Grid ColumnDefinitions="Auto,*,Auto">

            <Grid Width="40" Height="40" Margin="0,0,12,0">

                <Border Background="{DynamicResource CardBgBrush}"
                        CornerRadius="20">
                    <PathIcon Data="{StaticResource PersonIcon}"
                              Width="18" Height="18"
                              Foreground="{DynamicResource TextSecondary}"/>
                </Border>

                <Border Width="11" Height="11"
                        CornerRadius="6"
                        Background="{DynamicResource DangerBrush}"
                        BorderBrush="{DynamicResource SecondaryBG}"
                        BorderThickness="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        IsVisible="{Binding IsBanned}"
                        ToolTip.Tip="Аккаунт заблокирован"/>
            </Grid>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">

                <TextBlock Text="{Binding DisplayName}"
                           FontWeight="SemiBold"
                           FontSize="14"/>

                <TextBlock Text="{Binding Username, StringFormat='@{0}'}"
                           Foreground="{DynamicResource TextSecondary}"
                           FontSize="12"/>

                <Border Background="{DynamicResource DangerSubtle}"
                        CornerRadius="4"
                        Padding="6,2"
                        Margin="0,3,0,0"
                        HorizontalAlignment="Left"
                        IsVisible="{Binding IsBanned}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <PathIcon Data="{StaticResource BlockIcon}"
                                  Width="10" Height="10"
                                  Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="Заблокирован"
                                   FontSize="11"
                                   Foreground="{DynamicResource DangerBrush}"/>
                    </StackPanel>
                </Border>

            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="4"
                        Classes="Actions"
                        VerticalAlignment="Center">

                <Button Classes="IconButton Small"
                        Command="{Binding $parent[local:UserCardView].EditCommand}"
                        CommandParameter="{Binding .}"
                        ToolTip.Tip="Редактировать профиль">
                    <PathIcon Data="{StaticResource EditIcon}"
                              Width="14" Height="14"
                              Foreground="{DynamicResource Icon}"/>
                </Button>

                <Button Classes="IconButton Small"
                        Command="{Binding $parent[local:UserCardView].BanCommand}"
                        CommandParameter="{Binding .}"
                        ToolTip.Tip="Заблокировать / Разблокировать">
                    <Panel>
                        <PathIcon Data="{StaticResource BlockIcon}"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource DangerBrush}"
                                  IsVisible="{Binding !IsBanned}"/>
                        <PathIcon Data="{StaticResource UnblockIcon}"
                                  Width="14" Height="14"
                                  Foreground="{DynamicResource SuccessBrush}"
                                  IsVisible="{Binding IsBanned}"/>
                    </Panel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>