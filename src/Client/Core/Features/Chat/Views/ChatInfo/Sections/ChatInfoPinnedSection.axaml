<UserControl
    x:Class="Core.Features.Chat.Views.ChatInfo.Sections.ChatInfoPinnedSection"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:messages="using:Core.Features.Chat.ViewModels.Messages"
    xmlns:vm="using:Core.Features.Chat.ViewModels"
    x:DataType="vm:ChatViewModel">
    <StackPanel Spacing="4">
        <ItemsControl
            ItemsSource="{Binding Pinned.PinnedMessages}"
            Tag="{Binding OpenInfoSectionMessageCommand}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="messages:MessageViewModel">
                    <Button Classes="InfoRow" Command="{Binding $parent[ItemsControl].Tag}" CommandParameter="{Binding}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Border Width="36" Height="36" VerticalAlignment="Center" Background="{DynamicResource SurfaceBrush}" CornerRadius="8">
                                <PathIcon Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{StaticResource PinIcon}" Foreground="{DynamicResource Accent}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontSize="13" FontWeight="Medium" Text="{Binding SenderName}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" MaxLines="1" Text="{Binding ContentPreView}" TextTrimming="CharacterEllipsis" />
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMuted}" Text="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <StackPanel Classes="EmptyState" IsVisible="{Binding !Pinned.PinnedMessages.Count}">
            <PathIcon Width="32" Height="32" HorizontalAlignment="Center" Data="{StaticResource PinIcon}" Foreground="{DynamicResource TextMuted}" />
            <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextMuted}" Text="Нет закреплённых сообщений" />
        </StackPanel>
    </StackPanel>
</UserControl>