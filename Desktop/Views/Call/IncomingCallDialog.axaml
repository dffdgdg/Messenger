<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:controls="using:Desktop.Views.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Core.ViewModels.Call"
             x:Class="Desktop.Views.Call.IncomingCallDialog"
             x:DataType="vm:IncomingCallViewModel">

    <Border Classes="DialogContainer" Width="340" Padding="24,32">
        <StackPanel Spacing="24">

            <TextBlock Text="{Binding Title}"
                       Classes="DialogSubtitle"
                       HorizontalAlignment="Center"
                       FontWeight="Medium"/>

            <Grid HorizontalAlignment="Center" Margin="0,12">
                
                <Border Width="88" Height="88" 
                        CornerRadius="44" 
                        Background="{DynamicResource Accent}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <ScaleTransform />
                    </Border.RenderTransform>
                    <Border.Styles>
                        <Style Selector="Border">
                            <Style.Animations>
                                <Animation Duration="0:0:2" IterationCount="INFINITE" Easing="CubicEaseOut">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="ScaleTransform.ScaleX" Value="1"/>
                                        <Setter Property="ScaleTransform.ScaleY" Value="1"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="0"/>
                                        <Setter Property="ScaleTransform.ScaleX" Value="1.8"/>
                                        <Setter Property="ScaleTransform.ScaleY" Value="1.8"/>
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Border.Styles>
                </Border>

                <controls:AvatarControl
                    Classes="XLarge"
                    Source="{Binding CallerAvatar}"
                    DisplayName="{Binding CallerName}"
                    ShowOnlineIndicator="False"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
            </Grid>

            <StackPanel HorizontalAlignment="Center" Spacing="6">
                <TextBlock Text="{Binding CallerName}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimary}"
                           TextTrimming="CharacterEllipsis"
                           HorizontalAlignment="Center"/>
                
                <TextBlock Text="{Binding ChatName}"
                           Classes="TextSecondary"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           IsVisible="{Binding IsGroupCall}"/>
                
                <TextBlock Text="{Binding SubTitle}"
                           Classes="TextMuted"
                           FontSize="14"
                           Margin="0,4,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid ColumnDefinitions="*,16,*" Margin="0,16,0,0">
                <Button Grid.Column="0"
                        Content="{Binding DeclineButtonText}"
                        Command="{Binding DeclineCommand}"
                        Classes="DialogDanger"
                        Height="44"
                        CornerRadius="22"
                        HorizontalAlignment="Stretch"/>

                <Button Grid.Column="2"
                        Content="{Binding AcceptButtonText}"
                        Command="{Binding AcceptCommand}"
                        Classes="DialogAccent"
                        Height="44"
                        CornerRadius="22"
                        HorizontalAlignment="Stretch"/>
            </Grid>

        </StackPanel>
    </Border>
</UserControl>