<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmDialog="using:MessengerDesktop.ViewModels.Dialog"
             xmlns:chat="using:MessengerDesktop.ViewModels.Chat"
             xmlns:controls="using:MessengerDesktop.Views.Controls"
             xmlns:conv="using:MessengerDesktop.Converters"
             x:Class="MessengerDesktop.Views.Dialog.SearchFiltersDialog"
             x:DataType="vmDialog:SearchFiltersDialogViewModel">

    <Border Classes="DialogContainer"
            Width="420"
            MinHeight="0"
            Padding="0">

        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
            <Grid Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="24,24,24,16">
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="2">
                    <TextBlock Text="Фильтры поиска"
                               Classes="DialogTitle Small"/>
                    <TextBlock Text="Уточните параметры поиска"
                               Classes="DialogSubtitle"/>
                </StackPanel>
                <Button Grid.Column="2"
                        Classes="IconButton"
                        Command="{Binding CancelCommand}"
                        ToolTip.Tip="Закрыть">
                    <PathIcon Data="{StaticResource CloseIcon}"
                              Width="14" Height="14"
                              Foreground="{DynamicResource TextSecondary}"/>
                </Button>
            </Grid>

            <Border Grid.Row="1"
                    Height="1"
                    Background="{DynamicResource BorderDefault}"/>

            <ScrollViewer Grid.Row="2"
                          Classes="ThinScrollbar"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="24,16,24,16">

                    <TextBlock Text="ОБЛАСТЬ ПОИСКА"
                               Classes="CategoryHeader"
                               Margin="0"/>
                    <Border Classes="Section" Padding="8">
                        <WrapPanel Orientation="Horizontal">

                            <ToggleButton Margin="3"
                                          Classes="SwitchSmall"
                                          IsChecked="{Binding SearchManager.IsAllScope}"
                                          Command="{Binding SetSearchScopeCommand}"
                                          CommandParameter="{x:Static chat:SearchScopeMode.All}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource SearchIcon}"
                                              Width="12" Height="12"/>
                                    <TextBlock Text="Все"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Margin="3"
                                          Classes="SwitchSmall"
                                          IsChecked="{Binding SearchManager.IsChatsScope}"
                                          Command="{Binding SetSearchScopeCommand}"
                                          CommandParameter="{x:Static chat:SearchScopeMode.Chats}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource ChatsIcon}"
                                              Width="12" Height="12"/>
                                    <TextBlock Text="Чаты"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Margin="3"
                                          Classes="SwitchSmall"
                                          IsChecked="{Binding SearchManager.IsContactsScope}"
                                          Command="{Binding SetSearchScopeCommand}"
                                          CommandParameter="{x:Static chat:SearchScopeMode.Contacts}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource ContactsIcon}"
                                              Width="12" Height="12"/>
                                    <TextBlock Text="Контакты"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Margin="3"
                                          Classes="SwitchSmall"
                                          IsChecked="{Binding SearchManager.IsChatLocalMode}"
                                          IsVisible="{Binding SearchManager.CanSearchInCurrentChat}"
                                          Command="{Binding SetSearchScopeCommand}"
                                          CommandParameter="{x:Static chat:SearchScopeMode.CurrentChatMessages}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource ChatOutlineIcon}"
                                              Width="12" Height="12"/>
                                    <TextBlock Text="Этот чат"/>
                                </StackPanel>
                            </ToggleButton>

                        </WrapPanel>
                    </Border>

                    <TextBlock Text="ОТ КОГО"
                               Classes="CategoryHeader"
                               Margin="0"/>
                        <controls:FilterAutocomplete
                            SearchText="{Binding SearchManager.SenderSearchText, Mode=TwoWay}"
                            SelectedItem="{Binding SearchManager.SelectedSender, Mode=TwoWay}"
                            IsDropdownOpen="{Binding SearchManager.IsSenderDropdownOpen, Mode=TwoWay}"
                            Suggestions="{Binding SearchManager.SenderSuggestions}"
                            Placeholder="Начните вводить имя..."
                            Icon="{StaticResource PersonIcon}"/>

                    <TextBlock Text="В ЧАТЕ"
                               Classes="CategoryHeader"
                               Margin="0"
                               IsVisible="{Binding SearchManager.IsChatFilterVisible}"/>
                        <controls:FilterAutocomplete
                            SearchText="{Binding SearchManager.ChatSearchText, Mode=TwoWay}"
                            SelectedItem="{Binding SearchManager.SelectedChatFilter, Mode=TwoWay}"
                            IsDropdownOpen="{Binding SearchManager.IsChatDropdownOpen, Mode=TwoWay}"
                            Suggestions="{Binding SearchManager.ChatSuggestions}"
                            Placeholder="Начните вводить название..."
                            Icon="{StaticResource ChatsIcon}"
                            IsVisible="{Binding SearchManager.IsChatFilterVisible}"/>

                    <TextBlock Text="ПЕРИОД"
                               Classes="CategoryHeader"
                               Margin="0"/>
                    <Border Classes="Section" Padding="12,10">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4">
                                <TextBlock Text="С"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <DatePicker SelectedDate="{Binding SearchManager.DateFromFilter, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="По"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"/>
                                <DatePicker SelectedDate="{Binding SearchManager.DateToFilter, Mode=TwoWay}"
                                            HorizontalAlignment="Stretch"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="ТИП КОНТЕНТА"
                               Classes="CategoryHeader"
                               Margin="0"/>
                    <Border Classes="Section" Padding="4">
                        <WrapPanel Orientation="Horizontal">

                            <ToggleButton Margin="4" Classes="SwitchSmall"
                                          IsChecked="{Binding SearchManager.ContentFilter, Mode=OneWay,
                                              Converter={conv:Converter Name=EnumEquals},
                                              ConverterParameter={x:Static chat:SearchContentFilter.Any}}"
                                          Command="{Binding SetSearchContentFilterCommand}"
                                          CommandParameter="{x:Static chat:SearchContentFilter.Any}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource SearchIcon}" Width="12" Height="12"/>
                                    <TextBlock Text="Любой"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Margin="4" Classes="SwitchSmall"
                                          IsChecked="{Binding SearchManager.ContentFilter, Mode=OneWay,
                                              Converter={conv:Converter Name=EnumEquals},
                                              ConverterParameter={x:Static chat:SearchContentFilter.OnlyText}}"
                                          Command="{Binding SetSearchContentFilterCommand}"
                                          CommandParameter="{x:Static chat:SearchContentFilter.OnlyText}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource DocumentIcon}" Width="12" Height="12"/>
                                    <TextBlock Text="Текст"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Margin="4" Classes="SwitchSmall"
                                          IsChecked="{Binding SearchManager.ContentFilter, Mode=OneWay,
                                              Converter={conv:Converter Name=EnumEquals},
                                              ConverterParameter={x:Static chat:SearchContentFilter.WithFiles}}"
                                          Command="{Binding SetSearchContentFilterCommand}"
                                          CommandParameter="{x:Static chat:SearchContentFilter.WithFiles}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource AttachIcon}" Width="12" Height="12"/>
                                    <TextBlock Text="Файлы"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Margin="4" Classes="SwitchSmall"
                                          IsChecked="{Binding SearchManager.ContentFilter, Mode=OneWay,
                                              Converter={conv:Converter Name=EnumEquals},
                                              ConverterParameter={x:Static chat:SearchContentFilter.WithVoice}}"
                                          Command="{Binding SetSearchContentFilterCommand}"
                                          CommandParameter="{x:Static chat:SearchContentFilter.WithVoice}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource MicrophoneIcon}" Width="12" Height="12"/>
                                    <TextBlock Text="Голосовые"/>
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton Margin="4" Classes="SwitchSmall"
                                          IsChecked="{Binding SearchManager.ContentFilter, Mode=OneWay,
                                              Converter={conv:Converter Name=EnumEquals},
                                              ConverterParameter={x:Static chat:SearchContentFilter.WithPolls}}"
                                          Command="{Binding SetSearchContentFilterCommand}"
                                          CommandParameter="{x:Static chat:SearchContentFilter.WithPolls}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <PathIcon Data="{StaticResource PollIcon}" Width="12" Height="12"/>
                                    <TextBlock Text="Опросы"/>
                                </StackPanel>
                            </ToggleButton>

                        </WrapPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="3"
                    Height="1"
                    Background="{DynamicResource BorderDefault}"/>

            <Grid Grid.Row="4"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="24,16,24,24">

                <Button Grid.Column="0"
                        Classes="DialogOutline"
                        Command="{Binding ClearFiltersCommand}"
                        Foreground="{DynamicResource TextMuted}"
                        BorderBrush="{DynamicResource BorderDefault}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource RefreshIcon}"
                                  Width="13" Height="13"
                                  Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Text="Сбросить"/>
                    </StackPanel>
                </Button>

                <Border Grid.Column="1"/>

                <Button Grid.Column="2"
                        Classes="DialogAccent"
                        Command="{Binding ApplyCommand}"
                        MinWidth="120">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <PathIcon Data="{StaticResource CheckmarkIcon}"
                                  Width="13" Height="13"
                                  Foreground="{DynamicResource TextOnAccent}"/>
                        <TextBlock Text="Применить"
                                   Foreground="{DynamicResource TextOnAccent}"/>
                    </StackPanel>
                </Button>

            </Grid>

        </Grid>

    </Border>
</UserControl>