<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:conv="using:MessengerDesktop.Converters"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MessengerDesktop.Views.Controls.Admin"
             xmlns:vm="using:MessengerDesktop.ViewModels"
             x:Class="MessengerDesktop.Views.Controls.Admin.DepartmentCardView"
             x:DataType="vm:HierarchicalDepartmentViewModel">
    <UserControl.Styles>
			<Style Selector="StackPanel.DepartmentActions">
		<Setter Property="Opacity" Value="0"/>
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
			</Transitions>
		</Setter>
	</Style>
    </UserControl.Styles>
    <Grid Margin="0,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Classes="DepartmentCard Hoverable"
                Margin="{Binding Level, Converter={conv:Converter Name=LevelToMargin}}"
                Cursor="Hand"
                CornerRadius="8"
                Background="Transparent">
            
            <Border.Styles>
                <Style Selector="Border.Hoverable:pointerover">
                    <Setter Property="Background" Value="{DynamicResource SecondaryBG}" />
                </Style>
                <Style Selector="Border.Hoverable StackPanel.DepartmentActions">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                        </Transitions>
                    </Setter>
                </Style>
                <Style Selector="Border.Hoverable:pointerover StackPanel.DepartmentActions">
                    <Setter Property="Opacity" Value="1"/>
                </Style>
            </Border.Styles>

            <Grid>
                <Canvas IsVisible="{Binding Level, Converter={conv:Converter Name=LevelToVisibility}}"
                        Width="24" Height="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="-24,0,0,0">
                    <Line StartPoint="0,0" EndPoint="20,0"
                          Stroke="{DynamicResource HierarchyLineBrush}"
                          StrokeThickness="2"
                          StrokeLineCap="Round"/>
                </Canvas>

                <Grid ColumnDefinitions="Auto,*,Auto" Margin="4">
                    
                    <Button Grid.Column="0"
                            Command="{Binding ToggleExpandCommand}"
                            Width="36" Height="36" Margin="4"
                            Classes="IconButton"
                            IsVisible="{Binding HasChildren}">
                        <PathIcon Data="{StaticResource ChevronIcon}"
                                  Width="12" Height="12"
                                  Foreground="{DynamicResource TextSecondary}"
                                  RenderTransformOrigin="50%,50%">
                            <PathIcon.RenderTransform>
                                <RotateTransform Angle="{Binding ExpanderRotation}"/>
                            </PathIcon.RenderTransform>
                            <PathIcon.Styles>
                                <Style Selector="PathIcon">
                                    <Setter Property="Transitions">
                                        <Transitions>
                                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                                        </Transitions>
                                    </Setter>
                                </Style>
                            </PathIcon.Styles>
                        </PathIcon>
                    </Button>

                    <Border Grid.Column="0" Width="44" Height="44" IsVisible="{Binding !HasChildren}"/>

                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="8,8">
                        <Border Grid.Column="0"
                                Width="36" Height="36" CornerRadius="8"
                                Margin="0,0,12,0"
                                Background="{DynamicResource CardBgBrush}">
                            <Panel>
                                <PathIcon Data="{StaticResource OrganizationIcon}"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource Accent}"
                                          IsVisible="{Binding IsRoot}"/>
                                <PathIcon Data="{StaticResource FolderIcon}"
                                          Width="16" Height="16"
                                          Foreground="{DynamicResource TextSecondary}"
                                          IsVisible="{Binding !IsRoot}"/>
                            </Panel>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" MinWidth="0">
                            <TextBlock Text="{Binding Name}"
                                       ToolTip.Tip="{Binding Name}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasHead}">
                                    <PathIcon Data="{StaticResource PersonIcon}" Width="10" Height="10" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="{Binding HeadName}"
                                               ToolTip.Tip="{Binding HeadName}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondary}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Text="Нет руководителя"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextMuted}"
                                           FontStyle="Italic"
                                           IsVisible="{Binding !HasHead}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        
                        <Border Background="{DynamicResource AccentSubtle}"
                                CornerRadius="12" 
                                Padding="10,4"
                                IsVisible="{Binding ShowUserCount}"
                                ToolTip.Tip="{Binding UserCountText}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{StaticResource PeopleIcon}" Width="12" Height="12" Foreground="{DynamicResource Accent}"/>
                                <TextBlock Text="{Binding UserCount}" VerticalAlignment="Center" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource Accent}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource WarningSubtle}"
                                CornerRadius="12" Padding="10,4"
                                IsVisible="{Binding !ShowUserCount}">
                            <TextBlock Text="Пусто" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
                        </Border>

                        <StackPanel Classes="DepartmentActions" Orientation="Horizontal" Spacing="4">
                            <Button Classes="IconButton" Command="{Binding $parent[local:DepartmentCardView].EditCommand}" CommandParameter="{Binding Department}" ToolTip.Tip="Редактировать">
                                <PathIcon Data="{StaticResource EditIcon}" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}"/>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                IsVisible="{Binding IsExpanded}"
                Margin="16,0,0,0">
            <Grid>
                <Border Width="2"
                        Background="{DynamicResource HierarchyLineBrush}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        Margin="11,0,0,8"
                        CornerRadius="1"
                        IsVisible="{Binding HasChildren}"/>

                <ItemsControl ItemsSource="{Binding Children}"
                              Margin="16,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:HierarchicalDepartmentViewModel">
                            <local:DepartmentCardView EditCommand="{Binding $parent[local:DepartmentCardView].EditCommand}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </Grid>
</UserControl>