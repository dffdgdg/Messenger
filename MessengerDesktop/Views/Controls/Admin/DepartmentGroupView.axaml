<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:admin="using:MessengerDesktop.ViewModels.Admin"
             xmlns:adminCon="using:MessengerDesktop.Views.Controls.Admin"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:MessengerDesktop.Views.Controls.Admin"
             xmlns:user="using:MessengerShared.Dto.User"
             x:Class="MessengerDesktop.Views.Controls.Admin.DepartmentGroupView"
             x:DataType="admin:DepartmentGroup">

    <StackPanel Spacing="4">

        <!-- Заголовок группы -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">

            <!-- Иконка + название -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Border Width="28" Height="28"
                        CornerRadius="7"
                        Background="{DynamicResource ThirdBG}">
                    <PathIcon Data="{StaticResource OrganizationIcon}"
                              Width="13" Height="13"
                              Foreground="{DynamicResource TextSecondary}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="{Binding DepartmentName}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"/>

                <!-- Счётчик -->
                <Border CornerRadius="8"
                        Background="{DynamicResource AccentMuted}"
                        Padding="7,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding Users.Count}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Accent}"/>
                </Border>
            </StackPanel>

            <!-- Разделитель -->
            <Border Grid.Column="1"
                    Height="1"
                    Background="{DynamicResource BorderDefault}"
                    Margin="12,0,0,0"
                    Opacity="0.6"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- Список пользователей -->
        <Border Background="{DynamicResource ThirdBG}"
                CornerRadius="10"
                Padding="4">
            <ItemsControl ItemsSource="{Binding Users}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="0"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="user:UserDto">
                        <local:UserCardView
                            EditCommand="{Binding $parent[adminCon:DepartmentGroupView].EditUserCommand}"
                            BanCommand="{Binding $parent[adminCon:DepartmentGroupView].BanUserCommand}"
                            DeleteCommand="{Binding $parent[adminCon:DepartmentGroupView].DeleteUserCommand}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>