<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Core.Features.Settings.ViewModels"
             x:Class="Core.Features.Settings.Views.Controls.AccentSelectorControl"
             x:DataType="vm:AccentPickerViewModel">

    <UserControl.Styles>
        <Style Selector="Button.AccentDot">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.AccentDot:pointerover /template/ ContentPresenter">
            <Setter Property="Opacity" Value="0.82"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="10">

        <StackPanel Orientation="Horizontal" Spacing="6">

            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccentPickerViewModel+PresetItem">
                        <Panel Width="34" Height="34">
                            <Ellipse Width="34" Height="34"
                                     StrokeThickness="2"
                                     IsVisible="{Binding IsSelected}">
                                <Ellipse.Stroke>
                                    <SolidColorBrush Color="{Binding Color}"/>
                                </Ellipse.Stroke>
                            </Ellipse>
                            <Button Classes="AccentDot"
                                    Width="26" Height="26"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Command="{Binding $parent[UserControl].DataContext.SelectPresetCommand}"
                                    CommandParameter="{Binding}">
                                <Button.Background>
                                    <SolidColorBrush Color="{Binding Color}"/>
                                </Button.Background>
                            </Button>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Разделитель -->
            <Border Width="1" Height="20" Margin="2,0"
                    Background="{DynamicResource BorderDefault}"
                    VerticalAlignment="Center"/>

            <!-- Свой цвет -->
            <Panel Width="34" Height="34">
                <Ellipse Width="34" Height="34"
                         StrokeThickness="2"
                         IsVisible="{Binding HasCustomAccent}">
                    <Ellipse.Stroke>
                        <SolidColorBrush Color="{Binding CustomColor}"/>
                    </Ellipse.Stroke>
                </Ellipse>
                <Button Classes="AccentDot"
                        Width="26" Height="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Выбрать свой цвет"
                        Command="{Binding OpenColorPickerCommand}">
                    <Button.Background>
                        <SolidColorBrush Color="{Binding CustomColor}"/>
                    </Button.Background>
                    <PathIcon Data="{DynamicResource EditIcon}"
                              Width="9" Height="9"
                              Foreground="White"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>
                </Button>
            </Panel>

        </StackPanel>

        <!-- Системный акцент -->
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Grid.Column="0"
                       Text="Системный цвет акцентов"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondary}"/>
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding UseSystemAccent, Mode=TwoWay}"
                          VerticalAlignment="Center"
                          Classes="SwitchSmall"/>
        </Grid>

        <!-- Раскрываемый пикер -->
        <Border IsVisible="{Binding IsColorPickerOpen}"
                Background="{DynamicResource ThirdBG}"
                CornerRadius="10"
                Padding="12"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="1">
            <StackPanel Spacing="10">

                <Grid ColumnDefinitions="36,*" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               Text="HEX"
                               VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding CustomColorHex, Mode=TwoWay}"
                             PlaceholderText="#3390EC"
                             MaxLength="7"
                             FontFamily="Consolas,Menlo,monospace"
                             FontSize="13"/>
                </Grid>

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Border Grid.Column="0" Height="30" CornerRadius="6">
                        <Border.Background>
                            <SolidColorBrush Color="{Binding CustomColor}"/>
                        </Border.Background>
                    </Border>
                    <Button Grid.Column="1"
                            Content="Применить"
                            Classes="Primary"
                            Command="{Binding ApplyCustomColorCommand}"/>
                </Grid>

                <ItemsControl ItemsSource="{Binding CustomColorShades}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:AccentPickerViewModel+ShadeItem">
                            <Button Classes="AccentDot"
                                    Width="24" Height="24"
                                    CornerRadius="12"
                                    Command="{Binding $parent[UserControl].DataContext.SelectShadeCommand}"
                                    CommandParameter="{Binding Color}">
                                <Button.Background>
                                    <SolidColorBrush Color="{Binding Color}"/>
                                </Button.Background>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>