<UserControl
    x:Class="Core.Features.ChatList.Views.ChatListView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avatar="using:Core.Shared.Controls"
    xmlns:controls="using:Core.Features.ChatList.Views.Controls"
    xmlns:conv="using:Core.Shared.Converters"
    xmlns:items="using:Core.Features.ChatList.ViewModels.Items"
    xmlns:local="using:Core.Features.ChatList.Views"
    xmlns:search="using:Core.Features.ChatList.ViewModels.Search"
    xmlns:viewmodels="using:Core.Features.Chat.ViewModels"
    xmlns:Views="using:Core.Features.Chat.Views"
    xmlns:vm="using:Core.Features.ChatList.ViewModels"
    x:Name="Root"
    x:DataType="vm:ChatListViewModel"
    Background="{DynamicResource PrimaryBG}">

    <UserControl.Resources>
        <DataTemplate x:Key="ChatFullItemTemplate" x:DataType="items:ChatListItemViewModel">
            <controls:ChatFullItemView />
        </DataTemplate>
        <DataTemplate x:Key="ChatCompactItemTemplate" x:DataType="items:ChatListItemViewModel">
            <controls:ChatCompactItemView />
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        
        <Style Selector="Border.PanelHeader">
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="{DynamicResource PrimaryBG}" />
        </Style>
        <Style Selector="TextBlock.PanelTitle">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        
        <Style Selector="Border.UnreadBadge">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style Selector="Border.CompactBadge">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style Selector="Button.ChatListItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.ChatListItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BorderHover}" />
        </Style>
        <Style Selector="Button.ChatListItem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Border.UnreadBadge">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style Selector="Border.CompactBadge">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="MainGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="96" MaxWidth="400" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid x:Name="ChatListPanel" Grid.Column="0">
            <DockPanel>
                <Border
                    Height="65"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="0,0,0,1"
                    Classes="PanelHeader"
                    DockPanel.Dock="Top">
                    <Panel>
                        <Grid
                            Height="33"
                            ColumnDefinitions="*,Auto"
                            IsVisible="{Binding !IsCompactMode, ElementName=Root}">
                            <Panel Grid.Column="0">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="PanelTitle"
                                    IsVisible="{Binding !IsSearchMode}"
                                    Text="{Binding IsGroupMode, Converter={conv:Converter Name=BoolToString}, ConverterParameter='Чаты|Контакты'}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="PanelTitle"
                                    IsVisible="{Binding IsSearchMode}"
                                    Text="{Binding SearchManager.SelectedScope, Converter={conv:Converter Name=SearchScopeToTitle}}" />
                            </Panel>

                            <Button
                                Grid.Column="1"
                                Classes="IconButton"
                                Command="{Binding CreateGroupCommand}"
                                ToolTip.Tip="Новый чат">
                                <Button.IsVisible>
                                    <MultiBinding Converter="{conv:MultiConverter Name=BooleanAnd}">
                                        <Binding Path="IsGroupMode" />
                                        <Binding Path="!IsSearchMode" />
                                    </MultiBinding>
                                </Button.IsVisible>
                                <PathIcon Width="18" Height="18" Data="{StaticResource AddIcon}" Foreground="{DynamicResource Icon}" />
                            </Button>

                            <Button
                                Grid.Column="1"
                                Classes="IconButton"
                                Command="{Binding CloseSearchCommand}"
                                IsVisible="{Binding IsSearchMode}"
                                ToolTip.Tip="Закрыть поиск">
                                <PathIcon Width="16" Height="16" Data="{StaticResource CloseIcon}" Foreground="{DynamicResource Icon}" />
                            </Button>
                        </Grid>

                        <Button
                            HorizontalAlignment="Center"
                            Classes="IconButton"
                            Click="OnSearchButtonClick"
                            IsVisible="{Binding IsCompactMode, ElementName=Root}"
                            ToolTip.Tip="Поиск">
                            <PathIcon Width="20" Height="20" Data="{StaticResource SearchIcon}" Foreground="{DynamicResource Icon}" />
                        </Button>
                    </Panel>
                </Border>

                <Border
                    Height="40"
                    Margin="8,8,8,4"
                    DockPanel.Dock="Top"
                    IsVisible="{Binding !IsCompactMode, ElementName=Root}">
                    <avatar:SearchBox
                        x:Name="SearchTextBox"
                        SearchFocused="OnSearchBoxFocused"
                        SearchText="{Binding SearchManager.SearchQuery, Mode=TwoWay}"
                        Watermark="{Binding SearchManager.SelectedScope, Converter={conv:Converter Name=SearchScopeToWatermark}}" />
                </Border>

                <StackPanel
                    Margin="8,0,8,4"
                    DockPanel.Dock="Top"
                    Orientation="Horizontal"
                    Spacing="6">
                    <StackPanel.IsVisible>
                        <MultiBinding Converter="{conv:MultiConverter Name=BooleanAnd}">
                            <Binding Path="IsSearchMode" />
                            <Binding ElementName="Root" Path="!IsCompactMode" />
                        </MultiBinding>
                    </StackPanel.IsVisible>

                    <ToggleButton Classes="SwitchSmall" Command="{Binding SetSearchScopeCommand}" CommandParameter="{x:Static search:SearchScopeMode.All}" Content="Все" IsChecked="{Binding SearchManager.IsAllScope}" />
                    <ToggleButton Classes="SwitchSmall" Command="{Binding SetSearchScopeCommand}" CommandParameter="{x:Static search:SearchScopeMode.Chats}" Content="Чаты" IsChecked="{Binding SearchManager.IsChatsScope}" />
                    <ToggleButton Classes="SwitchSmall" Command="{Binding SetSearchScopeCommand}" CommandParameter="{x:Static search:SearchScopeMode.Contacts}" Content="Контакты" IsChecked="{Binding SearchManager.IsContactsScope}" />
                    <ToggleButton
                        Classes="SwitchSmall"
                        Command="{Binding SetSearchScopeCommand}"
                        CommandParameter="{x:Static search:SearchScopeMode.CurrentChatMessages}"
                        Content="Этот чат"
                        IsChecked="{Binding SearchManager.IsChatLocalMode}"
                        IsVisible="{Binding SearchManager.CanSearchInCurrentChat}" />
                </StackPanel>

                <Grid
                    Height="24"
                    Margin="12,0,8,6"
                    ColumnDefinitions="*,Auto,Auto"
                    DockPanel.Dock="Top">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{conv:MultiConverter Name=BooleanAnd}">
                            <Binding Path="IsSearchMode" />
                            <Binding ElementName="Root" Path="!IsCompactMode" />
                        </MultiBinding>
                    </Grid.IsVisible>

                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextMuted}"
                        Text="{Binding SearchManager.TotalMessagesText}" />

                    <Button
                        Grid.Column="1"
                        Margin="0,0,2,0"
                        Classes="IconButton Small"
                        Command="{Binding OpenSearchFiltersCommand}"
                        ToolTip.Tip="Фильтры">
                        <Panel>
                            <PathIcon Width="14" Height="14" Data="{StaticResource FilterIcon}" Foreground="{DynamicResource Icon}" />
                            <Ellipse
                                Width="7"
                                Height="7"
                                Margin="0,-2,-2,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Fill="{DynamicResource Accent}"
                                IsVisible="{Binding SearchManager.HasActiveFilters}" />
                        </Panel>
                    </Button>

                    <Button
                        Grid.Column="2"
                        Classes="IconButton Small"
                        Command="{Binding ToggleSortOrderCommand}"
                        ToolTip.Tip="{Binding SearchManager.IsSortNewest, Converter={conv:Converter Name=BoolToString}, ConverterParameter='Сначала новые|Сначала старые'}">
                        <Panel>
                            <PathIcon Width="14" Height="14" Data="{StaticResource SortIcon}" Foreground="{DynamicResource Icon}" />
                            <PathIcon
                                Width="14"
                                Height="14"
                                Data="{StaticResource SortIcon}"
                                Foreground="{DynamicResource Accent}"
                                IsVisible="{Binding !SearchManager.IsSortNewest}" />
                        </Panel>
                    </Button>
                </Grid>

                <ListBox
                    Margin="4,4,0,8"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.Name="Список чатов"
                    Background="Transparent"
                    BorderThickness="0"
                    DockPanel.Dock="Top"
                    IsVisible="{Binding !IsSearchMode}"
                    ItemsSource="{Binding Chats}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectedItem="{Binding SelectedChat}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel HorizontalAlignment="Stretch" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="8" />
                            <Setter Property="Margin" Value="8,2,8,2" />
                            <Setter Property="CornerRadius" Value="8" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="ClipToBounds" Value="False" />
                            <Setter Property="Transitions">
                                <Transitions>
                                    <BrushTransition Property="Background" Duration="0:0:0.15" />
                                </Transitions>
                            </Setter>
                        </Style>
                        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource ChatItemHoverBg}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected">
                            <Setter Property="ZIndex" Value="10" />
                        </Style>
                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                            <Setter Property="Background" Value="{DynamicResource Accent}" />
                            <Setter Property="BoxShadow" Value="0 4 12 0 #25000000" />
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock.ChatPreView">
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                            <Setter Property="Opacity" Value="1" />
                        </Style>
                        <Style Selector="ListBoxItem:selected TextBlock.ChatName">
                            <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="items:ChatListItemViewModel">
                            <Panel>
                                <ContentPresenter
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource ChatFullItemTemplate}"
                                    IsVisible="{Binding !$parent[ItemsControl].DataContext.IsCompactMode}" />
                                <ContentPresenter
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource ChatCompactItemTemplate}"
                                    IsVisible="{Binding $parent[ItemsControl].DataContext.IsCompactMode}"/>
                            </Panel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <local:ChatSearchPanelView IsVisible="{Binding IsSearchMode}" />
            </DockPanel>
        </Grid>

        <GridSplitter
            x:Name="GridSplitter"
            Grid.Column="1"
            Width="4"
            Background="Transparent"
            IsVisible="{Binding LayoutMode, Converter={conv:Converter Name=LayoutModeToSplitterVisible}, ElementName=Root}"
            ResizeBehavior="PreviousAndNext"
            ResizeDirection="Columns" />

        <Border
            Grid.Column="2"
            Background="{DynamicResource SecondaryBG}"
            BorderBrush="{DynamicResource BorderDefault}"
            BorderThickness="1"
            ClipToBounds="True"
            CornerRadius="16">
            <Panel>
                <ContentControl Content="{Binding CurrentChatViewModel}">
                    <ContentControl.DataTemplates>
                        <DataTemplate DataType="viewmodels:ChatViewModel">
                            <Views:ChatView />
                        </DataTemplate>
                    </ContentControl.DataTemplates>
                </ContentControl>

                <controls:EmptyChatStateView IsVisible="{Binding CurrentChatViewModel, Converter={x:Static ObjectConverters.IsNull}}" />
            </Panel>
        </Border>

        <Views:ChatInfoPanel
            x:Name="InfoPanel"
            Grid.Column="3"
            DataContext="{Binding CurrentChatViewModel}"
            OpenProfileCommand="{Binding OpenProfileCommand}" />
    </Grid>
</UserControl>