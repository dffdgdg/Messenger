<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vmDialog="using:Core.ViewModels.Dialog"
             xmlns:department="using:Shared.Dto.Department"
             x:Class="Desktop.Views.DepartmentDialog"
             x:DataType="vmDialog:DepartmentDialogViewModel">

    <Border Classes="DialogContainer">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

            <!-- Шапка -->
            <Grid ColumnDefinitions="*,Auto"
                  Margin="24,24,24,16">
                <TextBlock Text="{Binding Title}"
                           Classes="DialogTitle"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Разделитель -->
            <Border Grid.Row="1" Classes="DialogDivider"/>

            <!-- Тело -->
            <ScrollViewer Grid.Row="2"
                          Classes="ThinScrollbar"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel Spacing="12" Margin="24,16,24,16">

                    <TextBox Text="{Binding Name}"
                             Classes="Input"
                             PlaceholderText="Название отдела">
                        <TextBox.InnerLeftContent>
                            <PathIcon Data="{StaticResource FolderIcon}"
                                      Classes="InputIcon"
                                      Margin="12,0,8,0"/>
                        </TextBox.InnerLeftContent>
                    </TextBox>

                    <ComboBox ItemsSource="{Binding AvailableParents}"
                              SelectedItem="{Binding SelectedParent}"
                              Classes="DialogCombo"
                              PlaceholderText="Выбрать родительский отдел"
                              HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="department:DepartmentDto">
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                </StackPanel>
            </ScrollViewer>

            <!-- Разделитель -->
            <Border Grid.Row="3" Classes="DialogDivider"/>

            <!-- Футер -->
            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12"
                        Margin="24,16,24,24">
                <Button Content="Отмена"
                        Classes="DialogOutline"
                        Command="{Binding CancelCommand}"
                        MinWidth="100"/>
                <Button Content="Сохранить"
                        Classes="DialogAccent"
                        Command="{Binding SaveCommand}"
                        MinWidth="100"/>
            </StackPanel>

        </Grid>
    </Border>
</UserControl>