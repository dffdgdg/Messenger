<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:messages="using:Core.Features.Chat.ViewModels.Messages"
             x:Class="Core.Features.Chat.Views.MessageParts.ReplyPreViewBlock"
             x:DataType="messages:MessageViewModel"
             x:Name="ReplyRoot">

    <Button Classes="ReplyPreViewButton"
            IsVisible="{Binding HasReply}"
            Command="{Binding #ReplyRoot.ScrollToReplyCommand}"
            CommandParameter="{Binding}">
        <Border Classes="ReplyPreView"
                Classes.Own="{Binding IsOwn}"
                CornerRadius="8"
                Padding="8,6"
                Margin="0,0,0,6"
                Background="#0A000000">
            <Border.Styles>
                <Style Selector="Border.ReplyPreView.Own">
                    <Setter Property="Background" Value="#12FFFFFF"/>
                </Style>
                <Style Selector="Border.ReplyPreView">
                    <Setter Property="Transitions">
                        <Transitions>
                            <DoubleTransition Property="Opacity" Duration="0:0:0.15"/>
                        </Transitions>
                    </Setter>
                </Style>
            </Border.Styles>

            <Grid ColumnDefinitions="Auto,*">
                <Border Grid.Column="0"
                        Width="3"
                        Background="{DynamicResource Accent}"
                        CornerRadius="2"
                        Margin="0,2,8,2"/>
                <StackPanel Grid.Column="1" Spacing="1">
    <TextBlock Text="{Binding ReplyToSenderName, FallbackValue=''}"
               FontSize="12"
               FontWeight="SemiBold"
               Foreground="{DynamicResource Accent}"
               TextTrimming="CharacterEllipsis"
               MaxLines="1"/>
    <TextBlock Text="{Binding ReplyToContent, FallbackValue=''}"
               FontSize="12"
               Foreground="{DynamicResource TextSecondary}"
               TextTrimming="CharacterEllipsis"
               MaxLines="1"
               Margin="0,1,0,0"
               Classes.Deleted="{Binding ReplyToIsDeleted}">
        <TextBlock.Styles>
            <Style Selector="TextBlock.Deleted">
                <Setter Property="FontStyle" Value="Italic"/>
                <Setter Property="Opacity" Value="0.6"/>
            </Style>
        </TextBlock.Styles>
    </TextBlock>
</StackPanel>
            </Grid>
        </Border>
    </Button>
</UserControl>