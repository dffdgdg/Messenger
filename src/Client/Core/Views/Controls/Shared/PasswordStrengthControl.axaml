<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:Core.Views.Controls.Shared"
             x:Class="Core.Views.Controls.Shared.PasswordStrengthControl"
             x:Name="Root">

    <UserControl.Styles>
        <Style Selector="Border.seg-inactive">
            <Setter Property="Background" Value="{DynamicResource BorderDefault}"/>
        </Style>
        <Style Selector="Border.seg-weak">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
        </Style>
        <Style Selector="Border.seg-medium">
            <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
        </Style>
        <Style Selector="Border.seg-good">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
        </Style>
        <Style Selector="Border.seg-strong">
            <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="6">

        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
            <Border x:Name="Seg1" Grid.Column="0"
                    Height="4" CornerRadius="2"
                    Classes="seg-inactive"/>

            <Border x:Name="Seg2" Grid.Column="1"
                    Height="4" CornerRadius="2"
                    Classes="seg-inactive"/>

            <Border x:Name="Seg3" Grid.Column="2"
                    Height="4" CornerRadius="2"
                    Classes="seg-inactive"/>

            <Border x:Name="Seg4" Grid.Column="3"
                    Height="4" CornerRadius="2"
                    Classes="seg-inactive"/>
        </Grid>

        <TextBlock Text="{Binding StrengthLabel, ElementName=Root}"
                   Classes="ValidationHint"
                   IsVisible="{Binding StrengthLabel, ElementName=Root,
                       Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <StackPanel Orientation="Horizontal" Spacing="6"
                    IsVisible="{Binding ShowMatch, ElementName=Root}">
            <Panel>
                <PathIcon Data="{StaticResource CheckmarkIcon}"
                          Width="13" Height="13"
                          Foreground="{DynamicResource SuccessBrush}"
                          IsVisible="{Binding PasswordsMatch, ElementName=Root}"/>
                <PathIcon Data="{StaticResource ErrorIcon}"
                          Width="13" Height="13"
                          Foreground="{DynamicResource DangerBrush}"
                          IsVisible="{Binding !PasswordsMatch, ElementName=Root}"/>
            </Panel>
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource SuccessBrush}"
                       Text="Пароли совпадают"
                       IsVisible="{Binding PasswordsMatch, ElementName=Root}"/>
            <TextBlock FontSize="12"
                       Foreground="{DynamicResource DangerBrush}"
                       Text="Пароли не совпадают"
                       IsVisible="{Binding !PasswordsMatch, ElementName=Root}"/>
        </StackPanel>

    </StackPanel>
</UserControl>