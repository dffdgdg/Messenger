<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Core.ViewModels.Chat"
             xmlns:controls="using:Desktop.Views.Controls"
             xmlns:conv="using:Core.Converters"
             xmlns:polls="using:Core.ViewModels.Chat.Polls"
             x:Class="Desktop.Views.Dialog.PollResultsDialog"
             x:DataType="vm:PollResultsDialogViewModel"
             Width="400">

    <Border Background="{DynamicResource SecondaryBG}"
            CornerRadius="16"
            Padding="24">
        <StackPanel Spacing="16">

            <!-- Заголовок -->
            <TextBlock Text="Результаты опроса"
                       FontSize="18" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimary}"/>

            <TextBlock Text="{Binding TotalVotes, StringFormat='Всего голосов: {0}'}"
                       FontSize="13"
                       Foreground="{DynamicResource TextSecondary}"/>

            <!-- Список опций -->
            <ScrollViewer MaxHeight="480"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Options}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PollResultOptionViewModel">
                            <Border Margin="0,0,0,12">
                                <StackPanel Spacing="6">

                                    <!-- Заголовок опции -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding OptionText}"
                                                   FontSize="14" FontWeight="Medium"
                                                   Foreground="{DynamicResource TextPrimary}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding VotesPercentage, StringFormat={}{0:0}%}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Accent}"
                                                   Margin="8,0,0,0"
                                                   VerticalAlignment="Center"/>
                                    </Grid>

                                    <!-- Прогресс-бар -->
                                    <Border Height="6" CornerRadius="3"
                                            Background="{DynamicResource BorderDefault}"
                                            ClipToBounds="True">
                                        <Border CornerRadius="3"
                                                Background="{DynamicResource Accent}"
                                                HorizontalAlignment="Left">
                                            <Border.Width>
                                                <MultiBinding Converter="{conv:MultiConverter Name=PercentToWidth}">
                                                    <Binding Path="VotesPercentage"/>
                                                    <Binding Path="$parent[Border].Bounds.Width"/>
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Border>

                                    <!-- Счётчик голосов -->
                                    <TextBlock FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="{}{0} {1}">
                                                <Binding Path="VotesCount"/>
                                                <Binding Path="VotesCount"
                                                         Converter="{conv:Converter Name=Pluralize}"
                                                         ConverterParameter="голос|голоса|голосов"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>

                                    <!-- Список проголосовавших (только не анонимный) -->
                                    <ItemsControl ItemsSource="{Binding Voters}"
                                                  IsVisible="{Binding !IsAnonymous}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="polls:PollVoterViewModel">
                                                <Border Padding="0,4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <controls:AvatarControl
                                                            Source="{Binding Avatar}"
                                                            DisplayName="{Binding DisplayName}"
                                                            Size="28"
                                                            ShowOnlineIndicator="False"/>
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontSize="13"
                                                                   Foreground="{DynamicResource TextPrimary}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Лоадер пока резолвим имена -->
                                    <TextBlock Text="Загрузка..."
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               IsVisible="{Binding IsLoadingVoters}"
                                               Margin="0,2,0,0"/>

                                    <!-- Анонимный -->
                                    <TextBlock Text="Анонимный опрос"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextMuted}"
                                               IsVisible="{Binding IsAnonymous}"
                                               Margin="0,2,0,0"/>

                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Закрыть -->
            <Button Classes="Secondary"
                    Content="Закрыть"
                    HorizontalAlignment="Right"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>
    </Border>
</UserControl>