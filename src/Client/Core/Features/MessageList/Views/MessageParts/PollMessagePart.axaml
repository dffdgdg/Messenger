<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:Core.Shared.Converters"
             xmlns:polls="using:Core.Features.Chat.ViewModels.Polls"
             xmlns:vm="using:Core.Features.Chat.ViewModels.Messages"
             xmlns:shared="using:Core.Features.Chat.Views.MessageParts.Shared"
             x:Class="Core.Features.Chat.Views.MessageParts.PollMessagePart"
             x:DataType="vm:MessageViewModel">

    <StackPanel>

        <StackPanel IsVisible="{Binding IsDeleted}">
            <TextBlock Text="{Binding DisplayContent}"
                       FontStyle="Italic"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       FontSize="15"
                       LineHeight="22"/>
            <shared:MessageMetaBlock HorizontalAlignment="Right" Margin="0,-2,0,0" Opacity="0.7"/>
        </StackPanel>

       <Border Classes="PollBubble"
                Classes.Own="{Binding IsOwn}"
                IsVisible="{Binding !IsDeleted}">
            <StackPanel Spacing="6">

                <TextBlock Text="{Binding Content}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           LineHeight="20"
                           Margin="0,2,0,4"/>

                <StackPanel Spacing="4"
                            MinWidth="250"
                            DataContext="{Binding Poll}">

                    <StackPanel Spacing="2" Margin="2,0,0,4">
                        <TextBlock Text="{Binding IsAnonymous,
                                           Converter={conv:Converter Name=BoolToString},
                                           ConverterParameter='Анонимный опрос|Опрос'}"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="13" FontWeight="SemiBold"/>
                        <TextBlock Text="Можно выбрать несколько"
                                   Foreground="{DynamicResource TextSecondary}"
                                   FontSize="12"
                                   IsVisible="{Binding AllowsMultipleAnswers}"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Options}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="polls:PollOptionViewModel">
                                <Panel Margin="0,3">

                                    <Button Classes="PollOptionButton"
                                            Command="{Binding ToggleSelectionCommand}"
                                            IsVisible="{Binding CanVote}">
                                        <Border Classes="PollOptionBorder"
                                                Classes.Selected="{Binding IsSelected}">
                                            <Grid ColumnDefinitions="Auto,*">
                                                <Panel Grid.Column="0" Width="20" Height="20"
                                                       Margin="0,0,10,0" VerticalAlignment="Center">
                                                    <Border Classes="PollRadioOuter"
                                                            Classes.Selected="{Binding IsSelected}"
                                                            IsVisible="{Binding !AllowsMultipleAnswers}">
                                                        <Border Classes="PollRadioInner"
                                                                IsVisible="{Binding IsSelected}"/>
                                                    </Border>
                                                    <Border Classes="PollCheckboxOuter"
                                                            Classes.Selected="{Binding IsSelected}"
                                                            IsVisible="{Binding AllowsMultipleAnswers}">
                                                        <Path Classes="PollCheckboxTick"
                                                              IsVisible="{Binding IsSelected}"/>
                                                    </Border>
                                                </Panel>
                                                <TextBlock Grid.Column="1"
                                                           Classes="PollOptionText"
                                                           Text="{Binding OptionText}"
                                                           TextWrapping="Wrap"/>
                                            </Grid>
                                        </Border>
                                    </Button>

                                    <Border Classes="PollResultContainer"
                                            IsVisible="{Binding !CanVote}">
                                        <Grid>
                                            <Border Classes="PollProgressBarBackground"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="{Binding VotesFraction,
                                                        Converter={conv:Converter Name=FractionToGridLength}}"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Classes="PollProgressBar"
                                                        Classes.Selected="{Binding IsSelected}"/>
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  Margin="10,8" VerticalAlignment="Center">
                                                <Path Grid.Column="0" Classes="PollResultCheck"
                                                      IsVisible="{Binding IsSelected}"
                                                      Margin="0,0,8,0"/>
                                                <TextBlock Grid.Column="1" Classes="PollResultText"
                                                           Text="{Binding OptionText}"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Classes="PollPercentage"
                                                           Classes.Selected="{Binding IsSelected}"
                                                           Text="{Binding VotesPercentage, StringFormat={}{0:0}%}"
                                                           FontWeight="SemiBold"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid ColumnDefinitions="*,Auto" Height="36" Margin="2,4,2,0">
                        <StackPanel Grid.Column="0" Orientation="Horizontal"
                                    Spacing="6" VerticalAlignment="Center">
                            <TextBlock Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12"
                                       Text="{Binding TotalVotesFormatted}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12" Text="·"
                                       IsVisible="{Binding IsClosed}"
                                       Opacity="0.5"/>
                            <TextBlock Foreground="{DynamicResource TextSecondary}"
                                       FontSize="12" Text="Завершён"
                                       IsVisible="{Binding IsClosed}"/>
                        </StackPanel>

                        <Button Grid.Column="1" Classes="DialogOutline Small"
                                Content="Голосовать"
                                Command="{Binding VoteCommand}"
                                IsEnabled="{Binding HasSelection}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CanVote}"/>

                        <Button Grid.Column="1" Classes="DialogOutline Small"
                                Content="Результаты"
                                Command="{Binding ShowResultsCommand}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding ShowResultsButton}"/>
                    </Grid>

                </StackPanel>

                <shared:MessageMetaBlock HorizontalAlignment="Right" Margin="0,2,0,0" Opacity="0.7"/>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>