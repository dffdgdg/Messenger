<UserControl
    x:Class="Desktop.Views.UserProfileDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Desktop.Views.Controls"
    xmlns:conv="using:Desktop.Converters"
    xmlns:vmDialog="using:Desktop.ViewModels.Dialog"
    x:DataType="vmDialog:UserProfileDialogViewModel">

    <Border Width="400" Classes="DialogContainer">
        <Grid RowDefinitions="Auto,*,Auto">

            <Grid Grid.Row="0" Margin="24,20,24,12">

                <Button
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Classes="IconButton Small"
                    Command="{Binding CloseOnBackgroundClickCommand}"
                    ToolTip.Tip="Закрыть">
                    <PathIcon
                        Width="12"
                        Height="12"
                        Data="{StaticResource CloseIcon}"
                        Foreground="{DynamicResource TextSecondary}" />
                </Button>
            </Grid>

            <ScrollViewer
                Grid.Row="1"
                Classes="ThinScrollbar"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,0,24">

                    <StackPanel
                        Margin="24,12,24,0"
                        HorizontalAlignment="Center"
                        Spacing="16">
                        <controls:AvatarControl
                            HorizontalAlignment="Center"
                            Classes="XLarge"
                            DisplayName="{Binding User.DisplayName}"
                            IsOnline="{Binding User.IsOnline}"
                            Source="{Binding User.Avatar}"
                            StatusType="{Binding User.StatusType}" />

                        <StackPanel Spacing="4">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Text="{Binding User.DisplayName}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />

                            <TextBlock
                                FontSize="13"
                                Foreground="{DynamicResource TextSecondary}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis">
                                <TextBlock.Text>
                                    <MultiBinding Converter="{conv:MultiConverter Name=LastSeen}">
                                        <Binding Path="User.IsOnline" />
                                        <Binding Path="User.LastOnline" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Height="1"
                        Margin="24,24"
                        Background="{DynamicResource BorderDefault}" />

                    <StackPanel Margin="24,0" Spacing="16">
                        <TextBlock Classes="SectionHeader" Text="ИНФОРМАЦИЯ" />

                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="Имя пользователя" />
                            <TextBlock
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{DynamicResource Accent}"
                                Text="{Binding User.Username, StringFormat='@{0}'}" />
                        </Grid>

                        <Grid ColumnDefinitions="*, Auto" IsVisible="{Binding Department, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="Отдел" />
                            <TextBlock
                                Grid.Column="1"
                                MaxWidth="200"
                                HorizontalAlignment="Right"
                                FontSize="14"
                                FontWeight="Medium"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{Binding Department}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </StackPanel>

                </StackPanel>
            </ScrollViewer>

            <Border
                Grid.Row="2"
                Padding="24,16,24,24"
                Background="{DynamicResource SecondaryBG}"
                CornerRadius="0,0,16,16">
                <Button
                    Height="44"
                    Classes="Primary FullWidth"
                    Command="{Binding SendMessageCommand}"
                    IsVisible="{Binding CanSendMessage}">
                    <TextBlock
                        FontSize="15"
                        FontWeight="Medium"
                        Foreground="{DynamicResource TextOnAccent}"
                        Text="Отправить сообщение" />
                </Button>
            </Border>

        </Grid>
    </Border>
</UserControl>