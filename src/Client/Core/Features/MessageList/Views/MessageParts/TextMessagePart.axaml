<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Core.Shared.Controls"
             xmlns:local="using:Core.Features.Chat.Views.MessageParts"
             xmlns:messages="using:Core.Features.Chat.ViewModels.Messages"
             xmlns:shared="using:Core.Features.Chat.Views.MessageParts.Shared"
             x:Class="Core.Features.Chat.Views.MessageParts.TextMessagePart"
             x:DataType="messages:MessageViewModel"
             x:Name="TextPartRoot">

    <StackPanel>
        <StackPanel IsVisible="{Binding IsDeleted}">
            <TextBlock Text="{Binding DisplayContent}"
                       FontStyle="Italic"
                       Foreground="{DynamicResource TextSecondary}"
                       TextWrapping="Wrap"
                       FontSize="15"
                       LineHeight="22"/>
            <shared:MessageMetaBlock
                HorizontalAlignment="Right"
                Margin="0,-2,0,0"
                Opacity="0.7"/>
        </StackPanel>

        <StackPanel IsVisible="{Binding !IsDeleted}">
            <StackPanel IsVisible="{Binding HasTextContent}">
                <controls:RichMessageTextBlock
                    FontSize="15"
                    LineHeight="22"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top"
                    RawText="{Binding DisplayContent}"
                    MentionClickCommand="{Binding MentionClickCommand}"/>
                <shared:MessageMetaBlock
                    HorizontalAlignment="Right"
                    Margin="0,-2,0,0"
                    Opacity="0.7"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding FileViewModels}"
                          IsVisible="{Binding ShowNonVoiceFiles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="6"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="messages:MessageFileViewModel">
                        <local:FileAttachmentControl/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <shared:MessageMetaBlock HorizontalAlignment="Right"
                                    Margin="0,4,0,0" Opacity="0.7"
                                    IsVisible="{Binding ShowFilesOnlyMeta}"/>
        </StackPanel>
    </StackPanel>
</UserControl>